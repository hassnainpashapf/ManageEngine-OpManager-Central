HH3C-SERVER-AGENT-MIB	DEFINITIONS ::= BEGIN
	IMPORTS
		MacAddress, DisplayString, RowStatus
			FROM SNMPv2-TC
		DisplayString
			FROM RFC1213-MIB
		hh3c
			FROM HH3C-OID-MIB
		OBJECT-TYPE, MODULE-IDENTITY, Integer32, IpAddress, enterprises
			FROM SNMPv2-SMI;

	hh3c2014	MODULE-IDENTITY
		LAST-UPDATED	"202008270949Z"
		ORGANIZATION	"New H3C Technologies Co., Ltd."
		CONTACT-INFO	"Platform Team New H3C Technologies Co., Ltd.
		Hai-Dian District Beijing P.R. China
		http://www.h3c.com
		Zip: 100085"
		DESCRIPTION		"This MIB is applicable to server products.

        Some objects in this may be used only for some specific products,
        so users should refer to the related documents to acquire more
        detail information.
        "
		REVISION		"201612011030Z"
		DESCRIPTION		"The initial revision of this MIB module."
		::=  {  hh3c  13  }

