		DESCRIPTION		"GPU power capping."
		::=  {  hh3cGPUPowerManagement  51  }
		
	hh3cSrvGPUPowerCappingValue	OBJECT-TYPE
		SYNTAX			Integer32 { notsupport ( 65535 ) }
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION		"GPU power capping value, in W."
		::=  {  hh3cGPUPowerManagement  52  }
		
	hh3cSrvGPUPowerCappingFailure	OBJECT-TYPE
		SYNTAX			Integer32  { Yes ( 1 ) , No ( 0 ) , notsupport ( 255 ) }
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION		"Server shutdown on GPU power capping failure."
		::=  {  hh3cGPUPowerManagement  53  }
		
		
	hh3cTrapInfoDescriptionTable	OBJECT-TYPE
		SYNTAX		SEQUENCE  OF  Hh3cTrapInfoDescriptionEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION	"A table containing the list of trap description."
		::=  { hh3ctrap  11 }

	hh3cTrapInfoDescriptionEntry	OBJECT-TYPE
		SYNTAX		Hh3cTrapInfoDescriptionEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION	"Row Description"
		INDEX		{  hh3cTrapReceiverIndex  }
		::=  { hh3cTrapInfoDescriptionTable 1 }

	Hh3cTrapInfoDescriptionEntry  ::=  SEQUENCE {
		hh3cTrapReceiverIndex  Integer32,
		hh3cTrapReceiverEnable  Integer32,
		hh3cTrapReceiverPort  Integer32,
		hh3cTrapReceiverAddr  DisplayString
		}


	hh3cTrapReceiverIndex	OBJECT-TYPE
		SYNTAX			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"Index of a trap receiver."
		::=  {  hh3cTrapInfoDescriptionEntry  1  }


	hh3cTrapReceiverEnable	OBJECT-TYPE
		SYNTAX			Integer32  { enable ( 1 ) , disable ( 0 ) }
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION		"Status of the trap receiver."
		::=  {  hh3cTrapInfoDescriptionEntry  2  }


	hh3cTrapReceiverPort	OBJECT-TYPE
		SYNTAX			Integer32
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION		"Port number for sending SNMP traps. Value range: 1 to 65535. Default: 162."
		::=  {  hh3cTrapInfoDescriptionEntry  3  }


	hh3cTrapReceiverAddr	OBJECT-TYPE
		SYNTAX			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION		"Address of the trap receiver. Domain address, IPv4 address, and IPv6 address are supported. Default: No address is set for a trap receiver."
		::=  {  hh3cTrapInfoDescriptionEntry  4  }

	hh3cSrvLinkInfoTable	OBJECT-TYPE
		SYNTAX		SEQUENCE  OF  Hh3cSrvLinkInfoEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION	"The network link information table"
		::=  { hh3cNetwork  4 }

	hh3cSrvLinkInfoEntry	OBJECT-TYPE
		SYNTAX		Hh3cSrvLinkInfoEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION	"The network link information entry"
		INDEX		{  h3cSrvLinkTableIndex  }
		::=  { hh3cSrvLinkInfoTable 1 }

	Hh3cSrvLinkInfoEntry  ::=  SEQUENCE {
		h3cSrvLinkTableIndex  Integer32,
		h3cSrvLinkIfName  DisplayString,
		h3cSrvLinkPortNum  Integer32,
		h3cSrvLinkPortStatus  DisplayString
		}


	h3cSrvLinkTableIndex	OBJECT-TYPE
		SYNTAX			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"Index of a network port."
		::=  {  hh3cSrvLinkInfoEntry  1  }


	h3cSrvLinkIfName	OBJECT-TYPE
		SYNTAX			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"Name of the network port."
		::=  {  hh3cSrvLinkInfoEntry  2  }


	h3cSrvLinkPortNum	OBJECT-TYPE
		SYNTAX			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"Number of the network port."
		::=  {  hh3cSrvLinkInfoEntry  3  }


	h3cSrvLinkPortStatus	OBJECT-TYPE
		SYNTAX			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"Link status of the network port."
		::=  {  hh3cSrvLinkInfoEntry  4  }




	hh3cFCHBAInfo	OBJECT IDENTIFIER
	::=  {  hh3cSrvDeviceInfo  14  }

	hh3cSrvFCHBAInfoTable	OBJECT-TYPE
		SYNTAX		SEQUENCE  OF  Hh3cSrvFCHBAInfoEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION	"The FCHBA information table."
		::=  { hh3cFCHBAInfo  1 }

	hh3cSrvFCHBAInfoEntry	OBJECT-TYPE
		SYNTAX		Hh3cSrvFCHBAInfoEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION	"Row Description"
		INDEX		{  hh3cSrvFCHBACardIndex  }
		::=  { hh3cSrvFCHBAInfoTable 1 }

	Hh3cSrvFCHBAInfoEntry  ::=  SEQUENCE {
		hh3cSrvFCHBACardIndex  Integer32,
		hh3cSrvFCHBACardName   DisplayString,
		hh3cSrvFCHBACardType   DisplayString,
		hh3cSrvFCHBACardFWver  DisplayString,
		hh3cSrvFCHBACardLocation  DisplayString,
		hh3cSrvFCHBACardPort  Integer32,
		hh3cSrvFCHBACardWwpn  DisplayString,
		hh3cSrvFCHBACardWwnn  DisplayString,
		hh3cSrvFCHBACardLinkSpeed  DisplayString,
		hh3cSrvFCHBACardLinkStatus  Integer32
		}


	hh3cSrvFCHBACardIndex	OBJECT-TYPE
		SYNTAX			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"Index of an FC HBA module."
		::=  {  hh3cSrvFCHBAInfoEntry  1  }


	hh3cSrvFCHBACardName	OBJECT-TYPE
		SYNTAX			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"Name of the FC HBA module."
		::=  {  hh3cSrvFCHBAInfoEntry  2  }


	hh3cSrvFCHBACardType	OBJECT-TYPE
		SYNTAX			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"type of the FC HBA module."
		::=  {  hh3cSrvFCHBAInfoEntry  3  }


	hh3cSrvFCHBACardFWver	OBJECT-TYPE
		SYNTAX			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"Firmware version of the FC HBA module."
		::=  {  hh3cSrvFCHBAInfoEntry  4  }


	hh3cSrvFCHBACardLocation	OBJECT-TYPE
		SYNTAX			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"Location of the FC HBA module."
		::=  {  hh3cSrvFCHBAInfoEntry  5  }


	hh3cSrvFCHBACardPort	OBJECT-TYPE
		SYNTAX			Integer32  { NA ( 255 ) }
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"Port of the FC HBA module."
		::=  {  hh3cSrvFCHBAInfoEntry  6  }


	hh3cSrvFCHBACardWwpn	OBJECT-TYPE
		SYNTAX			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"WWPN of the port."
		::=  {  hh3cSrvFCHBAInfoEntry  7  }


	hh3cSrvFCHBACardWwnn	OBJECT-TYPE
		SYNTAX			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"WWNN of the port."
		::=  {  hh3cSrvFCHBAInfoEntry  8  }


	hh3cSrvFCHBACardLinkSpeed	OBJECT-TYPE
		SYNTAX			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"Link speed of the port, in Gb/s."
		::=  {  hh3cSrvFCHBAInfoEntry  9  }


	hh3cSrvFCHBACardLinkStatus	OBJECT-TYPE
		SYNTAX			Integer32 { connect ( 1 ) , disconnect ( 2 ) , NA ( 255 ) }
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION		"Status of the port."
		::=  {  hh3cSrvFCHBAInfoEntry  10  }


END
