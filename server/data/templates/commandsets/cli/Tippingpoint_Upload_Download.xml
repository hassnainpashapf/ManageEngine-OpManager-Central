<CLICommandList>

<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="tippingpoint_ips_cli_ispec"/>
</CLIInteractionSpec>

<!-- show config -->

<CLICommand command="session no more">
   <CLIInputRecord messagesuffix="&#13;&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="tippingpoint_ips_cli_no_paging_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="conf t">
   <CLIInputRecord messagesuffix="&#13;&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="tippingpoint_ips_cli_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="exit">
   <CLIInputRecord messagesuffix="&#13;&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="tippingpoint_ips_cli_exit_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="show configuration">
   <CLIInputRecord messagesuffix="&#13;&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="tippingpoint_ips_cli_show_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<!-- Hardware Properties -->
<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="tippingpoint_ips_hardware_prop_parser" promptactionid="yesActionId">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="tippingpoint_ips_cli_hardware_ispec"/>
</CLIInteractionSpec>

<CLICommand command="show version">
	<CLIInputRecord parsercommandname="hardware_prop_tippingpoint_ips" messagesuffix="&#13;&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="tippingpoint_ips_cli_hardware_version_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

</CLICommandList>

