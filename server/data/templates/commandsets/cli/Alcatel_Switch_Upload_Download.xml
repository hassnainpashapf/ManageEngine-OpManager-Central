<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<CLICommandList>
<!-- for ALCATEL SWITCH  -->

<CLIInteractionSpec interactionverb="1" requesttimeout="60000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true">
<InteractionSpec timeout="60000" protocol="CLI" interactionid="alcatel_switch_cli_ispec"/>
</CLIInteractionSpec>
   
<!--show config-->
    <CLICommand command="show configuration snapshot">
	    <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
            <Record type="CLI" recordid="alcatel_switch_cli_fetch_running_rec" protocol="CLI"/>
	    </CLIInputRecord>
    </CLICommand>

    <!-- 6200 omnistack tftp running config backup -->

    <CLICommand command="copy startup-config tftp://${UserInput:tftp_server_address}/${UserInput:file_name}">
	    <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		    <Record type="CLI" recordid="alcatel_6200_cli_backup_startup_rec" protocol="CLI"/>
	    </CLIInputRecord>
    </CLICommand>

    <CLICommand command="copy running-config tftp://${UserInput:tftp_server_address}/${UserInput:file_name}">
	    <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		    <Record type="CLI" recordid="alcatel_6200_cli_backup_running_rec" protocol="CLI"/>
	    </CLIInputRecord>
    </CLICommand>

<!-- show config -->

<CLICommand command="terminal datadump">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="alcatel_6200_cli_backup_disable_paging" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="show startup-config">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="alcatel_6200_cli_backup_show_startup" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="show running-config">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="alcatel_6200_cli_backup_show_running" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>


<!--Show hardware info-->
<CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="alcatel_switch_hardware_prop_parser">
<InteractionSpec timeout="20000" protocol="CLI" interactionid="alcatel_switch_show_hardware_prop"/>
</CLIInteractionSpec>

    <CLICommand command="show hardware info">
	    <CLIInputRecord parsercommandname="hardware_prop_alcatel_switch" messagesuffix="&#10;" inputsourcetype="1">
	    <Record type="CLI" recordid="alcatel_switch_cli_hardware_rec" protocol="CLI"/>
	    </CLIInputRecord>
    </CLICommand>

    <!--Show system-->
    <CLICommand command="show system">
	     <CLIInputRecord parsercommandname="hardware_prop_alcatel_switch" messagesuffix="&#10;" inputsourcetype="1">
             <Record type="CLI" recordid="alcatel_switch_cli_system_rec" protocol="CLI"/>
             </CLIInputRecord>
   </CLICommand>

    



</CLICommandList>

