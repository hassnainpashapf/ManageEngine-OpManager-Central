<CLICommandList>

<CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="garderos_hardware_prop_parser" promptactionid="yesActionId">
 <InteractionSpec timeout="20000" protocol="CLI" interactionid="garderos_show_version_hardware_prop"/>
</CLIInteractionSpec>

<CLICommand command="show hardware all">
<CLIInputRecord parsercommandname="hardware_prop_garderos_grs_router" messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="garderos_grs_router_hardware_prop" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>


<CLICommand command="show system version details">
 <CLIInputRecord parsercommandname="hardware_prop_garderos_grs_router" messagesuffix="&#10;" inputsourcetype="1">
   <Record type="CLI" recordid="garderos_grs_router_system_version_details" protocol="CLI"/>
 </CLIInputRecord>
</CLICommand>

<CLICommand command="show system serial">
 <CLIInputRecord parsercommandname="hardware_prop_garderos_grs_router" messagesuffix="&#10;" inputsourcetype="1">
   <Record type="CLI" recordid="garderos_grs_router_system_serial" protocol="CLI"/>
 </CLIInputRecord>
</CLICommand>




<!--Show Running Config -->
 
<CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
  <InteractionSpec timeout="20000" protocol="CLI" interactionid="garderos_cli_show_running_config_irec" />
</CLIInteractionSpec>



<CLICommand command="show configuration running">
 <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
   <Record type="CLI" recordid="garderos_grs_router_cli_fetch_running_rec" protocol="CLI"/>
 </CLIInputRecord>
</CLICommand>



<!--Show Startup Config -->
<CLICommand command="show configuration startup">
 <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
   <Record type="CLI" recordid="garderos_grs_router_cli_fetch_startup_rec" protocol="CLI"/>
 </CLIInputRecord>
</CLICommand>


<!--Show Sync Config -->
<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
	<InteractionSpec timeout="30000" protocol="CLI" interactionid="garderos_sync_config_ipsec" />
</CLIInteractionSpec>

<CLICommand command="copy running-configuration startup-configuration">
	<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="garderos_sync_config_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>


</CLICommandList>

