<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<CLICommandList>

<CLIInteractionSpec interactionverb="1" requesttimeout="60000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true">
   <InteractionSpec timeout="60000" protocol="CLI" interactionid="cisco_asr_router_cli_ispec"/>
</CLIInteractionSpec>

<!-- show config -->

<CLICommand command="show running-config">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="show_cisco_asr_router_startup" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="show running-config">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="show_cisco_asr_router_running" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="admin">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="show_cisco_asr_router_admin_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="terminal length 0">
 <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="show_cisco_asr_cli_terminal_length_0_rec" protocol="CLI"/>
 </CLIInputRecord>
</CLICommand>

<CLICommand command="exit">
 <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="show_cisco_asr_cli_terminal_exit_rec" protocol="CLI"/>
 </CLIInputRecord>
</CLICommand>

<!-- Hardware Properties -->
<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="show_cisco_asr_hardware_prop_parser">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="show_cisco_asr_cli_hardware_ispec"/>
</CLIInteractionSpec>

<CLICommand command="show version">
	<CLIInputRecord parsercommandname="hardware_prop_cisco_asr_router" messagesuffix="&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="cisco_asr_cli_hardware_version_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

<!-- Cisco ASR 5000 series -->


<CLIInteractionSpec interactionverb="1" requesttimeout="60000" prompt="${UserInput:Prompt}" commandecho="false" promptecho="true">
   <InteractionSpec timeout="60000" protocol="CLI" interactionid="cisco_asr_5000_cli_ispec"/>
</CLIInteractionSpec>

<!-- show config -->

<CLICommand command="terminal length 0">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="cisco_asr_5000_paging_disable_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="show configuration">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="cisco_asr_5000_running_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<!-- Hardware Properties -->
<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:Prompt}" commandecho="false" promptecho="true" responseparserid="cisco_asr_5000_hardware_prop_parser">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="cisco_asr_5000_cli_hardware_ispec"/>
</CLIInteractionSpec>

<CLICommand command="show licence">
	<CLIInputRecord parsercommandname="hardware_prop_cisco_asr_5000" messagesuffix="&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="cisco_asr_5000_cli_hardware_version_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

</CLICommandList>

