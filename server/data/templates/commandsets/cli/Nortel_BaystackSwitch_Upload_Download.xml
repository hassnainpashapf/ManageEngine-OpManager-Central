</CLIInteractionSpec>

<CLICommand command="exit">
    <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
        <Record type="CLI" recordid="nortel_baystackswitch_cli_exit_rec" protocol="CLI"/>
    </CLIInputRecord>
