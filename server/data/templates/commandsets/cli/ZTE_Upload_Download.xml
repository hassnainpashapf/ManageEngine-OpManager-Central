<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<CLICommandList>

<CLIInteractionSpec interactionverb="1" requesttimeout="60000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
  <InteractionSpec timeout="60000" protocol="CLI" interactionid="zxr_router_cli_ispec"/>
</CLIInteractionSpec>

<!-- ################################# Commands for FSM7328PS ################################-->
<!-- Backup Running -->


<CLICommand command="conf tffs">
	<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="zxr_router_cli_config_mode" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

<CLICommand command="tftp ${UserInput:tftp_server_address} upload startcfg.txt">
	<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="zxr_router_cli_startup_backup_command" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

<CLICommand command="exit">
	<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="zxr_router_cli_exit_mode" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

<CLICommand command="sh running-config toFile">
	<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="zxr_router_cli_save_running_config_file" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

<CLICommand command="tftp ${UserInput:tftp_server_address} upload config.txt">
	<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="zxr_router_cli_running_backup_command" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

<!-- hardware commands -->

<CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="zxr_router_hardware_prop_parser" promptactionid="yesActionId">
	<InteractionSpec timeout="20000" protocol="CLI" interactionid="zxr_router_hardware_prop_ispec"/>
</CLIInteractionSpec>

<CLICommand command="show version">
	<CLIInputRecord parsercommandname="hardware_prop_zxr_router" messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="zxr_router_hardware_prop_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>


<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="TransPortWirelessRouterId">
   <InteractionSpec timeout="50000" protocol="CLI" interactionid="zxr_router_zsr_cli_ispec"/>
</CLIInteractionSpec>

<!-- show config -->

<CLICommand command="terminal length 0">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="zxr_router_zsr_cli_paging_disable_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="show start running-config">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="zxr_router_zsr_cli_show_startup_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>


<CLICommand command="show running-config">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="zxr_router_zsr_cli_show_running_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="write">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="zxr_router_zsr_cli_sync_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>


<!-- Hardware Properties -->
<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="zxr_router_zsr_hardware_prop_parser" promptactionid="TransPortWirelessRouterId">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="zxr_router_zsr_cli_hardware_ispec"/>
</CLIInteractionSpec>

<CLICommand command="show version">
	<CLIInputRecord parsercommandname="hardware_prop_zxr_router_zsr" messagesuffix="&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="zxr_router_zsr_cli_show_version_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

</CLICommandList>
