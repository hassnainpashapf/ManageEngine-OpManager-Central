<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<CLICommandList>

<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:Prompt}" commandecho="false" promptecho="true" >
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="mikrotik_router_cli_ispec"/>
</CLIInteractionSpec>

<!-- show config -->

<CLICommand command="/export compact">
   <CLIInputRecord messagesuffix="&#13;&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="mikrotik_router_cli_fetch_running_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>


<!-- Hardware Properties -->
<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:Prompt}" commandecho="false" promptecho="true" responseparserid="mikrotik_router_hardware_prop_parser">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="mikrotik_router_cli_hardware_ispec"/>
</CLIInteractionSpec>

<CLICommand command="/system resource print">
	<CLIInputRecord parsercommandname="mikrotik_router_hardware_prop" messagesuffix="&#13;&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="mikrotik_router_cli_hardware1_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

<CLICommand command="/system routerboard print">
	<CLIInputRecord parsercommandname="mikrotik_router_hardware_prop" messagesuffix="&#13;&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="mikrotik_router_cli_hardware2_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

</CLICommandList>

