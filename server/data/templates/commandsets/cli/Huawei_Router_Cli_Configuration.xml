<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<CLICommandList>

<!-- execute copy running config tftp command mode -->

   <CLIInteractionSpec  interactionverb="1" requesttimeout="20000" prompt="${UserInput:Prompt}" commandecho="false" promptecho="true">
         <InteractionSpec timeout="20000" protocol="CLI" interactionid="huawei_arrouter_cli_fetch_config_ispec"/>
                </CLIInteractionSpec>


                <CLICommand command="copy ${UserInput:tftp_server_address} ${UserInput:file_name} config">
                <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
                <Record type="CLI" recordid="huawei_arrouter_cli_fetch_config_rec" protocol="CLI"/>
                </CLIInputRecord>
                </CLICommand>


<!-- for AR 1831 -->

<CLICommand command="tftp ${UserInput:tftp_server_address} put config.cfg ${UserInput:file_name}">
	<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="huawei_ar1831_cli_upload_config_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

<!-- for Huawei NE40E-X3 Router -->

<CLIInteractionSpec interactionverb="1" requesttimeout="130000" prompt="${UserInput:Prompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
   <InteractionSpec timeout="130000" protocol="CLI" interactionid="huawei_ne_router_cli_ispec"/>
</CLIInteractionSpec>

<!-- show config -->

<CLICommand command="screen-length 0 temporary">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="huawei_ne_router_cli_paging_disable_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="display saved-configuration">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="huawei_ne_router_cli_show_startup_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>


<CLICommand command="display current-configuration">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="huawei_ne_router_cli_show_running_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<!-- Hardware Properties -->
<CLIInteractionSpec interactionverb="1" requesttimeout="130000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="huawei_ne_router_hardware_prop_parser" promptactionid="yesActionId">
   <InteractionSpec timeout="130000" protocol="CLI" interactionid="huawei_ne_router_cli_hardware_ispec"/>
</CLIInteractionSpec>

<CLICommand command="display version">
	<CLIInputRecord parsercommandname="hardware_prop_huawei_ne_router" messagesuffix="&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="huawei_ne_router_cli_show_version_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>


<!-- Hardware Properties for Huawei S 5300 Switch -->
<CLIInteractionSpec interactionverb="1" requesttimeout="130000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="huawei_s_5300_switch_hardware_prop_parser" promptactionid="yesActionId">
   <InteractionSpec timeout="130000" protocol="CLI" interactionid="huawei_s_5300_switch_cli_hardware_ispec"/>
</CLIInteractionSpec>

<CLICommand command="display version">
	<CLIInputRecord parsercommandname="hardware_prop_huawei_s_5300_switch" messagesuffix="&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="huawei_s_5300_switch_cli_show_version_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>




<CLIInteractionSpec interactionverb="1" requesttimeout="130000" prompt="${UserInput:Prompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
   <InteractionSpec timeout="130000" protocol="CLI" interactionid="huawei_s_5300_switch_cli_ispec"/>
</CLIInteractionSpec>

<CLICommand command="screen-length 0 temporary">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="huawei_s_5300_switch_cli_paging_disable_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>


<CLICommand command="display saved-configuration">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="huawei_s_5300_switch_cli_show_startup_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="display current-configuration">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="huawei_s_5300_switch_cli_show_running_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

</CLICommandList>
