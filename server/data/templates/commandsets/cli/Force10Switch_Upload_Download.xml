<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<CLICommandList>

<CLIInteractionSpec interactionverb="1" requesttimeout="120000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
  <InteractionSpec timeout="120000" protocol="CLI" interactionid="force10_switch_cli_ispec"/>
</CLIInteractionSpec>

<!-- ################################# Commands for E-Series ################################-->
<!-- Backup Startup -->
<CLICommand command="copy startup-config tftp://${UserInput:tftp_server_address}/${UserInput:file_name}">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10_e_switch_cli_backup_startup_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<!-- Backup Running -->
<CLICommand command="copy running-config tftp://${UserInput:tftp_server_address}/${UserInput:file_name}">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10_e_switch_cli_backup_running_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<!-- Push Startup -->
<CLICommand command="copy tftp://${UserInput:tftp_server_address}/${UserInput:file_name} startup-config">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10_e_switch_cli_push_startup_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<!-- Push Running -->
<CLICommand command="copy tftp://${UserInput:tftp_server_address}/${UserInput:file_name} running-config">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10_e_switch_cli_push_running_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<!-- Config Sync Operation -->
<CLICommand command="copy running-config startup-config">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10_e_switch_sync_config_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<CLICommand command="terminal length 0">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10switch_e_cli_paging_disable_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<CLICommand command="show startup-config">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10switch_e_cli_show_startup_config_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<CLICommand command="show running-config">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10switch_e_show_running_config_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<!-- ############################### Commands for E-Series - Ends #############################-->


<!-- ############################### Commands for S-Series - Starts ###########################-->
<!-- Backup Startup -->
<CLICommand command="copy nvram:startup-config tftp://${UserInput:tftp_server_address}/${UserInput:file_name}">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10_s_switch_cli_backup_startup_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<!-- Backup Running -->
<CLICommand command="show running-config runningconfig.scr">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10_s_switch_cli_backup_running_rec_1" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<CLICommand command="copy nvram:script runningconfig.scr tftp://${UserInput:tftp_server_address}/${UserInput:file_name}">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10_s_switch_cli_backup_running_rec_2" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<!-- Push Startup -->
<CLICommand command="copy tftp://${UserInput:tftp_server_address}/${UserInput:file_name} nvram:startup-config">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10_s_switch_cli_push_startup_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<!-- Push Running -->
<CLICommand command="copy tftp://${UserInput:tftp_server_address}/${UserInput:file_name} nvram:script pushconfig.scr">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10_s_switch_cli_push_running_rec_1" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<CLICommand command="script apply pushconfig.scr">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10_s_switch_cli_push_running_rec_2" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<!-- Config Sync Operation -->
<CLICommand command="copy system:running-config  nvram:startup-config">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="force10_s_switch_sync_config_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<!-- ############################### Commands for S-Series - Ends #############################-->

</CLICommandList>
