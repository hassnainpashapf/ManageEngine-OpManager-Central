<CLICommandList>

<CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="ubiquiti_hardware_prop_parser" promptactionid="yesActionId">
 <InteractionSpec timeout="20000" protocol="CLI" interactionid="ubiquiti_show_version_hardware_prop"/>
</CLIInteractionSpec>

<CLICommand command="cat /etc/version">
<CLIInputRecord parsercommandname="hardware_prop_ubiquiti_air_os" messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="ubiquiti_air_os_hardware_prop" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>



<!--Show Running Config -->
 
<CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
  <InteractionSpec timeout="20000" protocol="CLI" interactionid="ubiquiti_cli_show_running_config_irec" />
</CLIInteractionSpec>


<CLICommand command="cat /tmp/system.cfg">
 <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
   <Record type="CLI" recordid="ubiquiti_air_os_cli_fetch_running_rec" protocol="CLI"/>
 </CLIInputRecord>
</CLICommand>

</CLICommandList>

