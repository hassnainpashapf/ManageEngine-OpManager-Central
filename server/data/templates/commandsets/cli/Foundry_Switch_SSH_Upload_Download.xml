<CLICommandList>

<!-- execute copy running config tftp command mode -->


    <CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="${UserInput:Prompt}" commandecho="false" promptecho="true" promptactionid="foundryActionId">
	    <InteractionSpec timeout="20000" protocol="CLI" interactionid="foundry_ssh_enableprompt_exit_ispec"/>
    </CLIInteractionSpec>

    <CLICommand command="exit">
	    <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
        	<Record type="CLI" recordid="foundry_ssh_enableprompt_exit_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>
    
    <CLICommand command="configure terminal">
	    <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
        	<Record type="CLI" recordid="foundry_ssh_configure_terminal_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>
    
    <CLICommand command="end">
	    <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
        	<Record type="CLI" recordid="foundry_ssh_configure_terminal_end_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>    

    <CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="foundryActionId">
			<InteractionSpec timeout="20000" protocol="CLI" interactionid="foundry_switch_ssh_fetch_startup_ispec"/>
    </CLIInteractionSpec>

    <CLICommand command="copy startup-config tftp ${UserInput:tftp_server_address} ${UserInput:file_name}">
	    <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
            <Record type="CLI" recordid="foundry_switch_ssh_fetch_startup_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>

    <CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="foundryActionId">
	    <InteractionSpec timeout="20000" protocol="CLI" interactionid="foundry_switch_ssh_fetch_running_ispec"/>
    </CLIInteractionSpec>

    <CLICommand command="copy running-config tftp ${UserInput:tftp_server_address} ${UserInput:file_name}">
	    <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
        	<Record type="CLI" recordid="foundry_switch_ssh_fetch_running_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>

    <CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="foundryActionId">
	    <InteractionSpec timeout="20000" protocol="CLI" interactionid="foundry_switch_ssh_push_startup_ispec"/>
    </CLIInteractionSpec>

    <CLICommand command="copy tftp startup-config ${UserInput:tftp_server_address} ${UserInput:file_name}">
	    <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
        	<Record type="CLI" recordid="foundry_switch_ssh_push_startup_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>

    <CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="foundryActionId">
	    <InteractionSpec timeout="20000" protocol="CLI" interactionid="foundry_switch_ssh_push_running_ispec"/>
    </CLIInteractionSpec>

    <CLICommand command="copy tftp running-config ${UserInput:tftp_server_address} ${UserInput:file_name}">
	    <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="foundry_switch_ssh_push_running_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>

</CLICommandList>
