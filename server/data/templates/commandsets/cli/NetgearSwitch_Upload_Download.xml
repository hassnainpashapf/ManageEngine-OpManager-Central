<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<CLICommandList>

<CLIInteractionSpec interactionverb="1" requesttimeout="60000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
  <InteractionSpec timeout="60000" protocol="CLI" interactionid="netgear_switch_cli_ispec"/>
</CLIInteractionSpec>

<!-- ################################# Commands for FSM7328PS ################################-->
<!-- Backup Running -->


<CLICommand command="show running-config current-config.scr">
	<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="netgear_switch_cli_backup_running_rec1" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>


<CLICommand command="copy nvram:script current-config.scr tftp://${UserInput:tftp_server_address}/${UserInput:file_name}">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="netgear_switch_cli_backup_running_rec2" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>


<!-- Backup Startup -->

<CLICommand command="copy nvram:startup-config tftp://${UserInput:tftp_server_address}/${UserInput:file_name}">
	<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="netgear_switch_cli_backup_startup_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>



<!-- Push Running -->
<CLICommand command="copy tftp://${UserInput:tftp_server_address}/${UserInput:file_name} nvram:script current-config.scr">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="netgear_switch_cli_push_running_rec1" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<CLICommand command="script apply current-config.scr">
	<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="netgear_switch_cli_push_running_rec2" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>



<!-- hardware commands -->

<CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="netgear_hardware_prop_parser" promptactionid="yesActionId">
	<InteractionSpec timeout="20000" protocol="CLI" interactionid="netgear_switch_hardware_prop_ispec"/>
</CLIInteractionSpec>

<CLICommand command="show hardware">
	<CLIInputRecord parsercommandname="hardware_prop_netgear_switch" messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="netgear_switch_hardware_prop_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

</CLICommandList>
