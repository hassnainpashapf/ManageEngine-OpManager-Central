<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<cliconfiguration>

<!-- for CISCO PIX Firewall -->

<CLIInteractionSpec interactionverb="1" requesttimeout="120000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
        <InteractionSpec timeout="120000" protocol="CLI" interactionid="cisco_firewall_ispec"/>
    </CLIInteractionSpec>
    
    <CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="#" commandecho="false" promptecho="true">
	    <InteractionSpec timeout="20000" protocol="CLI" interactionid="cisco_firewall_configt_ispec"/>
    </CLIInteractionSpec>

    
    <CLICommand command="no pager">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="cisco_firewall_no_pager_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>

    <CLICommand command="show startup-config">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
            <Record type="CLI" recordid="show_pix_startup" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>

    <CLICommand command="more system:running-config">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
            <Record type="CLI" recordid="show_pix_running" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>

    <CLICommand command="configure terminal">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="cisco_firewall_configure_terminal_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>

    <CLICommand command="clear configure secondary">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="cisco_firewall_clear_config_sec_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>
    
    <CLICommand command="${UserInput:FileContents}">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="cisco_firewall_file_content_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>
    

    <CLICommand command="write mem">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="cisco_firewall_write_mem_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>

    <CLICommand command="exit">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="cisco_firewall_exit_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>

    <CLICommand command="pager lines 24">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="cisco_firewall_pager_24_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>
    
    <!-- For FWSM -->
    <CLICommand command="running-config">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
            <Record type="CLI" recordid="fwsm_source_filename_rec" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>
    
    
<!-- version 7.x configuration -->    
    
<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
	<InteractionSpec timeout="30000" protocol="CLI" interactionid="cisco_firewall__v7_ispec"/>
</CLIInteractionSpec>

<CLICommand command="copy startup-config tftp://${UserInput:tftp_server_address}/${UserInput:file_name}">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="cisco_firewall_v7_cli_backup_startup_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>


<CLICommand command="copy running-config tftp://${UserInput:tftp_server_address}/${UserInput:file_name}">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="cisco_firewall_v7_cli_backup_running_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>


<CLICommand command="copy tftp://${UserInput:tftp_server_address}/${UserInput:file_name} startup-config ">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="cisco_firewall_v7_cli_push_startup_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>


<CLICommand command="copy tftp://${UserInput:tftp_server_address}/${UserInput:file_name} running-config ">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="cisco_firewall_v7_cli_push_running_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>
<!-- For Cisco PIX FWSM Firewall Version 4.0(5) -->

 <CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="[running-config]?" commandecho="false" promptecho="true">
        <InteractionSpec timeout="30000" protocol="CLI" interactionid="cisco_fwsm_cli_fetch_running_ios_10_3_irec_1" />
    </CLIInteractionSpec>

<CLICommand command="copy running-config tftp">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="cisco_fwsm_cli_config_get_running_ios_10_3_rec_1" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>

<CLICommand command="">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="cisco_fwsm_cli_config_get_running_ios_10_3_rec_2" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>

<CLICommand command="terminal pager 0">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="cisco_asa_pager_rec" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>

</cliconfiguration>
