<CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true">
<InteractionSpec timeout="20000" protocol="CLI" interactionid="cisco_configure_terminal_ispec" />
</CLIInteractionSpec>

<CLICommand command="configure terminal">
	<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="cisco_configure_terminal_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

<CLICommand command="end">
	<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="cisco_configure_terminal_end_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

<!-- Commands to enter and exit line config mode -->
<CLICommand command="line vty 0 4">
	<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="cisco_configure_line_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

<CLICommand command="end">
	<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="cisco_configure_line_end_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

<!-- Exit from any mode -->
<CLICommand command="exit">
    <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
      <Record type="CLI" recordid="cisco_exit_from_any_mode_rec" protocol="CLI"/>
    </CLIInputRecord>
</CLICommand>

