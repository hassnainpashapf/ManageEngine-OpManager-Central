<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<CLICommandList>

<!-- execute copy running config tftp command mode -->

    <CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt="?" commandecho="false" promptecho="true">
        <InteractionSpec timeout="20000" protocol="CLI" interactionid="bnt_rackswitch_cli_irec_1"/>
    </CLIInteractionSpec>

<CLICommand command="copy running-config tftp">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="bnt_rackswitch_cli_config_get_running_rec_1" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>

<CLICommand command="copy startup-config tftp">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="bnt_rackswitch_cli_config_get_startup_rec_1" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>
  
<CLICommand command="${UserInput:tftp_server_address}">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="bnt_rackswitch_cli_config_get_rec_2" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>

    <CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
        <InteractionSpec timeout="30000" protocol="CLI" interactionid="bnt_rackswitch_cli_fetch_irec" />
    </CLIInteractionSpec>

<CLICommand command="${UserInput:file_name}">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="bnt_rackswitch_cli_config_get_rec_3" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>


<!-- show config -->

<CLICommand command="terminal length 0">
   <CLIInputRecord messagesuffix="&#13;&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="bnt_rackswitch_cli_paging_disable_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="show startup-config">
   <CLIInputRecord messagesuffix="&#13;&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="bnt_rackswitch_cli_show_startup_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>


<CLICommand command="show running-config">
   <CLIInputRecord messagesuffix="&#13;&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="bnt_rackswitch_cli_show_running_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="copy running-config startup-config">
		<CLIInputRecord messagesuffix="&#13;&#10;" inputsourcetype="1">
			<Record type="CLI" recordid="bnt_rackswitch_cli_sync_config_rec" protocol="CLI"/>
		</CLIInputRecord>
	</CLICommand>

	
	<CLICommand command="write mem">
		<CLIInputRecord messagesuffix="&#13;&#10;" inputsourcetype="1">
			<Record type="CLI" recordid="bnt_rackswitch_sync_config_write_mem_rec" protocol="CLI"/>
		</CLIInputRecord>
	</CLICommand>

<!-- Hardware Properties -->

<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="bnt_rackswitch_cli_hardware_prop_parser" promptactionid="yesActionId">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="bnt_rackswitch_cli_hardware_ispec"/>
</CLIInteractionSpec>

<CLICommand command="show version">
	<CLIInputRecord parsercommandname="hardware_prop_dcn_switch" messagesuffix="&#13;&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="bnt_rackswitch_cli_hardware_version_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand> 



</CLICommandList>
