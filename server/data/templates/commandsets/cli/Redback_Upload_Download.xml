<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<CLICommandList>

<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:Prompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="redback_router_cli_ispec"/>
</CLIInteractionSpec>

<!-- show config -->

<CLICommand command="show configuration">
   <CLIInputRecord messagesuffix="&#13;&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="redback_router_cli_show_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="terminal length 0">
   <CLIInputRecord messagesuffix="&#13;&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="redback_router_paging_disable" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>


<!-- Hardware Properties -->
<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:Prompt}" commandecho="false" promptecho="true" responseparserid="redback_router_hardware_prop_parser" promptactionid="yesActionId">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="redback_router_cli_hardware_ispec"/>
</CLIInteractionSpec>

<CLICommand command="show version">
	<CLIInputRecord parsercommandname="hardware_prop_redback_router" messagesuffix="&#13;&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="redback_router_cli_hardware_version_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>


 <CLICommand command="copy redback.cfg tftp://${UserInput:tftp_server_address}/${UserInput:file_name}">
	    <CLIInputRecord messagesuffix="&#13;&#10;" inputsourcetype="1">
		    <Record type="CLI" recordid="redback_router_cli_backup_startup_rec" protocol="CLI"/>
	    </CLIInputRecord>
    </CLICommand>



</CLICommandList>

