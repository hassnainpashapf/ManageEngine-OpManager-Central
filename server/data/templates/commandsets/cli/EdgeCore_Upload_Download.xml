<CLICommandList>

<!-- execute copy running config tftp command mode -->

    <CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt=":" commandecho="false" promptecho="true">
        <InteractionSpec timeout="750000" protocol="CLI" interactionid="edgecore_switch_cli_irec_1"/>
    </CLIInteractionSpec>

<CLICommand command="copy running-config tftp">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="edgecore_switch_cli_config_get_running_rec_1" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>

<CLICommand command="copy startup-config tftp">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="edgecore_switch_cli_config_get_startup_rec_1" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>
  
<CLICommand command="${UserInput:tftp_server_address}">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="edgecore_switch_cli_config_get_rec_2" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>

    <CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
        <InteractionSpec timeout="30000" protocol="CLI" interactionid="edgecore_switch_cli_fetch_irec" />
    </CLIInteractionSpec>

<CLICommand command="${UserInput:file_name}">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="edgecore_switch_cli_config_get_rec_3" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>

<!-- show config -->

<CLICommand command="terminal length 0">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="edgecore_switch_cli_paging_disable_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="show startup-config">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="edgecore_switch_cli_show_startup_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>


<CLICommand command="show running-config">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="edgecore_switch_cli_show_running_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="copy running-config startup-config">
		<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
			<Record type="CLI" recordid="edgecore_switch_cli_sync_config_rec" protocol="CLI"/>
		</CLIInputRecord>
	</CLICommand>

<!-- Hardware Properties -->

<CLIInteractionSpec interactionverb="1" requesttimeout="40000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="edgecore_switch_cli_hardware_prop_parser" promptactionid="yesActionId">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="edgecore_switch_cli_hardware_ispec"/>
</CLIInteractionSpec>

<CLICommand command="show system">
	<CLIInputRecord parsercommandname="hardware_prop_edgecore_switch" messagesuffix="&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="edgecore_switch_cli_hardware_version_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand> 


<CLICommand command="show version">
	<CLIInputRecord parsercommandname="hardware_prop_edgecore_switch" messagesuffix="&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="edgecore_switch_cli_show_version_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand> 




