<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<CLICommandList>

<!-- execute copy running config tftp command mode -->

    <CLIInteractionSpec  interactionverb="1" requesttimeout="20000" prompt="?" commandecho="false" promptecho="true">
        <InteractionSpec timeout="20000" protocol="CLI" interactionid="ruijie_switch_cli_backup_rec1"/>
    </CLIInteractionSpec>


<CLICommand command="copy startup-config tftp:">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="ruijie_switch_startup_backup_rec" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>
	
<CLICommand command="copy running-config tftp:">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="ruijie_switch_running_backup_rec" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>

<CLICommand command="${UserInput:tftp_server_address}">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="ruijie_switch_tftp_address_rec" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>

    <CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
        <InteractionSpec timeout="30000" protocol="CLI" interactionid="ruijie_switch_cli_backup_rec2" />
    </CLIInteractionSpec>

<CLICommand command="${UserInput:file_name}">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="ruijie_switch_file_name_rec" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>


<!-- Telnet/SSH backup commands -->

<CLICommand command="show running-config">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="ruijie_switch_running_backup_cli_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="show startup-config">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="ruijie_switch_startup_backup_cli_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="terminal length 0">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="ruijie_switch_paging_disable_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<!-- Config Sync Operation -->

<CLICommand command="copy running-config startup-config">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="ruijie_switch_sync_config_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>


<CLICommand command="write memory">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="ruijie_switch_sync_config_rec1" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>


<!-- Hardware Properties -->
<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:Prompt}" commandecho="false" promptecho="true" responseparserid="ruijie_switch_hardware_prop_parser" promptactionid="yesActionId">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="ruijie_switch_cli_hardware_ispec"/>
</CLIInteractionSpec>

<CLICommand command="show version">
	<CLIInputRecord parsercommandname="hardware_prop_ruijie_switch" messagesuffix="&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="ruijie_switch_cli_hardware_version_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

</CLICommandList>
