<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<CLICommandList>

<CLIInteractionSpec interactionverb="1" requesttimeout="60000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
  <InteractionSpec timeout="60000" protocol="CLI" interactionid="ciscomds_cli_ispec"/>
</CLIInteractionSpec>

<!-- Backup Startup -->
<CLICommand command="copy startup-config tftp://${UserInput:tftp_server_address}/${UserInput:file_name}">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="ciscomds_cli_backup_startup_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<!-- Backup Running -->
<CLICommand command="copy running-config tftp://${UserInput:tftp_server_address}/${UserInput:file_name}">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="ciscomds_cli_backup_running_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<!-- Push Startup -->
<CLICommand command="copy tftp://${UserInput:tftp_server_address}/${UserInput:file_name} startup-config">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="ciscomds_cli_push_startup_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<!-- Push Running -->
<CLICommand command="copy tftp://${UserInput:tftp_server_address}/${UserInput:file_name} running-config">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="ciscomds_cli_push_running_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

<!-- Config Sync Operation -->
<CLICommand command="copy running-config startup-config">
  <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
    <Record type="CLI" recordid="ciscomds_sync_config_rec" protocol="CLI"/>
  </CLIInputRecord>
</CLICommand>

</CLICommandList>
