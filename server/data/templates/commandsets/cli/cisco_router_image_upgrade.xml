        <InteractionSpec timeout="20000" protocol="CLI" interactionid="cisco_router_cli_image_download_configure_ispec_1" />
    </CLIInteractionSpec>

<CLICommand command="write">
<CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
<Record type="CLI" recordid="cisco_router_image_download_configure_rec_1" protocol="CLI"/>
</CLIInputRecord>
</CLICommand>
    

    

</CLICommandList>
