<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->

<CLICommandList>
    <CLIInteractionSpec interactionverb="1" requesttimeout="120000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
            <InteractionSpec timeout="120000" protocol="CLI" interactionid="lambda_driver_ispec"/>
     </CLIInteractionSpec>

     <!-- Backup running config -->
     
     <CLICommand command="copy running-config ${UserInput:tftp_server_address} . ${UserInput:file_name}">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
	        <Record type="CLI" recordid="lambda_driver_backup_running_rec" protocol="CLI"/>
        </CLIInputRecord>
     </CLICommand>

    <!-- Backup startup config -->
 
     <CLICommand command="copy startup-config ${UserInput:tftp_server_address} . ${UserInput:file_name}">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
	        <Record type="CLI" recordid="lambda_driver_backup_startup_rec" protocol="CLI"/>
        </CLIInputRecord>
     </CLICommand>

     <!-- Upload startup-config  -->

  <CLICommand command="copy tftp ${UserInput:tftp_server_address} . ${UserInput:file_name} startup-config">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
	        <Record type="CLI" recordid="lambda_driver_upload_startup_rec" protocol="CLI"/>
     </CLIInputRecord>
  </CLICommand>

  <CLICommand command="copy running-config startup-config">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
	        <Record type="CLI" recordid="lambda_driver_sync_rec" protocol="CLI"/>
     </CLIInputRecord>
  </CLICommand>

  <!-- write terminal -->

  <CLICommand command="write terminal">
        <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
	        <Record type="CLI" recordid="lambda_driver_write_terminal_rec" protocol="CLI"/>
     </CLIInputRecord>
  </CLICommand>


   
  <!-- Hardware Properties -->

    <CLIInteractionSpec interactionverb="1" requesttimeout="120000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="mrv_hardware_prop_parser" promptactionid="yesActionId">
        <InteractionSpec timeout="20000" protocol="CLI" interactionid="mrv_hardware_ispec"/>
    </CLIInteractionSpec>

    <CLICommand command="show version">
         <CLIInputRecord parsercommandname="hardware_prop_mrv" messagesuffix="&#10;" inputsourcetype="1">
            <Record type="CLI" recordid="mrv_hardware_prop_rec" protocol="CLI"/>
         </CLIInputRecord>
     </CLICommand>

 </CLICommandList>
