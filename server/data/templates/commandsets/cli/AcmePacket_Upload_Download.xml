<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<CLICommandList>

<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" >
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="acmepacket_cli_ispec"/>
</CLIInteractionSpec>

<!-- show config -->

<CLICommand command="cli more disabled">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="acmepacket_cli_paging_command_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="show running">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="acmepacket_net_3800_cli_fetch_running_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>


<!-- Hardware Properties -->
<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="acmepacket_hardware_prop_parser">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="acmepacket_cli_hardware_ispec"/>
</CLIInteractionSpec>

<CLICommand command="show version">
	<CLIInputRecord parsercommandname="acmepacket_hardware_prop" messagesuffix="&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="acmepacket_cli_hardware_show_version_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

<CLICommand command="show prom-info all">
	<CLIInputRecord parsercommandname="acmepacket_hardware_prop" messagesuffix="&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="acmepacket_cli_hardware_show_prom_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

</CLICommandList>

