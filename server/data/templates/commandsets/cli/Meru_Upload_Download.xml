<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<CLICommandList>

<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="meru_wlan_controller_cli_ispec"/>
</CLIInteractionSpec>

<!-- show config -->

<CLICommand command="show running-config">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="meru_wlan_controller_cli_running_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="show startup-config">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="meru_wlan_controller_cli_startup_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="terminal length 0">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="meru_wlan_controller_cli_paging_disable_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>


<!-- Hardware Properties -->
<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="meru_wlan_controller_hardware_prop_parser" promptactionid="yesActionId">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="meru_wlan_controller_cli_hardware_ispec"/>
</CLIInteractionSpec>

<CLICommand command="show controller">
	<CLIInputRecord parsercommandname="hardware_prop_meru_wlan_controller" messagesuffix="&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="meru_wlan_controller_cli_hardware_version_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

</CLICommandList>

