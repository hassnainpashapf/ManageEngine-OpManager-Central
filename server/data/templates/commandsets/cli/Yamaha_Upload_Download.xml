<!-- $Id$ -->
<CLICommandList>

<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" promptactionid="yesActionId">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="yamaha_router_cli_ispec"/>
</CLIInteractionSpec>

<!-- show config -->

<CLICommand command="show config">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="yamaha_router_cli_show_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

<CLICommand command="console lines infinity">
   <CLIInputRecord messagesuffix="&#10;" inputsourcetype="1">
     <Record type="CLI" recordid="yamaha_router_cli_console_lines_infinite_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>


<!-- Hardware Properties -->
<CLIInteractionSpec interactionverb="1" requesttimeout="30000" prompt="${UserInput:EnablePrompt}" commandecho="false" promptecho="true" responseparserid="yamaha_router_hardware_prop_parser" promptactionid="yesActionId">
   <InteractionSpec timeout="30000" protocol="CLI" interactionid="yamaha_router_cli_hardware_ispec"/>
</CLIInteractionSpec>

<CLICommand command="show environment">
	<CLIInputRecord parsercommandname="hardware_prop_yamaha_router" messagesuffix="&#10;" inputsourcetype="1">
	   <Record type="CLI" recordid="yamaha_router_cli_hardware_version_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

</CLICommandList>

