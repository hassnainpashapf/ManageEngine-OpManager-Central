</CLIInteractionSpec>

<CLICommand command="show version">
	<CLIInputRecord parsercommandname="hardware_prop_nec_ix2025" messagesuffix="&#13;&#10;" inputsourcetype="1">
		<Record type="CLI" recordid="nec_ix2025_hardware_prop_rec" protocol="CLI"/>
	</CLIInputRecord>
</CLICommand>

<CLICommand command="show hardware">
	<CLIInputRecord parsercommandname="hardware_prop_nec_ix2025" messagesuffix="&#13;&#10;" inputsourcetype="1">
