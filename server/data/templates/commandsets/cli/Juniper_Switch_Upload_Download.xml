	<Record type="CLI" recordid="juniper_srx_cli_config_rec" protocol="CLI"/>
   </CLIInputRecord>
</CLICommand>

    <!-- H/W population -->


    <CLIInteractionSpec interactionverb="1" requesttimeout="20000" prompt=">" commandecho="false" promptecho="true" responseparserid="juniper_srx_hardware_prop_parser" promptactionid="yesActionId">
	    <InteractionSpec timeout="20000" protocol="CLI" interactionid="juniper_srx_hardware_prop_ispec"/>
    </CLIInteractionSpec>
    
    <CLICommand command="show version">
	    <CLIInputRecord parsercommandname="hardware_prop_juniper_srx" messagesuffix="&#10;" inputsourcetype="1">
		    <Record type="CLI" recordid="juniper_srx_hardware_prop_rec" protocol="CLI"/>
	    </CLIInputRecord>
    </CLICommand>
    
    <CLICommand command="show chassis hardware">
	    <CLIInputRecord parsercommandname="hardware_prop_juniper_srx" messagesuffix="&#10;" inputsourcetype="1">
	    	<Record type="CLI" recordid="juniper_srx_hardware_prop_rec2" protocol="CLI"/>
	    </CLIInputRecord>
    </CLICommand>

    <CLICommand command="show chassis mac-addresses">
        <CLIInputRecord parsercommandname="hardware_prop_juniper_srx_two" messagesuffix="&#10;" inputsourcetype="1">
            <Record type="CLI" recordid="juniper_srx_hardware_prop_rec3" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>

    <CLICommand command="show system snapshot media internal">
        <CLIInputRecord parsercommandname="hardware_prop_juniper_srx_two" messagesuffix="&#10;" inputsourcetype="1">
            <Record type="CLI" recordid="juniper_srx_hardware_prop_rec4" protocol="CLI"/>
        </CLIInputRecord>
    </CLICommand>
	
	
