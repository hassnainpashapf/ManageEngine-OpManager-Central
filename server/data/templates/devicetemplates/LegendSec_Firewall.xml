<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="LegendSec Firewall" osType="SecOS" templateName="LegendSec_Firewall" multiConfigTemplate="false" category="Firewall">
	<RestTemplate name=""/>
	<Vendor displayName="LegendSec" vendorName="LegendSec">
		<Commands>
			<Command commandstr="show version"/>
			<Command commandstr="show hardware"/>
		</Commands>
		<LoggingLevels>
			<Level name="notifications" number="5" sequenceid="0"/>
			<Level name="informational" number="6" sequenceid="1"/>
			<Level name="debugging" number="7" sequenceid="2"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="Startup">
                	<Command commandstr="show startup-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="3" timeout="280000" promptactionid="LegendSecId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="Running">
                	<Command commandstr="show running-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="3" timeout="280000" promptactionid="LegendSecId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="LegendSecFirewall" personalityName="LegendSecFirewall">
		<Login enablecommand="enable" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="SW_VERSION" size="100" desc="software Version" displayname="Sw_Version" defaultvalue="Not Available" sequenceid="1"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n\n^Current.*\n</Regex>
					<Regex>^Using.*out.*</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers>
				<SyslogState state="disable">
					<Regex>no logging on</Regex>
					<Regex>logging trap (emergencies|alerts|critical|errors|warnings)</Regex>
				</SyslogState>
				<SyslogState state="enable">
					<Regex>(logging $SYSLOG_SERVER_IP$)|(logging host $SYSLOG_SERVER_IP$)</Regex>
				</SyslogState>
			</SyslogStateCheckers>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="LegendSecFirewallHwPropParser.xml">
				<MESSAGE-PARSER>
					<PARSER TYPE="rule1" CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser">
						<COMMAND NAME="hardware_prop_legendsec_firewall">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX EXPRESSION=".*Serial Number\s*:\s*(\S*).*" NAME="SERIALNUMBER">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX NAME="CmdError1" EXPRESSION=".*(Incomplete command).*">
										 <PARAM NAME="ErrorMsg" TOKENNO="0" />
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" parsercommandname="hardware_prop_legendsec_firewall" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="120000" promptactionid="LegendSecId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds>
		<PromptActionId command="R" prompt="--More--" name="LegendSecId"/>
	</PromptActionIds>
</NCMDeviceTemplate>
