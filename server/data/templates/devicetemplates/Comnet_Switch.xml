<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="Comnet Switch" osType="NA" templateName="Comnet_Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Comnet" vendorName="Comnet">
		<Commands>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels>
			<Level name="notifications" number="5" sequenceid="0"/>
			<Level name="informational" number="6" sequenceid="1"/>
			<Level name="debugging" number="7" sequenceid="2"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
		
		    <OperationGroup type="backup">
            	
            	<Operation name="Running">				
                    <Command commandecho="" commandstr="terminal length 0" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="NA" promptecho="" readfromresponse="false" sequenceid="3" timeout="20000"/>
                	<Command commandecho="" commandstr="show running-config" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="H3CSwitchActionId" promptecho="" readfromresponse="true" sequenceid="4" timeout="60000"/>
            	</Operation>
           	</OperationGroup>
			<OperationGroup type="Others">
			   	<Operation name="syncconfiguration">
                	<Command commandstr="copy running-config startup-config" messagesuffix="${LF}" prompt="${UserInput:Prompt}" sequenceid="10" timeout="30000" promptactionid="H3CSwitchActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            </OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Comnet Switch" personalityName="ComnetSwitch">	
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Chipset ID" displayname="Chipset ID" name="CHIPSETID" sequenceid="1" size="100"/>
					<Column defaultvalue="Not Available" desc="Board Type" displayname="Board Type" name="BOARDTYPE" sequenceid="1" size="100"/>
					<Column defaultvalue="Not Available" desc="Flash" displayname="Flash" name="FLASH" sequenceid="1" size="100"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n\n^Current.*\n</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="ComnetSwitchHwPropParser.xml">
				<MESSAGE-PARSER>
					<PARSER TYPE="rule1" CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser">
						<COMMAND NAME="hardware_prop_comnet_switch">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="OSVERSION" EXPRESSION=".*Software Version.*Version\s*(\S*).*">																	
											<PARAM NAME="OSVERSION" TOKENNO="1"/>													
										</REGEX>	
										<REGEX NAME="MODEL" EXPRESSION=".*System Type\s*:\s*(\S*).*">																	
											<PARAM NAME="MODEL" TOKENNO="1"/>													
										</REGEX>
										<REGEX NAME="MACADDRESS" EXPRESSION=".*MAC\s*Address\s*:\s*(\S*).*">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>										
										<REGEX NAME="CHIPSETID" EXPRESSION=".*Chipset\s*ID\s*:\s*(\S*).*">
											<PARAM NAME="CHIPSETID" TOKENNO="1"/>
										</REGEX>	
										<REGEX NAME="BOARDTYPE" EXPRESSION=".*Board\s*Type\s*:\s*(\S*).*">
											<PARAM NAME="BOARDTYPE" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="FLASH" EXPRESSION=".*FLASH\s*:\s*(\S*)\,.*">
											<PARAM NAME="FLASH" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX NAME="CmdError1" EXPRESSION=".*(Incomplete command).*">
										 <PARAM NAME="ErrorMsg" TOKENNO="0" />
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" messagesuffix="${LF}" parsercommandname="hardware_prop_comnet_switch" prompt="${UserInput:Prompt}" promptactionid="H3CSwitchActionId" responseparserid="comnet_switch_hardware_prop_parser" timeout="20000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList>
        <NCMDeviceSysOID model="CNGE3FE8MSPOE" ostype="NA" series="CNGE3FE8MS" sysoid=".1.3.6.1.4.1.32298.2.2.96"/>
    </NCMDeviceSysOIDList>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
