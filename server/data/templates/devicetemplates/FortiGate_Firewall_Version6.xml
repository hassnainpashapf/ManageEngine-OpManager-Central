    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="FortiGate Firewall Version6" personalityName="FortiGateFirewallVersion6">	
		<Login enablecommand="" suffix="${LF}" postloginprompt="a):" postlogincommand="a" preloginprompt="a):" prelogincommand="a"/>
		<PersonalityTable>
			<Columns>
				<Column name="BIOSVERSION" size="20" desc="Bios Version" displayname="BIOS Version" defaultvalue="Not Available" sequenceid="2"/>
				<Column name="VIRUSDB" size="50" desc="Virus DB" displayname="Virus DB" defaultvalue="Not Available" sequenceid="3"/>
				<Column name="IPSDB" size="50" desc="Ips DB" displayname="IPS DB" defaultvalue="Not Available" sequenceid="4"/>
				<Column name="OPERATIONMODE" size="20" desc="Operation Mode" displayname="Operation Mode" defaultvalue="Not Available" sequenceid="5"/>
				<Column name="LOGHARDDISK" size="20" desc="Log Hard Disk Availability" displayname="Log Hard Disk" defaultvalue="Not Available" sequenceid="6"/>
				<Column name="MAXVIRTUALDOMAINS" size="15" desc="Maximum number of virtual domains" displayname="Maximum Virtual Domains" defaultvalue="Not Available" sequenceid="7"/>
				<Column name="CURRENTVIRTUALDOMAIN" size="15" desc="Current Virtual Domain" displayname="Current Virtual Domain" defaultvalue="Not Available" sequenceid="8"/>
				<Column name="CURRENTHASTATUS" size="20" desc="Current HA Status" displayname="Current HA Status" defaultvalue="Not Available" sequenceid="9"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers>
				<SyslogState state="enable">
					<Regex>set\s*status\s*enable</Regex>
					<Regex>set\s*server\s*$SYSLOG_SERVER_IP</Regex>
				</SyslogState>
			</SyslogStateCheckers>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="FortiOSDevPropParser.xml"/>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="get system status" parsercommandname="fortios_device_hardware_prop" responseparserid="fortios_device_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="60000" promptactionid="yesActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
