<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="Cisco APIC Fabric Controller" osType="APIC" templateName="Cisco_APIC_Fabric_Controller">
	<RestTemplate name=""/>
	<Vendor displayName="Cisco" vendorName="Cisco">
		<Commands>
			<Command commandstr="show version"/>
			<Command commandstr="show interfaces"/>
			<Command commandstr="show access-lists"/>
			<Command commandstr="show logging"/>
			<Command commandstr="show ip traffic"/>
			<Command commandstr="show buffers"/>
			<Command commandstr="show hardware"/>
		</Commands>
		<LoggingLevels>
			<Level name="notifications" number="5" sequenceid="0"/>
			<Level name="informational" number="6" sequenceid="1"/>
			<Level name="debugging" number="7" sequenceid="2"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="running">
                	<Command commandstr="terminal length 0" messagesuffix="${LF}" prompt="${UserInput:Prompt}" sequenceid="10" timeout="120000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show running-config" messagesuffix="${LF}" prompt="${UserInput:Prompt}" sequenceid="20" timeout="240000" promptactionid="yesActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Cisco APIC" personalityName="CiscoAPIC">	
		<Login enablecommand="" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="CONTROLLER_VERSION" size="50" desc="Controller Version" displayname="Controller Version" defaultvalue="Not Available" sequenceid="1"/>
				<Column name="SPINE_VERSION" size="50" desc="Spine Version" displayname="Spine Version" defaultvalue="Not Available" sequenceid="2"/>
				<Column name="LEAF_VERSION" size="50" desc="Leaf Version" displayname="Leaf Version" defaultvalue="Not Available" sequenceid="3"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>.*Generating current config:.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="CiscoAPICHwPropParser.xml">
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="cisco_apic_hardware_prop_cmd">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="CONTROLLER_VERSION" EXPRESSION=".*controller(\s*\S*){1,3}\s*(\S*).*">
										  <PARAM NAME="CONTROLLER_VERSION" TOKENNO="2"/>
									  </REGEX>
										<REGEX EXPRESSION="\s*spine(\s*\S*){1,3}\s*(\S*).*" NAME="SPINE_VERSION">
											<PARAM NAME="SPINE_VERSION" TOKENNO="2"/>
										</REGEX>
										<REGEX EXPRESSION=".*leaf(\s*\S*){1,3}\s*(\S*).*" NAME="LEAF_VERSION">
											<PARAM NAME="LEAF_VERSION" TOKENNO="2"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<METADATA>
									<SCALAR>
										<REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
											<PARAM NAME="ErrorMsg" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
						<COMMAND NAME="cisco_apic_hardware_prop_cmd2">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME=".*(?i)model\s*:\s*(\S+).*" EXPRESSION="MODEL">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME=".*(?i)Version\s*:\s*(\S+).*" EXPRESSION="OSVERSION">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<METADATA>
									<SCALAR>
										<REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
											<PARAM NAME="ErrorMsg" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" parsercommandname="cisco_apic_hardware_prop_cmd" responseparserid="cisco_apic_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:Prompt}" timeout="60000" promptactionid="yesActionId"/>
						<Command commandstr="moquery -c fabricNode | grep APIC" parsercommandname="cisco_apic_hardware_prop_cmd2" responseparserid="cisco_apic_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:Prompt}" timeout="60000" promptactionid="yesActionId"/>
						<Command commandstr="show controller detail" parsercommandname="cisco_apic_hardware_prop_cmd2" responseparserid="cisco_apic_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:Prompt}" timeout="60000" promptactionid="yesActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
