<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="Extreme Switch Device" osType="" templateName="Extreme_Switch_Device">
	<RestTemplate name=""/>
	<Vendor displayName="Extreme" vendorName="Extreme"/>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="running">
                	<Command commandstr="terminal length 0" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="60000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show running-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="240000" promptactionid="yesActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
            <OperationGroup type="changedetection">
            	<Operation name="enable">
                	<Command commandstr="logging remote address ${UserInput:HostIpAddress}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="2" timeout="20000" promptactionid="NA" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="logging remote secondary-address ${UserInput:HostIpAddress}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="3" timeout="20000" promptactionid="NA" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="logging remote level ${UserInput:LoggingLevel}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="4" timeout="20000" promptactionid="NA" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="logging remote enable" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="5" timeout="20000" promptactionid="NA" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="disable">				
                	<Command commandstr="no logging remote address ${UserInput:HostIpAddress}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="1" timeout="20000" promptactionid="NA" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="no logging remote enable" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="2" timeout="20000" promptactionid="NA" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Extreme Switch Device" personalityName="ExtremeSwitchDevice">	
		<Login enablecommand="enable" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="SOFTWARE_VERSION" size="50" desc="Software Version" displayname="Software Version" defaultvalue="Not Available" sequenceid="1"/>
				<Column name="PART_NUMBER" size="100" desc="Part Number" displayname="Part Number" defaultvalue="Not Available" sequenceid="2"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>.*Generating current config:.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="ExtremeSwitchHwPropParser.xml">
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="extreme_switch_device_hardware_prop">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX EXPRESSION=".*Machine\s*Type.*Extreme\s*(\S*).*" NAME="SERIES">
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*Machine\s*Model\S*\s*(.*)" NAME="MODEL">
											<PARAM NAME="MODEL" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*Serial\s*Number\S*\s*(.*)" NAME="SERIALNUMBER">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*MAC\s*Address\S*\s*(.*)" NAME="MACADDRESS">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*Software\s*Version\S*\s*(.*)" NAME="SOFTWARE_VERSION">
											<PARAM NAME="SOFTWARE_VERSION" TOKENNO="1"/>
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*Part\s*Number\S*\s*(.*)" NAME="PART_NUMBER">
											<PARAM NAME="PART_NUMBER" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*Network\s*Processing\s*Device\S*\s*(.*)" NAME="NETWORK_PROC_DEV">
											<PARAM NAME="NETWORK_PROC_DEV" TOKENNO="1"/>
										</REGEX>
										
										<REGEX NAME="MACADDRESS" EXPRESSION=".*MAC\s*Address\s*:\s*(.*)">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MODEL" EXPRESSION=".*sysDescr\s*:\s*Ethernet.*Switch\s*(.*)">
											<PARAM NAME="MODEL" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="OSVERSION" EXPRESSION=".*HW\s*:\s*(\S*)\s*FW\s*:\s*(\S*)\s*SW\s*:\s*(\S*).*">
											<PARAM NAME="SOFTWARE_VERSION" TOKENNO="3"/>
											<PARAM NAME="OSVERSION" TOKENNO="3"/>
										</REGEX>
										
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<METADATA>
									<SCALAR>
										<REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
											<PARAM NAME="ErrorMsg" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" parsercommandname="extreme_switch_device_hardware_prop" responseparserid="extreme_switch_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="60000" promptactionid="yesActionId"/>
						<Command commandstr="show system" parsercommandname="extreme_switch_device_hardware_prop" responseparserid="extreme_switch_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
