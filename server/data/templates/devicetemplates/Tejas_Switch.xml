<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="For Tejas Switches" displayName="Tejas Switch" osType="TEJNOS" templateName="Tejas Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Tejas" vendorName="Tejas">
		<Commands>
			<Command commandstr="show version"/>
			<Command commandstr="show logging"/>
			<Command commandstr="show buffers"/>
			<Command commandstr="show hardware"/>
		</Commands>
		<LoggingLevels>
			<Level name="notifications" number="5" sequenceid="0"/>
			<Level name="informational" number="6" sequenceid="1"/>
			<Level name="debugging" number="7" sequenceid="2"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
			<OperationGroup type="Backup">
				<Operation name="Running">
					<Command commandecho="" commandstr="terminal length 0" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="NA" promptecho="" readfromresponse="false" sequenceid="2" timeout="20000"/>
					<Command commandecho="" commandstr="show running-config" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" promptecho="" readfromresponse="true" sequenceid="3" timeout="20000"/>
				</Operation>
			</OperationGroup>
			<OperationGroup type="Others">
				<Operation name="Syncconfiguration">
					<Command commandecho="" commandstr="write mem" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" promptecho="" readfromresponse="" sequenceid="2" timeout="30000"/>
				</Operation>
			</OperationGroup>
		</Protocol>
	</Protocols>
	<NCMPersonality displayName="Tejas Switch" personalityName="TejasSwitch">
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Part Number" displayname="Part Number" name="PART_NUMBER" sequenceid="10" size="150"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n\n^Current.*\n</Regex>
					<Regex>^Using.*out.*</Regex>
					<Regex>.*Running\s*configuration.*</Regex>
					<Regex>.*Current\s*configuration.*</Regex>
					<Regex>.*show\srunning-config.*</Regex>
					<Regex>.*System Up Time.*</Regex>
					<Regex>.*nal length 0*</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="TejasSwitchHardwarePropParser.xml">
				<MESSAGE-PARSER>
					<PARSER TYPE="rule1" CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser">
						<COMMAND NAME="hardware_prop_tejas_switch">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="SERIES" EXPRESSION=".*Machine\sModel\.+\s+(\S+).*">
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MODEL" EXPRESSION=".*Machine\sType\.+\s+(\S+).*">
											<PARAM NAME="MODEL" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="OSVERSION" EXPRESSION=".*Software\sVersion\.+\s+(\S+).*">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MACADDRESS" EXPRESSION=".*Burned\sIn\sMAC\sAddress\.+\s+(\S+).*">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="SERIALNUMBER" EXPRESSION=".*Serial\sNumber\.+\s+(\S+).*">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="PART_NUMBER" EXPRESSION=".*Part\sNumber\.+\s+(\S+).*">
											<PARAM NAME="PART_NUMBER" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
										<!-- error message for command  -->
										<REGEX NAME="CmdError1" EXPRESSION=".*(Incomplete command).*">
											<PARAM NAME="ErrorMsg" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
						<ERROR-RULES>
							<!-- multiple error rule tags can be given -->
							<ERROR-RULE>
								<METADATA>
									<SCALAR>
										<!-- scalar parser rule -->
										<!-- common error message -->
										<REGEX NAME="Error1" EXPRESSION=".*(Invalid input detected).*">
											<PARAM NAME="ErrorMsg1" TOKENNO="0"/>
										</REGEX>
										<REGEX NAME="Error2" EXPRESSION=".*(Unknown command or computer name).*">
											<PARAM NAME="ErrorMsg2" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</ERROR-RULES>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" messagesuffix="${LF}" parsercommandname="hardware_prop_tejas_switch" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" timeout="20000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
