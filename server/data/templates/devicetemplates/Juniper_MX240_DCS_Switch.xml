    <NCMPersonality displayName="Juniper DCS Switch" personalityName="JuniperDCSSwitch">	
		<Login enablecommand="cli" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="KERNEL" size="50" desc="Kernel" displayname="Kernel" defaultvalue="Not Available" sequenceid="1"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
				<Criteria type="deleteLine">
					<Regex>##Last commit.*</Regex>
					<Regex>##Last changed.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers>
				<SyslogState state="enable">
					<Regex>set\s*system\s*syslog\s*host\s*$SYSLOG_SERVER_IP</Regex>
				</SyslogState>
			</SyslogStateCheckers>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="JuniperDCSSwitchPropParser.xml"> 
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_juniperDCS">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="KERNEL" EXPRESSION=".*Kernel\s*(\S*).*">
										  <PARAM NAME="KERNEL" TOKENNO="1"/>
									  </REGEX>
										<REGEX EXPRESSION=".*Model:\s*(.*)" NAME="MODEL">
											<PARAM NAME="MODEL" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*Junos:\s*(.*)" NAME="OSVERSION">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
										<!-- error message for command  -->
										<REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
											<PARAM NAME="ErrorMsg" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" parsercommandname="hardware_prop_juniperDCS" responseparserid="Juniper_MX240_DCS_Switch_hw_prop_parser" messagesuffix="${LF}" prompt=">" timeout="20000" promptactionid="yesActionId"/>
						<Command commandstr="set cli screen-length 0" parsercommandname="hardware_prop_juniperDCS" responseparserid="Juniper_MX240_DCS_Switch_hw_prop_parser" messagesuffix="${LF}" prompt=">" timeout="20000" promptactionid="yesActionId"/>
					</Commands>
