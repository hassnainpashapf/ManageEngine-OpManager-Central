<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="For Nokia 7210 SAS, 7705 SAR, and 7250 IXR-e routers" displayName="Nokia Serivce Router" osType="TiMOS" templateName="Nokia_Service_Router" multiConfigTemplate="false" category="Router">
	<RestTemplate name=""/>
	<Vendor displayName="Nokia" vendorName="Nokia">
		<Commands>
			<Command commandstr="show hardware info"/>
			<Command commandstr="show configuration snapshot"/>
			<Command commandstr="show system"/>
		</Commands>
		<LoggingLevels/>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="Startup">
                	<Command commandstr="environment no more" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="60000" promptactionid="NA" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="admin display-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="60000" promptactionid="NA" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
		<Protocol name="SSH/TELNET - TFTP">
        	<OperationGroup type="backup">
            	<Operation name="Startup">
                	<Command commandstr="admin save tftp://${UserInput:tftp_server_address}/${UserInput:file_name}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="60000" promptactionid="NA" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Nokia Service Routers" personalityName="NokiaServiceRouters">	
		<Login enablecommand="" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="LAST_BOOTED_CONFIG" size="100" desc="CPU Type" displayname="Last Booted Config File :" defaultvalue="Not Available" sequenceid="1"/>
				<Column name="BOF" size="100" desc="Identifies the size of FLASH in MB" displayname="BOF Source" defaultvalue="Not Available" sequenceid="2"/>
				<Column name="IMAGE_SOURCE" size="100" desc="Identifies the size of DRAM in MB" displayname="Image Source" defaultvalue="Not Available" sequenceid="3"/>
				<Column name="CONFIG_SOURCE" size="100" desc="Version of Boot ROM" displayname="Config Source" defaultvalue="Not Available" sequenceid="4"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="NokiaServiceRouterHardwarePropParser.xml">
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_nokia_sar_show_chasis">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="MODEL1" EXPRESSION=".*(?i)Type\s*[:=]\s*((\S+\sSAR).*)">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIES" TOKENNO="2"/>
										</REGEX>
										<REGEX NAME="MODEL2" EXPRESSION=".*(?i)Type\s*[:=]\s*(\S+\sSAS\S+)\s(.*)">
											<PARAM NAME="MODEL" TOKENNO="2"/>
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MODEL3" EXPRESSION=".*(?i)Type\s*[:=]\s*(\S+)\s(.*)">
											<PARAM NAME="MODEL" TOKENNO="2"/>
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MACADDRESS" EXPRESSION=".*(?i)MAC\s*Address\s*[:=]\s*(\S+).*">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>	  
										</REGEX>
										<REGEX NAME="SERIALNUMBER" EXPRESSION=".*(?i)Serial\s*Number\s*[:=]\s*(\S+).*">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>	  
										</REGEX>
										<REGEX NAME="PART_NUMBER" EXPRESSION=".*(?i)Part\s*Number\s*[:=]\s*(\S+).*">
											<PARAM NAME="PART_NUMBER" TOKENNO="1"/>	  
										</REGEX>									
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
						<COMMAND NAME="hardware_prop_nokia_sar_show_ver">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">				
										<REGEX NAME="OSVERSION" EXPRESSION=".*(?i)TiMOS-(\S+).*">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>	  
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
						<COMMAND NAME="hardware_prop_nokia_sar_show_sys_info">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
									<REGEX NAME="MODEL1" EXPRESSION=".*(?i)System\s*Type\s*[:=]\s*((\S+\sSAR).*)">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIES" TOKENNO="2"/>
										</REGEX>
										<REGEX NAME="MODEL2" EXPRESSION=".*(?i)System\s*Type\s*[:=]\s*(\S+\sSAS\S+)\s(.*)">
											<PARAM NAME="MODEL" TOKENNO="2"/>
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MODEL3" EXPRESSION=".*(?i)System\s*Type\s*[:=]\s*(\S+)\s(.*)">
											<PARAM NAME="MODEL" TOKENNO="2"/>
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
									<REGEX NAME="LAST_BOOTED_CONFIG" EXPRESSION=".*(?i)Last\s*Booted\s*Config\s*File\s*:\s*(\S+).*">
										<PARAM NAME="LAST_BOOTED_CONFIG" TOKENNO="1"/>
									</REGEX>
									<REGEX NAME="BOF" EXPRESSION=".*(?i)BOF\s*Source\s*:\s*(\S+).*">
										<PARAM NAME="BOF" TOKENNO="1"/>
									</REGEX>
									<REGEX NAME="IMAGE_SOURCE" EXPRESSION=".*(?i)Image\s*Source\s*:\s*(\S+).*">
										<PARAM NAME="IMAGE_SOURCE" TOKENNO="1"/>
									</REGEX>
									<REGEX NAME="CONFIG_SOURCE" EXPRESSION=".*(?i)Config\s*Source\s*:\s*(\S+).*">
										<PARAM NAME="CONFIG_SOURCE" TOKENNO="1"/>
									</REGEX>		
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							
							<ERROR-RULE>
							<!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									<!-- error message for command  -->
									<REGEX NAME="CmdError1" EXPRESSION=".*(Incomplete command).*">
										<PARAM NAME="ErrorMsg" TOKENNO="0" />
									</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
							</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser> 
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show chassis" parsercommandname="hardware_prop_nokia_sar_show_chasis" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="30000" promptactionid="yesActionId"/>
						<Command commandstr="show version" parsercommandname="hardware_prop_nokia_sar_show_ver" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="30000" promptactionid="yesActionId"/>
						<Command commandstr="show system information" parsercommandname="hardware_prop_nokia_sar_show_sys_info"  messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList>
		<NCMDeviceSysOID model="7210 SAS" ostype="NA" series="" sysoid=".1.3.6.1.4.1.6527.6.2.1.2.9.11"/>
		<NCMDeviceSysOID model="" ostype="NA" series="" sysoid=".1.3.6.1.4.1.6527.1.18.4"/>
		<NCMDeviceSysOID model="7210 SAS" ostype="NA" series="" sysoid=".1.3.6.1.4.1.6527.6.2.1.2.9.14"/>
	</NCMDeviceSysOIDList>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
