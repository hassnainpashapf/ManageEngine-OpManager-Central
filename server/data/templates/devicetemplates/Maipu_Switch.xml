<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="For Maipu Switch" displayName="Maipu Switch" osType="MyPowerOS" templateName="Maipu_Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Maipu" vendorName="Maipu">
		<Commands>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels/>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
					<Command commandecho="" commandstr="show running-config" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" promptecho="" readfromresponse="true" sequenceid="1" timeout="30000"/>
            	</Operation>
            	<Operation name="Startup">
					<Command commandecho="" commandstr="show startup-config" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" promptecho="" readfromresponse="true" sequenceid="1" timeout="30000"/>
            	</Operation>
        	</OperationGroup>
			<OperationGroup type="others">
            	<Operation name="syncconfiguration">
                	<Command commandstr="write" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="1" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Maipu Switch" personalityName="MaipuSwitch">	
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Version of Hardware in the switch" displayname="Hardware Version" name="HARDWAREVERSION" sequenceid="1" size="15"/>
				<Column defaultvalue="Not Available" desc="Version of MPU CPLD in the switch" displayname="MPU CPLD Version" name="MPUCPLDVERSION" sequenceid="2" size="15"/>
				<Column defaultvalue="Not Available" desc="Version of Monitor in the switch" displayname="Monitor Version" name="MONITORVERSION" sequenceid="3" size="15"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n\n^Current.*\n</Regex>
					<Regex>^Using.*out.*</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="MaipuSwitchHardwarePropParser.xml"> 
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_maipu_switch">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="SERIES" EXPRESSION=".*\s*MyPower\s*(\S*)\s*Version\s*Information.*">  
											<PARAM NAME="SERIES" TOKENNO="1"/>	
										</REGEX>
										<REGEX NAME="MODEL" EXPRESSION=".*Hardware\s*Model\s*:\s*(\S*).*">
											<PARAM NAME="MODEL" TOKENNO="1"/>	  
										</REGEX>
										<REGEX NAME="OSVERSION" EXPRESSION=".*Software\s*Version\s*:\s*(\S*).*">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>	  
										</REGEX>
										<REGEX NAME="IMAGEFILENAME" EXPRESSION=".*Software\s*Image\s*File\s*:\s*\S*\s*(\S*).*">
											<PARAM NAME="IMAGEFILENAME" TOKENNO="1"/>	  
										</REGEX>										
										<REGEX NAME="HARDWAREVERSION" EXPRESSION=".*Hardware\s*Version\s*:\s*(\S*).*">
											<PARAM NAME="HARDWAREVERSION" TOKENNO="1"/>	  
										</REGEX>										
										<REGEX NAME="MPUCPLDVERSION" EXPRESSION=".*MPU\s*CPLD\s*Version\s*:\s*(\S*).*">
											<PARAM NAME="MPUCPLDVERSION" TOKENNO="1"/>	  
										</REGEX>										
										<REGEX NAME="MONITORVERSION" EXPRESSION=".*Monitor\s*Version\s*:\s*(\S*).*">
											<PARAM NAME="MONITORVERSION" TOKENNO="1"/>	  
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" messagesuffix="${LF}" parsercommandname="hardware_prop_maipu_switch" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" timeout="20000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList>
	    <NCMDeviceSysOID model="S4126E" ostype="MyPower" series="S4100" sysoid=".1.3.6.1.4.1.5651.1.70"/>
	    <NCMDeviceSysOID model="S4128E" ostype="MyPower" series="S4100" sysoid=".1.3.6.1.4.1.5651.1.102.11"/>
	    <NCMDeviceSysOID model="S6800" ostype="MyPower" series="S6800" sysoid=".1.3.6.1.4.1.5651.1.102.29"/>
	    <NCMDeviceSysOID model="SM3120-52TC" ostype="MyPower" series="S3120" sysoid=".1.3.6.1.4.1.5651.1.102.127"/>
	</NCMDeviceSysOIDList>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
