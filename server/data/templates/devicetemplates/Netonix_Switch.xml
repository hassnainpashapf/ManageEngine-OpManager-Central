<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="For Netonix Switches" displayName="Netonix Switch" osType="" templateName="Netonix Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Netonix" vendorName="Netonix">
		<Commands/>
		<LoggingLevels/>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="terminal length 0 " delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="NA" promptecho="" readfromresponse="false" sequenceid="2" timeout=""/>
                	<Command commandecho="" commandstr="show config" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="yesActionId" promptecho="" readfromresponse="true" sequenceid="3" timeout=""/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Netonix Switch" personalityName="NetonixSwitch">	
		<Login enablecommand="" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Firmware Version" displayname="Firmware Version" name="FIRMWAREVERSION" sequenceid="10" size="100"/>
				<Column defaultvalue="Not Available" desc="CPU Usage" displayname="CPU Usage" name="CPUUSAGE" sequenceid="20" size="100"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="NetonixHardwarePropParser.xml">
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_netonix_switch">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX EXPRESSION=".*Firmware\s*Version:\s*(\S*).*" NAME="FIRMWAREVERSION">
											<PARAM NAME="FIRMWAREVERSION" TOKENNO="1"/>
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>							
										<REGEX EXPRESSION=".*CPU\s*Usage:\s*(\S*).*" NAME="CPUUSAGE">
											<PARAM NAME="CPUUSAGE" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*Model:\s*(\S*).*" NAME="MODEL">
											<PARAM NAME="MODEL" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*MAC\s*Address:\s*(\S*).*" NAME="MACADDRESS">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show status" messagesuffix="${LF}" parsercommandname="hardware_prop_netonix_switch" prompt="${UserInput:Prompt}" promptactionid="yesActionId" timeout="30000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
