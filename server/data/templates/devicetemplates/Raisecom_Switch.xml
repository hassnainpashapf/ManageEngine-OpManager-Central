<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="Raisecom" displayName="Raisecom Switch" osType="RaiseComOS" templateName="Raisecom_Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Raisecom" vendorName="Raisecom">
		<Commands>
			<Command commandstr="show interfaces"/>
			<Command commandstr="show access-lists"/>
			<Command commandstr="show logging"/>
			<Command commandstr="show ip traffic"/>
			<Command commandstr="show buffers"/>
			<Command commandstr="show hardware"/>
			<Command commandstr="show version"/>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels>
			<Level name="notifications" number="5" sequenceid="0"/>
			<Level name="informational" number="6" sequenceid="1"/>
			<Level name="debugging" number="7" sequenceid="2"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="terminal length 0" delay="" messagesuffix="${LF}" prompt="" promptactionid="NA" promptecho="" readfromresponse="false" sequenceid="2" timeout=""/>
                	<Command commandecho="" commandstr="show running-config" delay="" messagesuffix="${LF}" prompt="" promptactionid="yesActionId" promptecho="" readfromresponse="true" sequenceid="3" timeout="240000"/>
            	</Operation>
            	<Operation name="Startup">
                	<Command commandecho="" commandstr="terminal length 0" delay="" messagesuffix="${LF}" prompt="" promptactionid="NA" promptecho="" readfromresponse="false" sequenceid="2" timeout=""/>
                	<Command commandecho="" commandstr="show startup-config" delay="" messagesuffix="${LF}" prompt="" promptactionid="yesActionId" promptecho="" readfromresponse="true" sequenceid="3" timeout="240000"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Raisecom Switch" personalityName="RaisecomSwitch">	
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Hardware Version" displayname="Hardware Version" name="HARDWARE_VERSION" sequenceid="1" size="50"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n\n^Current.*\n</Regex>
					<Regex>^Using.*out.*</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers>
				<SyslogState state="disable">
					<Regex>no logging on</Regex>
					<Regex>logging trap (emergencies|alerts|critical|errors|warnings)</Regex>
				</SyslogState>
				<SyslogState state="enable">
					<Regex>(logging $SYSLOG_SERVER_IP$)|(logging host $SYSLOG_SERVER_IP$)</Regex>
				</SyslogState>
			</SyslogStateCheckers>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="RaisecomSwitchHwPropParser.xml"> 
				
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_Raisecom_switch">
							<VALID-RULE>
							<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX EXPRESSION=".*(RaiseComOS)\s*Software\s*Version\s*(\S*)\(Compiled.*" NAME="OSVERSION">
										<PARAM NAME="OSTYPE" TOKENNO="1"/>
											<PARAM NAME="OSVERSION" TOKENNO="2"/>
										</REGEX>
										<REGEX EXPRESSION=".*Hardware\s*(\S*)\s*Version\s*(\S*).*" NAME="HARDWARE_VERSION">
											<PARAM NAME="HARDWARE_VERSION" TOKENNO="2"/>
										</REGEX>
										<REGEX EXPRESSION=".*Product\s*name\s*:\s*(\S*).*" NAME="MODEL">
											<PARAM NAME="MODEL" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*System\s*MacAddress.*:(\S*).*" NAME="MACADDRESS">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
										<!-- error message for command  -->
										<REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
											<PARAM NAME="ErrorMsg" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" messagesuffix="${LF}" parsercommandname="hardware_prop_Raisecom_switch" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" responseparserid="RaisecomSwitch_HW_Parser" timeout="20000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
