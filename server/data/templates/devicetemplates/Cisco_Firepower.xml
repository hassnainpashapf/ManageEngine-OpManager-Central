<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="Cisco Firepower" osType="FXOS" templateName="Cisco_Firepower">
	<RestTemplate name=""/>
	<Vendor displayName="Cisco" vendorName="Cisco">
		<Commands>
			<Command commandstr="show version"/>
			<Command commandstr="show interfaces"/>
			<Command commandstr="show access-lists"/>
			<Command commandstr="show logging"/>
			<Command commandstr="show ip traffic"/>
			<Command commandstr="show buffers"/>
			<Command commandstr="show hardware"/>
		</Commands>
		<LoggingLevels>
			<Level name="notifications" number="5" sequenceid="0"/>
			<Level name="informational" number="6" sequenceid="1"/>
			<Level name="debugging" number="7" sequenceid="2"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="startup">
                	<Command commandstr="terminal pager 0" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="20000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show startup-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="120000" promptactionid="yesActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="running">
                	<Command commandstr="terminal pager 0" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="20000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show running-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="120000" promptactionid="yesActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="Vlan">
                	<Command commandstr="terminal pager 0" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="2" timeout="20000" promptactionid="NA" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show vlan" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="3" timeout="20000" promptactionid="yesActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Cisco Firepower" personalityName="CiscoFirepower">	
		<Login enablecommand="enable" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt=">" prelogincommand="syst suppo diagnostic-cl"/>
		<PersonalityTable>
			<Columns>
				<Column name="MEMORY" size="150" desc="Memory" displayname="Memory" defaultvalue="Not Available" sequenceid="1"/>
				<Column name="CPU" size="150" desc="CPU" displayname="CPU" defaultvalue="Not Available" sequenceid="2"/>
				<Column name="UUID" size="150" desc="UUID" displayname="UUID" defaultvalue="Not Available" sequenceid="3"/>
				<Column name="VDB_VERSION" size="150" desc="VDB Version" displayname="VDB Version" defaultvalue="Not Available" sequenceid="4"/>
				<Column name="DRIVER_VERSION" size="150" desc="Driver Version" displayname="Driver Version" defaultvalue="Not Available" sequenceid="5"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n\n^Current.*\n</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="CiscoFPHwPropParser.xml"/>
			<Protocols>
				<Protocol>
					<Commands>
						<Command commandstr="show inventory" parsercommandname="hardware_prop_CiscoFirepower" responseparserid="CiscoFP_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="60000" promptactionid="yesActionId"/>
						<Command commandstr="show version" parsercommandname="hardware_prop_CiscoFirepower" responseparserid="CiscoFP_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="60000" promptactionid="yesActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
