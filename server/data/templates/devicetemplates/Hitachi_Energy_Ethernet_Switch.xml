<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="For Hitachi Energy Ethernet Switch" displayName="Hitachi Energy Ethernet Switch" osType="SWOPS" templateName="Hitachi Energy Ethernet Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Hitachi Energy" vendorName="HitachiEnergy">
		<Commands>
			<Command commandstr="show version"/>
			<Command commandstr="show hardware"/>
		</Commands>
		<LoggingLevels>
			<Level name="info" number="5" sequenceid="1"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="terminal length 0" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="hitachiActionId" promptecho="" readfromresponse="false" sequenceid="2" timeout="120000"/>
                	<Command commandecho="" commandstr="show running-config" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="hitachiActionId" promptecho="" readfromresponse="true" sequenceid="3" timeout="120000"/>
            	</Operation>
            	<Operation name="Startup">
                	<Command commandecho="" commandstr="terminal length 0" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="hitachiActionId" promptecho="" readfromresponse="false" sequenceid="2" timeout="120000"/>
                	<Command commandecho="" commandstr="show startup-config" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="hitachiActionId" promptecho="" readfromresponse="true" sequenceid="3" timeout="120000"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="Others">
            	<Operation name="Syncconfiguration">
                	<Command commandecho="" commandstr="write memory" delay="" messagesuffix="${LF}" prompt="" promptactionid="hitachiActionId" promptecho="" readfromresponse="" sequenceid="2" timeout=""/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
		<Protocol name="SSH/TELNET - TFTP">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="copy running-config tftp: //${UserInput:tftp_server_address}/${UserInput:file_name}" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="hitachiActionId" promptecho="" readfromresponse="" sequenceid="2" timeout="120000"/>
            	</Operation>
            	<Operation name="Startup">
                	<Command commandecho="" commandstr="copy startup-config tftp: //${UserInput:tftp_server_address}/${UserInput:file_name}" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="hitachiActionId" promptecho="" readfromresponse="" sequenceid="2" timeout="120000"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="Upload">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="copy tftp: //${UserInput:tftp_server_address}/${UserInput:file_name} running-config" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="hitachiActionId" promptecho="" readfromresponse="" sequenceid="2" timeout="120000"/>
            	</Operation>
            	<Operation name="Startup">
                	<Command commandecho="" commandstr="copy tftp: //${UserInput:tftp_server_address}/${UserInput:file_name} startup-config" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="hitachiActionId" promptecho="" readfromresponse="" sequenceid="2" timeout="120000"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="Others">
            	<Operation name="Syncconfiguration">
                	<Command commandecho="" commandstr="write memory" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="hitachiActionId" promptecho="" readfromresponse="" sequenceid="2" timeout="120000"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Hitachi Ethernet Switch" personalityName="HitachiEthernetSwitch">	
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Bootloader Version" displayname="Bootloader Version" name="BOOTLOADER_VERSION" sequenceid="1" size="100"/>
				<Column defaultvalue="Not Available" desc="Hardware Revision" displayname="Hardware Revision" name="HARDWARE_REVISION" sequenceid="2" size="100"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>				
				<Criteria type="deleteLine">
					<Regex>.*running-config.*\n\n\n^Configuration.*Checksum.*\n</Regex>
					<Regex>.*startup-config.*\n\n\n^Reading config.*\n\n^Configuration.*Checksum.*\n</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="HitachiEhSwitchHardwarePropParser.xml">
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_hitachi_ethernet_switch">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="OSTYPE" EXPRESSION=".*HITACHI.*Operating\s*System\s*\((\S*)\)\s*(\S*).*">
										  <PARAM NAME="OSTYPE" TOKENNO="1"/>
										  <PARAM NAME="OSVERSION" TOKENNO="2"/>
									  </REGEX>
										<REGEX NAME="BOOTLOADER_VERSION" EXPRESSION=".*Bootloader\s*(\S*),.*">
											<PARAM NAME="BOOTLOADER_VERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="HARDWARE_REVISION" EXPRESSION=".*Hardware\s*Revision\s*(\S*).*">
											<PARAM NAME="HARDWARE_REVISION" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MODEL" EXPRESSION=".*Device\s*type\s*(\S*).*">
											<PARAM NAME="MODEL" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="SERIALNUMBER" EXPRESSION=".*Serial\s*number\s*(.*)">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MACADDRESS" EXPRESSION=".*Main\s*board.*,\s*(\S*).*">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>							
										<REGEX NAME="MACADDRESS2" EXPRESSION=".*System\s*MAC\s*Address:\s*(.*)">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>				        
										</REGEX>
										<REGEX NAME="MODEL2" EXPRESSION=".*Apresia(\S*)\s*H\/W\s*:\s*(\S*).*">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="HW_VERSION" TOKENNO="2"/>
										</REGEX>              
										<REGEX NAME="BOOTLOADER_VERSION2" EXPRESSION=".*Boot\s*loader\s*:\s*(.*)">
											<PARAM NAME="BOOTLOADER_VERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="SERIES" EXPRESSION=".*Device\s*series\s*(\S*).*">
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<METADATA>
									<SCALAR>
										<REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
											<PARAM NAME="ErrorMsg" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" messagesuffix="${LF}" parsercommandname="hardware_prop_hitachi_ethernet_switch" prompt="${UserInput:EnablePrompt}" promptactionid="hitachiActionId" responseparserid="hitachi_ethernet_switch_hardware_prop_parser" timeout="20000"/>
						<Command commandstr="show hardware" messagesuffix="${LF}" parsercommandname="hardware_prop_hitachi_ethernet_switch" prompt="${UserInput:EnablePrompt}" promptactionid="hitachiActionId" responseparserid="hitachi_ethernet_switch_hardware_prop_parser" timeout="20000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
