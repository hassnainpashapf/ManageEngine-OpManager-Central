<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="Aruba Mobility Controller" osType="ArubaOS" templateName="Aruba_Mobility_Controller" multiConfigTemplate="false" category="Controller">
	<RestTemplate name=""/>
	<Vendor displayName="Aruba" vendorName="Aruba">
		<Commands/>
		<LoggingLevels>
			<Level name="Notice" number="5" sequenceid="0"/>
			<Level name="Informational" number="6" sequenceid="1"/>
			<Level name="Debug" number="7" sequenceid="2"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="Running">
                	<Command commandstr="no paging" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="20000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show configuration" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="20000" promptactionid="" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Aruba Mobility Controller Device" personalityName="ArubaMobilityControllerDevice">	
		<Login enablecommand="enable" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="CPBOOT" size="150" desc="" displayname="CPBoot" defaultvalue="Not Available" sequenceid="10"/>
				<Column name="BUILD" size="150" desc="" displayname="Build" defaultvalue="Not Available" sequenceid="20"/>
				<Column name="MEMORY" size="150" desc="" displayname="Memory Size" defaultvalue="Not Available" sequenceid="30"/>
				<Column name="FLASH" size="150" desc="" displayname="Flash Size" defaultvalue="Not Available" sequenceid="40"/>
				<Column name="CPUSERIAL" size="150" desc="" displayname="Cpu Serial No" defaultvalue="Not Available" sequenceid="50"/>
				<Column name="MACADDRESSES" size="150" desc="" displayname="MacAddresses" defaultvalue="Not Available" sequenceid="60"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="ArubaMControllerHwPropParser.xml">
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_aruba_mobility_controller">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="OSVERSION" EXPRESSION=".*(?i)MODEL\s*:\s*(\S+)\),\s*Version\s*(\S*).*">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIES" TOKENNO="1"/>
											<PARAM NAME="OSVERSION" TOKENNO="2"/>
										</REGEX>
										<REGEX NAME="CPBOOT" EXPRESSION=".*(?i)CPBoot\s*(\S+).*">
												<PARAM NAME="CPBOOT" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="BUILD" EXPRESSION=".*build\s*(\S*)\).*">
											<PARAM NAME="BUILD" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MEMORY" EXPRESSION="(?i)(\S+)\sbytes.*configuration\s*memory.*">
											<PARAM NAME="MEMORY" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="FLASH" EXPRESSION="(?i)(\S+)\sbytes.*flash.*">
											<PARAM NAME="FLASH" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*(?i)MAC\sAddr\s*:\s(\S+).*" NAME="MACADDRESS1">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*(?i)Model.*:\s*(\S+).*" NAME="MODEL2">
											<PARAM NAME="MODEL" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*(?i)System\sSerial.*:\s*(\S+).*Date.*" NAME="SERIALNUMBER">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*(?i)CPU.*Serial.*:\s*(\S+).*Date.*" NAME="CPUSERIAL">
											<PARAM NAME="CPUSERIAL" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*(?i)MAC\sAddr\s*:\s(\S+\sto\s\S+).*" NAME="MACADDRESSES">
											<PARAM NAME="MACADDRESSES" TOKENNO="1"/>
										</REGEX>

									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
										<!-- error message for command  -->
										<REGEX NAME="CmdError1" EXPRESSION=".*(Incomplete command).*">
											<PARAM NAME="ErrorMsg" TOKENNO="0" />
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" parsercommandname="hardware_prop_aruba_mobility_controller" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
						<Command commandstr="show inventory" parsercommandname="hardware_prop_aruba_mobility_controller" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
    <NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
