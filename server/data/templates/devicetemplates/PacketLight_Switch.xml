<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="For PacketLight switches" displayName="PacketLight Switch" osType="" templateName="PacketLight Switch">
	<RestTemplate name=""/>
	<Vendor displayName="PacketLight" vendorName="PacketLight">
		<Commands/>
		<LoggingLevels>
			<Level name="notifications" number="5" sequenceid="0"/>
			<Level name="informational" number="6" sequenceid="1"/>
			<Level name="debugging" number="7" sequenceid="2"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="show config" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="yesActionId" promptecho="" readfromresponse="true" sequenceid="2" timeout=""/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="PacketLight Switch" personalityName="PacketLightSwitch">	
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Model" displayname="Model" name="MODEL" sequenceid="1" size="50"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="PacketLightHardwarePropParser.xml">
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_packetlight_switch">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX EXPRESSION=".*Model:\s*(\S*).*" NAME="MODEL">
											<PARAM NAME="MODEL" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser> 
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show config" messagesuffix="${LF}" parsercommandname="hardware_prop_packetlight_switch" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" timeout="20000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
