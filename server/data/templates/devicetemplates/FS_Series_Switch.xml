<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="FS Series Switch" osType="FSOS" templateName="FS_Series_Switch">
	<RestTemplate name=""/>
	<Vendor displayName="FS" vendorName="FS">
		<Commands>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels/>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">		
		    <OperationGroup type="backup">
            	<Operation name="startup">
                	<Command commandstr="terminal length 0" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="20000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show startup-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="60000" promptactionid="" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>		
            	<Operation name="Running">				
                	<Command commandecho="" commandstr="terminal length 0" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="H3CSwitchActionId" promptecho="" readfromresponse="false" sequenceid="3" timeout="20000"/>
                	<Command commandecho="" commandstr="show running-config" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="H3CSwitchActionId" promptecho="" readfromresponse="true" sequenceid="4" timeout="60000"/>
            	</Operation>
           	</OperationGroup>
			<OperationGroup type="Others">
			   	<Operation name="syncconfiguration">
                	<Command commandstr="wr" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000" promptactionid="H3CSwitchActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            </OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="FS Series Switch" personalityName="FSSeriesSwitch">	
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Hardware Version" displayname="Hardware Version" name="HARDWAREVERSION" sequenceid="1" size="100"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n\n^Current.*\n</Regex>
					<Regex>^Using.*out.*</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="FSSeriesSwitchHwPropParser.xml">
				<MESSAGE-PARSER>
					<PARSER TYPE="rule1" CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser">
						<COMMAND NAME="hardware_prop_fs_switch">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="OSVERSION1" EXPRESSION=".*Series Software, Version (\S*).*">								
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="OSVERSION2" EXPRESSION="System software version\s*:\s*(.*)">								
											<PARAM NAME="OSVERSION" TOKENNO="1"/>										
										</REGEX>		
										<REGEX NAME="OSVERSION3" EXPRESSION=".*FSOS Software,\s*(\S*),\s*Version\s*(\S*).*">
											<PARAM NAME="SERIES" TOKENNO="1"/>
											<PARAM NAME="OSVERSION" TOKENNO="2"/>									
										</REGEX>
										<REGEX NAME="OSVERSION4" EXPRESSION=".*(?i)Software.*version\s*(\S+).*">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>
										 <REGEX NAME="SERIALNUMBER1" EXPRESSION=".*Serial num:(\S*),.*ID num:.*">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>								
										 <REGEX NAME="SERIALNUMBER2" EXPRESSION="System serial number\s*:\s*(\S*).*">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>						
										 <REGEX NAME="SERIALNUMBER3" EXPRESSION=".*System serial number is\s*(\S*).*">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MODEL1" EXPRESSION=".*(?i)System\s*description\s*:\s*FS.*\((\S+)\).*">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MODEL2" EXPRESSION=".*Slot\s*\S\s*:\s*(\S*).*">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>										
									    <REGEX NAME="MODEL3" EXPRESSION=".*Hardware Type is\s*(\S*).*">
											<PARAM NAME="MODEL" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="IMAGEFILENAME1" EXPRESSION=".*System image file is \s*(\S*).*">
											<PARAM NAME="IMAGEFILENAME" TOKENNO="1"/>
										</REGEX>	
										<REGEX NAME="IMAGEFILENAME2" EXPRESSION=".*current running image is\s*(\S*).*">
											<PARAM NAME="IMAGEFILENAME" TOKENNO="1"/>
										</REGEX>
									    <REGEX NAME="MACADDRESS1" EXPRESSION=".*Base ethernet MAC Address:\s*(\S*).*">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>	
										<REGEX NAME="MACADDRESS2" EXPRESSION=".*MAC Address.*:\s*(\S*).*">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>	  
										</REGEX>
										<REGEX NAME="HARDWAREVERSION" EXPRESSION=".*Hardware Version\s*:\s*(\S*).*">
											<PARAM NAME="HARDWAREVERSION" TOKENNO="1"/>	  
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX NAME="CmdError1" EXPRESSION=".*(Incomplete command).*">
										 <PARAM NAME="ErrorMsg" TOKENNO="0" />
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
						<COMMAND NAME="hardware_prop_fs_switch_mac">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX EXPRESSION="(.*)" NAME="MACADDRESS">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
										<!-- error message for command  -->
										<REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
											<PARAM NAME="ErrorMsg" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" messagesuffix="${LF}" parsercommandname="hardware_prop_fs_switch" prompt="${UserInput:EnablePrompt}" promptactionid="H3CSwitchActionId"  timeout="20000"/>
						<Command commandstr="show system" messagesuffix="${LF}" parsercommandname="hardware_prop_fs_switch" prompt="${UserInput:Prompt}" promptactionid="yesActionId" timeout="20000"/>
						<Command commandstr="show sysmac" messagesuffix="${LF}" parsercommandname="hardware_prop_fs_switch_mac" prompt="${UserInput:Prompt}" promptactionid="yesActionId" timeout="20000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
