    <NCMPersonality displayName="Cisco ASR1000 Router" personalityName="CiscoASR1000Router">	
		<Login enablecommand="enable" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="CPU" size="50" desc="Router CPU" displayname="CPU" defaultvalue="Not Available" sequenceid="1"/>
				<Column name="REVISION" size="100" desc="Revision Number" displayname="Revision" defaultvalue="Not Available" sequenceid="2"/>
				<Column name="DRAMSIZE" size="100" desc="Identifies the size of DRAM in KB" displayname="DRAM Size" defaultvalue="Not Available" sequenceid="3"/>
				<Column name="PROCESSORBOARDID" size="100" desc="Processor Board ID" displayname="Processor Board ID" defaultvalue="Not Available" sequenceid="4"/>
				<Column name="CONFIGREGISTER" size="50" desc="Config Register" displayname="Configuration Register" defaultvalue="Not Available" sequenceid="5"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Using.*out.*</Regex>
					<Regex>^Building.*\n\n^Current.*\n</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers>
				<SyslogState state="disable">
					<Regex>no logging on</Regex>
					<Regex>logging trap (emergencies|alerts|critical|errors|warnings)</Regex>
				</SyslogState>
				<SyslogState state="enable">
					<Regex>(logging $SYSLOG_SERVER_IP$)|(logging host $SYSLOG_SERVER_IP$)</Regex>
				</SyslogState>
			</SyslogStateCheckers>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="CiscoASR1000HwPropParser.xml"> 
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_cisco_asr_1000_router">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="SERIALNUMBER" EXPRESSION=".*(?i)PID\s*:\s*(\S+).*SN\s*:\s*(\S+).*">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIALNUMBER" TOKENNO="2"/>
										</REGEX>
										<REGEX NAME="SERIES1" EXPRESSION=".*cisco\s*(\S*)\s*\(\)\s*processor.*">
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="SERIES2" EXPRESSION=".*(?i)Cisco\s*(\S+)\s*Series.*">
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="SERIES3" EXPRESSION=".*(?i)DESCR\s*:\s*&quot;*(?:Cisco)\s*(\S+)\s*Series.*">
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="SERIES4" EXPRESSION=".*Cisco\s*IOS\s*Software.*,\s*(\S+)\s*Software.*,\s*Version\s*(\S*),.*">
											<PARAM NAME="SERIES" TOKENNO="1"/>
											<PARAM NAME="OSVERSION" TOKENNO="2"/>
										</REGEX>
										<REGEX EXPRESSION="Cisco\s*(.*)\s+Software,\s*Version\s*(\S*).*" NAME="OSVERSION">
											<PARAM NAME="OSTYPE" TOKENNO="1"/>
											<PARAM NAME="OSVERSION" TOKENNO="2"/>
										</REGEX>
										<REGEX EXPRESSION=".*Cisco\s*.*Software.*,\s*(.*)\s+Software.*" NAME="SERIES">
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										
										<REGEX EXPRESSION=".*System\simage\sfile\sis\s&quot;(.*)&quot;" NAME="IMAGEFILENAME">
											<PARAM NAME="IMAGEFILENAME" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*Processor\sboard\sID\s(\S*)" NAME="PROCESSORBOARDID">
											<PARAM NAME="PROCESSORBOARDID" TOKENNO="1"/>
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>

										<REGEX EXPRESSION=".*Configuration\sregister\sis\s(\S*)" NAME="CONFIGREGISTER">
											<PARAM NAME="CONFIGREGISTER" TOKENNO="1"/>
										</REGEX>

										<REGEX EXPRESSION="\s*cisco\s*(.*)\s(\S+)\sprocessor\s\(revision\s(\S+)\)\swith\s(\S+)\sbytes\sof\smem.*" NAME="MODEL">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="CPU" TOKENNO="2"/>
											<PARAM NAME="REVISION" TOKENNO="3"/>
											<PARAM NAME="DRAMSIZE" TOKENNO="4"/>
										</REGEX>

									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" parsercommandname="hardware_prop_cisco_asr_1000_router" responseparserid="cisco_asr_1000_router_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
						<Command commandstr="show inventory" parsercommandname="hardware_prop_cisco_asr_1000_router" responseparserid="cisco_asr_1000_router_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
