<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="For all MiMOMax-RRU-T devices" displayName="MiMOMax-RRU-T" osType="NA" templateName="MiMOMax-RRU-T">
	<RestTemplate name=""/>
	<Vendor displayName="MimoMax" vendorName="MimoMax">
		<Commands>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels/>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="show run all" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" promptecho="" readfromresponse="true" sequenceid="2" timeout="20000"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="MiMOMax GPS Tornado" personalityName="MiMOMaxGPSTornado">	
		<Login enablecommand="" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Serial Number of MiMOMax GPS Tornado" displayname="Serial Number" name="SERIAL_NUMBER" sequenceid="1" size="100"/>
				<Column defaultvalue="Not Available" desc="Hardware Revisoin of MiMOMax GPS Tornado" displayname="Hardware Revision" name="HARDWARE_REVISION" sequenceid="2" size="100"/>
				<Column defaultvalue="Not Available" desc="Checksum System of MiMOMax GPS Tornado" displayname="Checksum System" name="CHECKSUM_SYSTEM" sequenceid="3" size="100"/>
				<Column defaultvalue="Not Available" desc="Checksum data of MiMOMax GPS Tornado" displayname="Checksum Data" name="CHECKSUM_DATA" sequenceid="4" size="100"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n\n^Current.*\n</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="MiMOMaxGPSHardwarePropParser.xml"/> 
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" messagesuffix="${LF}" parsercommandname="hardware_prop_mimomax_gps_tornado" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" responseparserid="mimomax_gps_tornado_hardware_prop_parser" timeout="20000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
    <NCMDeviceSysOIDList>
        <NCMDeviceSysOID model="RRU-T" ostype="" series="RRU-T" sysoid=".1.3.6.1.4.1.31730.7"/>
    </NCMDeviceSysOIDList>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
