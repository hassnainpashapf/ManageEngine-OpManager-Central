<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="Dell EMC-S Series Switch" osType="NOS" templateName="Dell_EMC_S_Series_Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Dell" vendorName="Dell">
		<Commands>
			<Command commandstr="show version"/>
			<Command commandstr="show system"/>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels>
			<Level name="warning" number="5" sequenceid="0"/>
			<Level name="notification" number="6" sequenceid="1"/>
			<Level name="information" number="7" sequenceid="2"/>
			<Level name="debugging" number="8" sequenceid="3"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET - TFTP">
        	<OperationGroup type="backup">
            	<Operation name="startup">
                	<Command commandstr="copy startup-config tftp://${UserInput:tftp_server_address}/${UserInput:file_name}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="1" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="running">
                	<Command commandstr="copy running-config tftp://${UserInput:tftp_server_address}/${UserInput:file_name}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="1" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="upload">
            	<Operation name="startup">
                	<Command commandstr="copy tftp://${UserInput:tftp_server_address}/${UserInput:file_name} startup-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="1" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="running">
                	<Command commandstr="copy tftp://${UserInput:tftp_server_address}/${UserInput:file_name} running-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="1" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="others">
            	<Operation name="syncconfiguration">
                	<Command commandstr="write mem" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="changedetection">
            	<Operation name="enable">
                	<Command commandstr="config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="logging on" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="logging ${UserInput:HostIpAddress} severity ${UserInput:LoggingLevel}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="30" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="exit" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="40" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="disable">
                	<Command commandstr="config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="no logging ${UserInput:HostIpAddress}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="exit" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="30" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="startup">
                	<Command commandstr="terminal length 0" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="60000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show startup-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="20000" promptactionid="yesActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="running">
                	<Command commandstr="terminal length 0" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="60000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show running-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="20000" promptactionid="yesActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="others">
            	<Operation name="syncconfiguration">
                	<Command commandstr="write mem" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="changedetection">
            	<Operation name="enable">
                	<Command commandstr="config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="logging on" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="logging ${UserInput:HostIpAddress} severity ${UserInput:LoggingLevel}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="30" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="exit" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="40" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="disable">
                	<Command commandstr="config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="no logging ${UserInput:HostIpAddress}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="exit" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="30" timeout="30000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Dell EMC-S Series Switch" personalityName="DellEMCSSeriesSwitch">	
		<Login enablecommand="enable" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="SOFTWARE_VERSION" size="100" desc="Application Software Version" displayname="Software Version" defaultvalue="Not Available" sequenceid="1"/>
				<Column name="HARDWARE_REVISION" size="100" desc="Hardware Revision" displayname="Hardware Revision" defaultvalue="Not Available" sequenceid="2"/>
				<Column name="SERVICE_TAG" size="100" desc="Service Tag" displayname="Service Tag" defaultvalue="Not Available" sequenceid="3"/>
				<Column name="CONTROL_PROCESSOR" size="100" desc="Control Processor" displayname="Control Processor" defaultvalue="Not Available" sequenceid="4"/>
				<Column name="MEMORY" size="100" desc="Memory" displayname="Memory" defaultvalue="Not Available" sequenceid="5"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n\n^Current.*\n</Regex>
					<Regex>^Using.*out.*</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="DellEMCSSeriesSwitchHardwarePropParser.xml">
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
					<!-- To parse the output of show version command and get the hardware properties for Dell Switch -->
						<COMMAND NAME="hardware_prop_DellSSeries_Switch">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX EXPRESSION="(?i).*(Dell\s*\S+\s*OS\S+)\s*.*" NAME="OSTYPE">
											<PARAM NAME="OSTYPE" TOKENNO="1"/>
										</REGEX>

										<REGEX EXPRESSION="(?i).*OS\s*Version\s*:\s*(\S+).*" NAME="OSVERSION2">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
											<PARAM NAME="SOFTWARE_VERSION" TOKENNO="1"/>
										</REGEX>

										<REGEX EXPRESSION=".*(?i)System\s*Type\s*:\s*((\S+)-\S+).*" NAME="MODEL">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIES" TOKENNO="2"/>
										</REGEX>

									<REGEX EXPRESSION=".*Dell.*Application\s*Software\s*Version\s*:\s*(.*)" NAME="OSVERSION">
										<PARAM NAME="OSVERSION" TOKENNO="1"/>
										<PARAM NAME="SOFTWARE_VERSION" TOKENNO="1"/>
									</REGEX>

									<REGEX EXPRESSION=".*Software\s*Version\s*:\s*(.*)" NAME="SOFTWAREVERSION">
										<PARAM NAME="SOFTWARE_VERSION" TOKENNO="1"/>
										<PARAM NAME="OSVERSION" TOKENNO="1"/>
									</REGEX>

										<REGEX EXPRESSION=".*System image file is \&quot;(.*)\&quot;" NAME="IMAGEFILENAME">
											<PARAM NAME="IMAGEFILENAME" TOKENNO="1"/>
										</REGEX>

									<REGEX EXPRESSION=".*System Type\s*:\s*(\S*).*" NAME="MODEL">
										<PARAM NAME="MODEL" TOKENNO="1"/>
									</REGEX>

									<REGEX EXPRESSION=".*port\s*(.*)\s*\((\S*)\).*" NAME="SERIES">
										<PARAM NAME="SERIES" TOKENNO="1"/>
									</REGEX>
									
									<REGEX EXPRESSION=".*Control\s*Processor:(.*)\s*with\s*(.*)\s*of\s*memory,.*" NAME="CPU">
										<PARAM NAME="CONTROL_PROCESSOR" TOKENNO="1"/>
										<PARAM NAME="MEMORY" TOKENNO="2"/>
									</REGEX>
									<REGEX EXPRESSION=".*Hardware\s*Rev.*:\s*(\S*).*" NAME="HARDWARE_REVISION">
										<PARAM NAME="HARDWARE_REVISION" TOKENNO="1"/>
									</REGEX>
									<REGEX EXPRESSION=".*OS\s*Version\s*:\s*(\S*).*" NAME="OSVERSION1">
										<PARAM NAME="OSVERSION" TOKENNO="1"/>
										<PARAM NAME="SOFTWARE_VERSION" TOKENNO="1"/>
									</REGEX>
									<REGEX EXPRESSION=".*MAC\s*:\s*(.*)" NAME="MACADDRESS">
										<PARAM NAME="MACADDRESS" TOKENNO="1"/>
									</REGEX>
									<REGEX NAME="SERIALNUMBER" EXPRESSION=".*Serial [Nn]umber\s*:\s*(\S*).*">
									  <PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
									</REGEX>
									
									<REGEX NAME="SERVICE_TAG" EXPRESSION=".*[Ss]ervice\s*[Tt]ag\s*:\s*(.*)">
										<PARAM NAME="SERVICE_TAG" TOKENNO="1"/>
									</REGEX>
								</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" parsercommandname="hardware_prop_DellSSeries_Switch" responseparserid="Dell_EMC_S_Series_Switch_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
						<Command commandstr="show system" parsercommandname="hardware_prop_DellSSeries_Switch" responseparserid="Dell_EMC_S_Series_Switch_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
						<Command commandstr="show inventory" parsercommandname="hardware_prop_DellSSeries_Switch" responseparserid="Dell_EMC_S_Series_Switch_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
						<Command commandstr="show system id" parsercommandname="hardware_prop_DellSSeries_Switch" responseparserid="Dell_EMC_S_Series_Switch_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
