<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="Fibrolan Switch" osType="" templateName="Fibrolan_Switch" category="Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Fibrolan" vendorName="Fibrolan">
		<Commands>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels>
			<Level name="EMERGENCY" number="0" sequenceid="1"/>
			<Level name="ALERT" number="1" sequenceid="2"/>
			<Level name="CRITICAL" number="2" sequenceid="3"/>
			<Level name="ERROR" number="3" sequenceid="4"/>
			<Level name="WARNING" number="4" sequenceid="5"/>
			<Level name="NOTICE" number="5" sequenceid="6"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
		
		    <OperationGroup type="backup">
            			
            	<Operation name="Running">				
                	<Command commandecho="" commandstr="terminal length 0" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="NA" promptecho="" readfromresponse="false" sequenceid="3" timeout="20000"/>
                	<Command commandecho="" commandstr="show running-config" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="H3CSwitchActionId" promptecho="" readfromresponse="true" sequenceid="4" timeout="60000"/>
            	</Operation>
           	</OperationGroup>
			<OperationGroup type="Others">
			   	<Operation name="syncconfiguration">
                	<Command commandstr="copy running-config startup-config " messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000" promptactionid="HirschmannSwitchActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            </OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Fibrolan Switch" personalityName="FibrolanSwitch">	
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="HW revision" displayname="HW revision" name="HW_REV" sequenceid="1" size="100"/>

			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n\n^Current.*\n</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="FibrolanSwitchHwPropParser.xml">
				<MESSAGE-PARSER>
					<PARSER TYPE="rule1" CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser">
						<COMMAND NAME="hardware_prop_fibrolan_switch">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="SERIES" EXPRESSION=".*System Descr.*:\s*Fibrolan,\s*(\S*)-(\S*),\s*SW:\s*(\S*),\s*SN:\s*(\S*).*">								
											<PARAM NAME="SERIES" TOKENNO="1"/>	
											<PARAM NAME="MODEL" TOKENNO="2"/>
											<PARAM NAME="OSVERSION" TOKENNO="3"/>	
												<PARAM NAME="SERIALNUMBER" TOKENNO="4"/>											
										</REGEX>				

										
									   <REGEX NAME="MACADDRESS" EXPRESSION=".*MAC Address\s*:\s*(\S*).*">
												<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>
											
									   <REGEX NAME="HW_REV" EXPRESSION=".*HW\s*revision\s*:\s*(\S*).*">
												<PARAM NAME="HW_REV" TOKENNO="1"/>
										</REGEX>


									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX NAME="CmdError1" EXPRESSION=".*(Incomplete command).*">
										 <PARAM NAME="ErrorMsg" TOKENNO="0" />
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" messagesuffix="${LF}" parsercommandname="hardware_prop_fibrolan_switch" prompt="${UserInput:EnablePrompt}" promptactionid="H3CSwitchActionId" responseparserid="fibrolan_switch_hardware_prop_parser" timeout="20000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
