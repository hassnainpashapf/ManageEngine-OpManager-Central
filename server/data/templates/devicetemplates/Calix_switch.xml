        <NCMDeviceSysOID model="E5-110" ostype="AXOS" series="" sysoid=".1.3.6.1.4.1.6321.1.2.3.1"/>
        <NCMDeviceSysOID model="E5-111" ostype="AXOS" series="" sysoid=".1.3.6.1.4.1.6321.1.2.3.2"/>
        <NCMDeviceSysOID model="E5-120" ostype="AXOS" series="" sysoid=".1.3.6.1.4.1.6321.1.2.3.3"/>
        <NCMDeviceSysOID model="E5-121" ostype="AXOS" series="" sysoid=".1.3.6.1.4.1.6321.1.2.3.4"/>
        <NCMDeviceSysOID model="E3-12C" ostype="AXOS" series="" sysoid=".1.3.6.1.4.1.6321.1.2.3.5"/>
        <NCMDeviceSysOID model="E3-48" ostype="AXOS" series="" sysoid=".1.3.6.1.4.1.6321.1.2.3.6"/>
        <NCMDeviceSysOID model="E3-16F" ostype="AXOS" series="" sysoid=".1.3.6.1.4.1.6321.1.2.4.1.3"/>
        <NCMDeviceSysOID model="E5-16F" ostype="AXOS" series="" sysoid=".1.3.6.1.4.1.6321.1.2.4.1.4"/>
	</NCMDeviceSysOIDList>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
