<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="Calix Switch" osType="AXOS" templateName="Calix_Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Calix" vendorName="Calix">
		<Commands>
			<Command commandstr="show inventory"/>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels/>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="Backup">
            	<Operation name="Running">				
                	<Command commandecho="" commandstr="terminal screen-length 0" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="H3CSwitchActionId" promptecho="" readfromresponse="false" sequenceid="3" timeout="20000"/>
                	<Command commandecho="" commandstr="show running-config" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="H3CSwitchActionId" promptecho="" readfromresponse="true" sequenceid="4" timeout="60000"/>
            	</Operation>
            </OperationGroup>
        	<OperationGroup type="Others">
            	<Operation name="syncconfiguration">
                	<Command commandstr="copy running-config startup-config" messagesuffix="${LF}" prompt="${UserInput:Prompt}" sequenceid="10" timeout="30000" promptactionid="H3CSwitchActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Calix Switch" personalityName="CalixSwitch">	
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="FW Revision" displayname="FW Revision" name="FWREVISION" sequenceid="1" size="100"/>
			   
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n\n^Current.*\n</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="CalixSwitchHwPropParser.xml">
				<MESSAGE-PARSER>
					<PARSER TYPE="rule1" CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser">
						<COMMAND NAME="hardware_prop_calix_switch">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
									<REGEX NAME="OSVERSION" EXPRESSION=".*full-release-version.*AXOS\-(\S*).*">								
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>
								
										 <REGEX NAME="SERIALNUMBER" EXPRESSION=".*serial-number\s*(\S*).*">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>											
										</REGEX>
									    <REGEX NAME="SERIES" EXPRESSION=".*type\s*(\S*).*">
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MODEL" EXPRESSION=".*model-name\s*(\S*).* ">	
											<PARAM NAME="MODEL" TOKENNO="1"/>	
										</REGEX>
										<REGEX NAME="FWREVISION" EXPRESSION=".*fw-revision\s*(\S*).*">	
											<PARAM NAME="FWREVISION" TOKENNO="1"/>	
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX NAME="CmdError1" EXPRESSION=".*(Incomplete command).*">
										 <PARAM NAME="ErrorMsg" TOKENNO="0" />
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" messagesuffix="${LF}" parsercommandname="hardware_prop_calix_switch" prompt="${UserInput:Prompt}" promptactionid="H3CSwitchActionId" responseparserid="calix_switch_hardware_prop_parser" timeout="20000"/>
						<Command commandstr="show inventory" messagesuffix="${LF}" parsercommandname="hardware_prop_calix_switch" prompt="${UserInput:Prompt}" promptactionid="H3CSwitchActionId" responseparserid="calix_switch_hardware_prop_parser1" timeout="20000"/>
						
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList>
        <NCMDeviceSysOID model="E5-400" ostype="AXOS" series="" sysoid=".1.3.6.1.4.1.6321.1.2.2.5.2"/>
        <NCMDeviceSysOID model="E7-2" ostype="AXOS" series="" sysoid=".1.3.6.1.4.1.6321.1.2.2.5.3"/>
