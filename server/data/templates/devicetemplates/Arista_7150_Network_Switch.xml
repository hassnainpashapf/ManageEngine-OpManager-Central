<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="Arista 7150 Network Switch" displayName="Arista 7150 Network Switch" osType="[NA]" templateName="Arista_7150_Network_Switch">
	<RestTemplate/>
	<Vendor displayName="Arista" vendorName="Arista">
		<Commands>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels/>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="startup">
                	<Command commandstr="terminal length 0" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000"/>
                	<Command commandstr="show startup-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="30000" readfromresponse="true"/>
            	</Operation>
            	<Operation name="running">
                	<Command commandstr="terminal length 0" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000"/>
                	<Command commandstr="show running-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="30000" readfromresponse="true"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="others">
            	<Operation name="syncconfiguration">
                	<Command commandstr="write memory" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Arista 7150 Network Switch" personalityName="Arista7150NetworkSwitch">	
		<Login enablecommand="enable" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column name="HW_VERSION" size="150" desc="Hardware version " displayname="Hardware version" defaultvalue="Not Available" sequenceid="10"/>
				<Column name="BUILD_VERSION" size="150" desc="Internal build version" displayname="Internal build version" defaultvalue="Not Available" sequenceid="20"/>
				<Column name="ARCHITECTURE" size="150" desc="Internal build ID" displayname="Internal build ID" defaultvalue="Not Available" sequenceid="30"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="Arista7150NetworkSwitchHardwarePropParser.xml"/>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" parsercommandname="hardware_prop_arista_7150_network_switch" responseparserid="arista_7150_network_switch_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="30000"/>
						<Command commandstr="show inventory" parsercommandname="hardware_prop_arista_7150_network_switch" responseparserid="arista_7150_network_switch_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="30000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
