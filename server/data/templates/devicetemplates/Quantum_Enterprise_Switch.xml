<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="For Quantum Enterprise Switches" displayName="Quantum Enterprise Switch" osType="QNOS" templateName="Quantum_Enterprise_Switch" multiConfigTemplate="false" category="Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Quantum" vendorName="Quantum">
		<Commands>
			<Command commandstr="show version"/>
			<Command commandstr="show system"/>
			<Command commandstr="show hardware version"/>
		</Commands>
		<LoggingLevels>
			<Level name="notifications" number="5" sequenceid="1"/>
			<Level name="informational" number="6" sequenceid="3"/>
			<Level name="debugging" number="7" sequenceid="5"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="Startup">
                	<Command commandstr="terminal datadump" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="20000" promptactionid="NA" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show startup-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="15" timeout="280000" promptactionid="NA" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="Running">
                	<Command commandstr="terminal datadump" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="20000" promptactionid="NA" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show running-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="15" timeout="280000" promptactionid="NA" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
			<OperationGroup type="others">
            	<Operation name="Syncconfiguration">
                	<Command commandstr="write memory" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="2" timeout="240000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Quantum Enterprise Switch" personalityName="QuantumEnterpriseSwitch">	
		<Login enablecommand="enable" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="SOFTWARE_VERSION" size="50" desc="Software Version" displayname="Software Version" defaultvalue="Not Available" sequenceid="1"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n\n^Current.*\n</Regex>
					<Regex>^Using.*out.*</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="QuantumEnterpriseSwitchHardwarePropParser.xml">
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_quantum_enterprise_switch_system">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="SERIES" EXPRESSION=".*System Description:\s*QNOS\s*(\S*\s*\S*).*">  
											<PARAM NAME="SERIES" TOKENNO="1"/>	
											<PARAM NAME="MODEL" TOKENNO="1"/>	
										</REGEX>
										<REGEX NAME="OSVERSION" EXPRESSION=".*Software\s*Version\s*:\s*(\S*).*">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>	  
										</REGEX>
										<REGEX NAME="IMAGEFILENAME" EXPRESSION=".*Software\s*Image\s*File\s*:\s*\S*\s*(\S*).*">
											<PARAM NAME="IMAGEFILENAME" TOKENNO="1"/>	  
										</REGEX>										
										<REGEX NAME="HARDWAREVERSION" EXPRESSION=".*Hardware\s*Version\s*:\s*(\S*).*">
											<PARAM NAME="HARDWAREVERSION" TOKENNO="1"/>	  
										</REGEX>										
										<REGEX NAME="MACADDRESS" EXPRESSION=".*MAC Address:\s*(\S*).*">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>	  
										</REGEX>		
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
						<COMMAND NAME="hardware_prop_quantum_enterprise_switch_version">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="OSVERSION" EXPRESSION=".*Version:\s*(\S*).*">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>	  
											<PARAM NAME="SOFTWARE_VERSION" TOKENNO="1"/>	 
										</REGEX>
										<REGEX NAME="IMAGEFILENAME" EXPRESSION=".*Active-image:\s*(\S*).*">
											<PARAM NAME="IMAGEFILENAME" TOKENNO="1"/>	  
										</REGEX>		
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show system" parsercommandname="hardware_prop_quantum_enterprise_switch_system" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
						<Command commandstr="show version" parsercommandname="hardware_prop_quantum_enterprise_switch_version" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
