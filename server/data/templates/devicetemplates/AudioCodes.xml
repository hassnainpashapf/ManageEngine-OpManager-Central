                	<Command commandecho="" commandstr="exit" delay="" messagesuffix="${CRLF}" prompt="" promptactionid="NA" promptecho="" readfromresponse="" sequenceid="9" timeout=""/>
            	</Operation>
            	<Operation name="Disable">
                	<Command commandecho="" commandstr="configure troubleshoot" delay="" messagesuffix="${CRLF}" prompt="" promptactionid="NA" promptecho="" readfromresponse="" sequenceid="2" timeout=""/>
