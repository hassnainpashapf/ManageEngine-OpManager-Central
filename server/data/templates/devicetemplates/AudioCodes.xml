                	<Command commandecho="" commandstr="exit" delay="" messagesuffix="${CRLF}" prompt="" promptactionid="NA" promptecho="" readfromresponse="" sequenceid="7" timeout=""/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="AudioCodesMedia" personalityName="AudioCodesMedia">	
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${CRLF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Software Version" displayname="Software Version" name="SOFTWARE_VERSION" sequenceid="10" size="100"/>
				<Column defaultvalue="Not Available" desc="Hardware Version" displayname="Hardware Version" name="HARDWARE_VERSION" sequenceid="20" size="100"/>
				<Column defaultvalue="Not Available" desc="CPU" displayname="CPU" name="CPU" sequenceid="30" size="100"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers>
				<SyslogState state="enable">
					<Regex>syslog on</Regex>
					<Regex>syslog-ip $SYSLOG_SERVER_IP</Regex>
				</SyslogState>
			</SyslogStateCheckers>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="AudioCodesHardwarePropParser.xml"> 
				<MESSAGE-PARSER>
					<PARSER TYPE="rule1" CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser">
						<COMMAND NAME="hardware_prop_AudioCodes">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX EXPRESSION=".*Serial\s*Number\s*:\s*(\S*).*" NAME="SERIALNUMBER">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION="\s*;Software\s*Version\s*:\s*(.*)" NAME="SOFTWARE_VERSION">
											<PARAM NAME="SOFTWARE_VERSION" TOKENNO="1"/>
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*CPU\s*:\s*(.*)" NAME="CPU">
											<PARAM NAME="CPU" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*HardwareVersion\s*:\s*(.*)" NAME="HARDWARE_VERSION">
											<PARAM NAME="HARDWARE_VERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*Board\s*:\s*(.*)" NAME="MODEL">
											<PARAM NAME="MODEL" TOKENNO="1"/>
										</REGEX>								
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX NAME="CmdError1" EXPRESSION=".*(Incomplete command).*">
										 <PARAM NAME="ErrorMsg" TOKENNO="0" />
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show system version" parsercommandname="hardware_prop_AudioCodes" messagesuffix="${CRLF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
