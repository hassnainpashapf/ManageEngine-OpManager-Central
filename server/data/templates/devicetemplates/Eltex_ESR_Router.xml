<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="Eltex ESR Series Router" osType="Eltex ESR OS" templateName="Eltex_ESR_Series_Router" category="Router">
	<RestTemplate name=""/>
	<Vendor displayName="Eltex" vendorName="Eltex">
		<Commands>
			<Command commandstr="show system"/>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels>
			<Level name="informational" number="6" sequenceid="0"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
		
		    <OperationGroup type="backup">
            	<Operation name="startup">
                	<Command commandecho="false" commandstr="terminal datadump" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="NA" promptecho="true" readfromresponse="false" sequenceid="3" timeout="20000"/>
                	<Command commandecho="false" commandstr="show candidate-config" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="H3CSwitchActionId" promptecho="true" readfromresponse="true" sequenceid="4" timeout="60000"/>
            	</Operation>			
            	<Operation name="Running">				
                	<Command commandecho="false" commandstr="terminal datadump" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="NA" promptecho="true" readfromresponse="false" sequenceid="3" timeout="20000"/>
                	<Command commandecho="false" commandstr="show running-config" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="H3CSwitchActionId" promptecho="true" readfromresponse="true" sequenceid="4" timeout="60000"/>
            	</Operation>
           	</OperationGroup>
			<OperationGroup type="Others">
			   	<Operation name="syncconfiguration">
                	<Command commandstr="commit" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000" promptactionid="H3CSwitchActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
					<Command commandstr="confirm" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="30000" promptactionid="H3CSwitchActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            </OperationGroup>        	
			<OperationGroup type="changedetection">
            	<Operation name="enable">
                	<Command commandstr="configure terminal" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="3" timeout="40000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="logging on" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="4" timeout="40000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="logging host ${UserInput:HostIpAddress} severity ${UserInput:LoggingLevel}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="5" timeout="40000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="end" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="7" timeout="40000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="disable">
                	<Command commandstr="configure terminal" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="3" timeout="40000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="no logging ${UserInput:HostIpAddress}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="4" timeout="40000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="end" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="5" timeout="40000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Eltex Router" personalityName="EltexRouter">	
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="" displayname="Build" name="BUILD" sequenceid="5" size="100"/>
				<Column defaultvalue="Not Available" desc="" displayname="Software Version" name="SOFTWAREVERSION" sequenceid="10" size="100"/>
				<Column defaultvalue="Not Available" desc="" displayname="Hardware Version" name="HARDWAREVERSION" sequenceid="15" size="100"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n\n^Current.*\n</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers>
				<SyslogState state="enable">
					<Regex>logging host $SYSLOG_SERVER_IP</Regex>
				</SyslogState>
			</SyslogStateCheckers>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="EltexEsrRouterHwPropParser.xml">
				<MESSAGE-PARSER>
					<PARSER TYPE="rule1" CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser">
						<COMMAND NAME="hardware_prop_eltex_Router">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">								  								
										<REGEX NAME="OSVERSION" EXPRESSION=".*(?i)Software Version\s*:\s*((\S+) build \S+).*">
											<PARAM NAME="OSVERSION" TOKENNO="2"/>
											<PARAM NAME="SOFTWAREVERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="HARDWAREVERSION" EXPRESSION=".*(?i)Hardware Version\s*:\s*(\S+).*">
											<PARAM NAME="HARDWAREVERSION" TOKENNO="1"/>
										</REGEX>								  								
										<REGEX NAME="SERIES" EXPRESSION='.*(?i)System type\s*:\s*Eltex\s*(([\w]+)\S+).*'>								
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIES" TOKENNO="2"/>										
										</REGEX>																	  								
										<REGEX NAME="MACADDRESS" EXPRESSION=".*(?i)MAC Address\s*:\s*(\S*).*">
											<PARAM NAME="MACADRESS" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX NAME="CmdError1" EXPRESSION=".*(Incomplete command).*">
										 <PARAM NAME="ErrorMsg" TOKENNO="0" />
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show system" messagesuffix="${LF}" parsercommandname="hardware_prop_eltex_Router" prompt="${UserInput:EnablePrompt}" promptactionid="H3CSwitchActionId" timeout="20000"/>
						<Command commandstr="show version" messagesuffix="${LF}" parsercommandname="hardware_prop_eltex_Router" prompt="${UserInput:EnablePrompt}" promptactionid="H3CSwitchActionId" timeout="20000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
