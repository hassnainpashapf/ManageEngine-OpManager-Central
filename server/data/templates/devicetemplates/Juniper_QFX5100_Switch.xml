                	<Command commandstr="exit" messagesuffix="${LF}" prompt=">" sequenceid="40" timeout="20000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Juniper QFX5100 Switch" personalityName="JuniperQFX5100Switch">	
		<Login enablecommand="configure" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="MODEL" size="25" desc="This is to identify the Rom version" displayname="MODEL" defaultvalue="Not Available" sequenceid="10"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers>
				<SyslogState state="enable">
					<Regex>set system\s*syslog\s*host\s*$SYSLOG_SERVER_IP</Regex>
				</SyslogState>
			</SyslogStateCheckers>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="JuniperPropParser.xml"/> 
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="run show version | no-more" parsercommandname="hardware_prop_juniper_ex4200_switch" responseparserid="juniper_switch_hardware_prop_parser" messagesuffix="${LF}" prompt="#" timeout="20000" promptactionid="yesActionId"/>
					</Commands>
					<Commands operation="enterAdvancedMode">
						<Command commandstr="configure" parsercommandname="" responseparserid="juniper_switch_hardware_prop_parser" messagesuffix="${LF}" prompt="#" timeout="20000" promptactionid="yesActionId"/>
					</Commands>
					<Commands operation="exitAdvancedMode">
						<Command commandstr="quit" parsercommandname="" responseparserid="" messagesuffix="${LF}" prompt=">" timeout="60000" promptactionid=""/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
    <NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
