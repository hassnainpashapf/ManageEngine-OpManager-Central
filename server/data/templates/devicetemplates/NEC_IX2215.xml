<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="NEC IX2215" displayName="NEC IX2215" osType="NEC Portable Internwork Core OS" templateName="NEC_IX2215">
	<RestTemplate name=""/>
	<Vendor displayName="NEC" vendorName="NEC">
		<Commands>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels>
			<Level name="info" number="4" sequenceid="0"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="startup">
                	<Command commandstr="terminal length 0" messagesuffix="${CRLF}" prompt="${UserInput:Prompt}" sequenceid="20" timeout="90000" promptactionid="necActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show startup-config" messagesuffix="${CRLF}" prompt="${UserInput:Prompt}" sequenceid="30" timeout="90000" promptactionid="necActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="running">
                	<Command commandstr="terminal length 0" messagesuffix="${CRLF}" prompt="${UserInput:Prompt}" sequenceid="20" timeout="90000" promptactionid="necActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show running-config" messagesuffix="${CRLF}" prompt="${UserInput:Prompt}" sequenceid="30" timeout="90000" promptactionid="necActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="others">
            	<Operation name="syncconfiguration">
                	<Command commandstr="write memory" messagesuffix="${CRLF}" prompt="${UserInput:Prompt}" sequenceid="20" timeout="90000" promptactionid="necActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="NECIX2215" personalityName="NECIX2215">	
		<Login enablecommand="" suffix="${CRLF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="BOOTSTRAP_VER" size="100" desc="Bootstrap Version" displayname="Bootstrap Version" defaultvalue="Not Available" sequenceid="10"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="NECIX2215HardwarePropParser.xml"> 
			
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">

						<COMMAND NAME="hardware_prop_nec_ix2215">
							 <VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">

										<REGEX EXPRESSION=".*ROM:\s*System\s*Bootstrap,\s* Version\s*(\S*).*" NAME="BOOTSTRAP_VER">
											<PARAM NAME="BOOTSTRAP_VER" TOKENNO="1"/>
										</REGEX>

										<REGEX EXPRESSION=".*Series\s*(\S*).*Software.*Version\s*(\S*).*MAINTENANCE.*" NAME="OSVERSION">
											<PARAM NAME="SERIES" TOKENNO="1"/>
											<PARAM NAME="OSVERSION" TOKENNO="2"/>
										</REGEX>

										<REGEX EXPRESSION=".*System\s*image\s*file\s*is\s*(\S*).*" NAME="IMAGEFILENAME">
											<PARAM NAME="IMAGEFILENAME" TOKENNO="1"/>   
										</REGEX> 
										
										<REGEX EXPRESSION=".*S/N:\s*(\S*).*" NAME="SERIALNUMBER">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>    
										</REGEX> 

									</SCALAR>
								</METADATA>
							 </VALID-RULE>
							 <ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							 </ERROR-RULE>
						</COMMAND>

					</PARSER>

				</MESSAGE-PARSER>
			</HardwareParser>
			
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show hardware" parsercommandname="hardware_prop_nec_ix2215" responseparserid="nec_ix2215_hardware_prop_parser" messagesuffix="${CRLF}" prompt="${UserInput:Prompt}" timeout="20000" promptactionid="necActionId"/>
						<Command commandstr="Show version" parsercommandname="hardware_prop_nec_ix2215" responseparserid="nec_ix2215_hardware_prop_parser" messagesuffix="${CRLF}" prompt="${UserInput:Prompt}" timeout="20000" promptactionid="necActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
    <NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
