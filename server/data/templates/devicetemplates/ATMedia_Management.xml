<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="For ATMedia Management" displayName="ATMedia Management" osType="" templateName="ATMedia Management">
	<RestTemplate name=""/>
	<Vendor displayName="ATMedia" vendorName="ATMedia">
		<Commands/>
		<LoggingLevels/>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="show config" delay="" messagesuffix="${LF}" prompt="&gt;" promptactionid="NA" promptecho="" readfromresponse="true" sequenceid="2" timeout="120000"/>
            	</Operation>
            	<Operation name="Startup">
                	<Command commandecho="" commandstr="crypt enable" delay="" messagesuffix="${LF}" prompt="&gt;" promptactionid="NA" promptecho="" readfromresponse="false" sequenceid="3" timeout="20000"/>
                	<Command commandecho="" commandstr="show config" delay="" messagesuffix="${LF}" prompt="&gt;" promptactionid="NA" promptecho="" readfromresponse="true" sequenceid="4" timeout="120000"/>
                	<Command commandecho="" commandstr="exit" delay="" messagesuffix="${LF}" prompt="#" promptactionid="NA" promptecho="" readfromresponse="false" sequenceid="5" timeout="20000"/>                	
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="ATMedia Management" personalityName="ATMediaManagement">	
		<Login enablecommand="admin enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Interface" displayname="Interface" name="INTERFACE" sequenceid="10" size="100"/>
				<Column defaultvalue="Not Available" desc="Hardware" displayname="Hardware" name="HARDWARE" sequenceid="20" size="100"/>
				<Column defaultvalue="Not Available" desc="Engine" displayname="Engine" name="ENGINE" sequenceid="30" size="100"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="ATMediaInterfaceHwPropParser.xml">
				<MESSAGE-PARSER>
					<PARSER TYPE="rule1" CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser">
						<COMMAND NAME="hardware_prop_atmedia_interface">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="OSVERSION" EXPRESSION=".*system\s*(\S*).*">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="OSVERSION2" EXPRESSION=".*Version:\s*(\S*).*">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>
									   <REGEX NAME="INTERFACE" EXPRESSION=".*Interface\s*:\s*(\S*).*">
											<PARAM NAME="INTERFACE" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="SERIALNUMBER" EXPRESSION=".*Serialnumber\s*:\s*(\S*).*">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="ENGINE" EXPRESSION=".*Engine\s*:\s*(\S*).*">
											<PARAM NAME="ENGINE" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="HARDWARE" EXPRESSION=".*Hardware\s*:\s*(\S*).*">
											<PARAM NAME="HARDWARE" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX NAME="CmdError1" EXPRESSION=".*(Incomplete command).*">
										 <PARAM NAME="ErrorMsg" TOKENNO="0" />
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser> 
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" messagesuffix="${LF}" parsercommandname="hardware_prop_atmedia_interface" prompt="&gt;" promptactionid="yesActionId" timeout="120000"/>
						<Command commandstr="show hardware" messagesuffix="${LF}" parsercommandname="hardware_prop_atmedia_interface" prompt="&gt;" promptactionid="yesActionId" timeout="120000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
    <NCMDeviceSysOIDList>
        <NCMDeviceSysOID model="" ostype="" series="" sysoid=".1.3.6.1.4.1.13458.1.1"/>
    </NCMDeviceSysOIDList>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
