<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="Planet IGS" osType="PLANET OS" templateName="Planet_IGS" multiConfigTemplate="false" category="Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Planet" vendorName="Planet">
		<Commands>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels>
			<Level name="notifications" number="5" sequenceid="0"/>
			<Level name="informational" number="6" sequenceid="1"/>
			<Level name="debugging" number="7" sequenceid="2"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="Running">
                	<Command commandstr="show running-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="20000" promptactionid="yesActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="others">
            	<Operation name="Syncconfiguration">
                	<Command commandstr="copy running-config startup-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="20000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="PLANETOS" personalityName="PLANETOS">	
		<Login enablecommand="enable" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="SWVERSION" size="100" desc="Software Version" displayname="Software Version" defaultvalue="Not Available" sequenceid="10"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="PlanetOSHwPropParser.xml">
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_planetos_switch">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
									<REGEX NAME="MODEL" EXPRESSION=".*(?i)Product\s*:\s*PLANET,\s*((IGS\W+\d+)\w+).*">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIES" TOKENNO="2"/>
										</REGEX>
										<REGEX NAME="OSVERSION" EXPRESSION=".*(?i)Software\sVersion\s*:\s*(\S+).*">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
											<PARAM NAME="SWVERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MACADDRESS" EXPRESSION=".*(?i)MAC\sAddress\s*:\s*(\S+).*">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="SERIALNUMBER1" EXPRESSION=".*(?i)Serial\sNumber\s*:\s*(\S+).*">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							<!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									<!-- error message for command  -->
										<REGEX NAME="CmdError1" EXPRESSION=".*(Incomplete command).*">
											<PARAM NAME="ErrorMsg" TOKENNO="0" />
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" parsercommandname="hardware_prop_planetos_switch" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
