<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="Dell EMC Z Series SONIC" osType="SONIC" templateName="Dell_EMC_Z_Series_Sonic" multiConfigTemplate="false" category="Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Dell" vendorName="Dell">
		<Commands>
			<Command commandstr="show version"/>
			<Command commandstr="show platform syseeprom"/>
		</Commands>
		<LoggingLevels>
			<Level name="debugging" number="8" sequenceid="3"/>
			<Level name="information" number="7" sequenceid="2"/>
			<Level name="notification" number="6" sequenceid="1"/>
			<Level name="warning" number="5" sequenceid="0"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
			<OperationGroup type="backup">
				<Operation name="Running">
					<Command commandstr="show running-configuration | no-more" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="120000" promptactionid="yesActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
				</Operation>
			</OperationGroup>
			<OperationGroup type="Changedetection">
				<Operation name="Enable">
					<Command commandecho="" commandstr="logging server ${UserInput:HostIpAddress} remote-port 514 severity info protocol UDP message-type audit" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="NA" promptecho="" readfromresponse="" sequenceid="2" timeout="20000"/>
				</Operation>
				<Operation name="Disable">
					<Command commandecho="" commandstr="no logging server ${UserInput:HostIpAddress}" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="NA" promptecho="" readfromresponse="" sequenceid="2" timeout="20000"/>
				</Operation>
			</OperationGroup>
		</Protocol>
	</Protocols>
	<NCMPersonality displayName="Dell EMC ZSeries" personalityName="DellEMCZSeries">
		<Login enablecommand="sonic-cli" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="HARDWARE_VERSION" size="50" desc="HardWare Version" displayname="Hardware Version" defaultvalue="Not Available" sequenceid="20"/>
				<Column name="SERVICE_TAG" size="50" desc="Service Tag" displayname="Service Tag" defaultvalue="Not Available" sequenceid="30"/>
				<Column name="PLATFORM" size="50" desc="PLATFORM" displayname="PLATFORM" defaultvalue="Not Available" sequenceid="40"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers>
				<SyslogState state="enable">
					<Regex>logging server $SYSLOG_SERVER_IP.*</Regex>
				</SyslogState>
			</SyslogStateCheckers>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="DellPowerSwitchESeriesPropParser.xml">
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_dell_emc_z_series_one">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="SERIALNUMBER" EXPRESSION=".*Serial [Nn]umber\s*:\s*(\S*).*">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MACADDRESS" EXPRESSION="(?i)^.*base mac address\s*:\s*([0-9A-F:]+)$">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="HARDWARE_VERSION" EXPRESSION=".*[Hh]ardware [Vv]ersion\s*:\s*(\S*)">
											<PARAM NAME="HARDWARE_VERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="SERIES" EXPRESSION=".*[Pp]roduct [Nn]ame\s*:\s*((\w+)\S+)">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIES" TOKENNO="2"/>
										</REGEX>
										<REGEX NAME="SERVICE_TAG" EXPRESSION=".*[Ss]ervice\s*[Tt]ag\s*:\s*(.*)">
											<PARAM NAME="SERVICE_TAG" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
										<!-- error message for command -->
										<REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
											<PARAM NAME="ErrorMsg" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
						<COMMAND NAME="hardware_prop_dell_emc_z_series_two">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="OSVERSION" EXPRESSION=".*[Ss]oftware [Vv]ersion\s*:\s*([\d\.]+).*">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="PLATFORM" EXPRESSION=".*[Pp]latform\s*:\s*(\S+).*">
											<PARAM NAME="PLATFORM" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
										<!-- error message for command -->
										<REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
											<PARAM NAME="ErrorMsg" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show platform syseeprom" parsercommandname="hardware_prop_dell_emc_z_series_one" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
						<Command commandstr="show version" parsercommandname="hardware_prop_dell_emc_z_series_two" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
