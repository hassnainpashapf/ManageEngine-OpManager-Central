<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="For Siemens Scalance Switches" displayName="Siemens Scalance Switch" osType="[NA]" templateName="Siemens_Scalance_Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Siemens" vendorName="Siemens">
		<Commands/>
		<LoggingLevels/>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="show running-config" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="yesActionId" promptecho="" readfromresponse="true" sequenceid="2" timeout="30000"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="Others">
            	<Operation name="Syncconfiguration">
                	<Command commandecho="" commandstr="write startup-config" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="yesActionId" promptecho="" readfromresponse="" sequenceid="2" timeout=""/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
		<Protocol name="SSH/TELNET - TFTP">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="save filetype Config tftp ipv4 ${UserInput:tftp_server_address} file ${UserInput:file_name}" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="yesActionId" promptecho="" readfromresponse="" sequenceid="2" timeout=""/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="Upload">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="load tftp ipv4 ${UserInput:tftp_server_address} file ${UserInput:file_name} filetype Config" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="yesActionId" promptecho="" readfromresponse="" sequenceid="2" timeout=""/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="Others">
            	<Operation name="Syncconfiguration">
                	<Command commandecho="" commandstr="write startup-config" delay="" messagesuffix="${LF}" prompt="${UserInput:Prompt}" promptactionid="yesActionId" promptecho="" readfromresponse="" sequenceid="2" timeout=""/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Siemens Scalance Switch" personalityName="SiemensScalanceSwitch">	
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Hardware Revision" displayname="Hardware Revision" name="HARDWARE_REVISION" sequenceid="1" size="50"/>
				<Column defaultvalue="Not Available" desc="Firmware Version" displayname="Firmware Version" name="FIRMWARE_VERSION" sequenceid="1" size="50"/>
				<Column defaultvalue="Not Available" desc="Bootloader Version" displayname="Bootloader Version" name="BOOTLOADER_VERSION" sequenceid="1" size="50"/>
				<Column defaultvalue="Not Available" desc="Diagnostic Mode" displayname="Diagnostic Mode" name="DIAGNOSTIC_MODE" sequenceid="3" size="50"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="ScalanceHardwarePropParser.xml"> 
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_scalance">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">				
										<REGEX NAME="MACADDRESS" EXPRESSION=".*MAC\s*address\s*:\s*(.*)">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="SERIALNUMBER" EXPRESSION=".*Serial\s*Number\s*:\s*(.*)">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="DIAGNOSTIC_MODE" EXPRESSION=".*Diagnostics\s*Mode\s*:\s*(.*)">
											<PARAM NAME="DIAGNOSTIC_MODE" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="MODEL" EXPRESSION=".*Device\s*Type\s*:\s*(.*)">
											<PARAM NAME="MODEL" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="SERIES" EXPRESSION=".*Firmware\s*\|\s*SCALANCE\s*(\S*).*">
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="HARDWARE_REVISION" EXPRESSION=".*Basic\s*Device.*SCALANCE.*\|\s*(\S*)\s*\|.*">
											<PARAM NAME="HARDWARE_REVISION" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="FIRMWARE_VERSION" EXPRESSION=".*Firmware\s*\|\s*((\S*)).*">
											<PARAM NAME="FIRMWARE_VERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX NAME="BOOTLOADER_VERSION" EXPRESSION=".*Bootloader\s*\|\s*(\S*).*">
											<PARAM NAME="BOOTLOADER_VERSION" TOKENNO="1"/>
										</REGEX>	
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser> 
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show device information" messagesuffix="${LF}" parsercommandname="hardware_prop_scalance" prompt="${UserInput:Prompt}" promptactionid="yesActionId" timeout="120000"/>
						<Command commandstr="show versions" messagesuffix="${LF}" parsercommandname="hardware_prop_scalance" prompt="${UserInput:Prompt}" promptactionid="yesActionId" timeout="120000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
