<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="Cisco Prime" osType="ADE-OS" templateName="Cisco_Prime">
	<RestTemplate name=""/>
	<Vendor displayName="Cisco" vendorName="Cisco">
		<Commands>
			<Command commandstr="show interfaces"/>
			<Command commandstr="show access-lists"/>
			<Command commandstr="show logging"/>
			<Command commandstr="show ip traffic"/>
			<Command commandstr="show buffers"/>
			<Command commandstr="show hardware"/>
			<Command commandstr="show version"/>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels>
			<Level name="notifications" number="5" sequenceid="0"/>
			<Level name="informational" number="6" sequenceid="1"/>
			<Level name="debugging" number="7" sequenceid="2"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="terminal length 0" delay="" messagesuffix="${LF}" prompt="" promptactionid="yesActionId" promptecho="" readfromresponse="false" sequenceid="2" timeout=""/>
                	<Command commandecho="" commandstr="show running-config" delay="" messagesuffix="${LF}" prompt="" promptactionid="yesActionId" promptecho="" readfromresponse="true" sequenceid="3" timeout=""/>
            	</Operation>
            	<Operation name="Startup">
                	<Command commandecho="" commandstr="terminal length 0" delay="" messagesuffix="${LF}" prompt="" promptactionid="yesActionId" promptecho="" readfromresponse="false" sequenceid="2" timeout=""/>
                	<Command commandecho="" commandstr="show startup-config" delay="" messagesuffix="${LF}" prompt="" promptactionid="yesActionId" promptecho="" readfromresponse="true" sequenceid="3" timeout=""/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Cisco Prime" personalityName="CiscoPrime">	
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Software Version" displayname="Software Version" name="SOFTWARE_VERSION" sequenceid="1" size="100"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="CiscoPrimeHardwarePropParser.xml"> 
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_cisco_prime">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX EXPRESSION="\s*(\S*)\s*Build\s*Version\s*:\s*(\S*).*" NAME="OSTYPE">
											<PARAM NAME="OSTYPE" TOKENNO="1"/>
											<PARAM NAME="OSVERSION" TOKENNO="2"/>
										</REGEX>
										<REGEX EXPRESSION="\s*Version\s*:\s*(\S*).*" NAME="SOFTWARE_VERSION">
											<PARAM NAME="SOFTWARE_VERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION='.*DESCR\s*:\s*\"(\S*)\s*[Cc]hassis\".*' NAME="MODEL">
											<PARAM NAME="MODEL" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION="\s*PID\s*:\s*(\S*).*SN\s*:\s*(\S*).*" NAME="SERIALNUMBER">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIALNUMBER" TOKENNO="2"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
										<!-- error message for command  -->
										<REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
											<PARAM NAME="ErrorMsg" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" messagesuffix="${LF}" parsercommandname="hardware_prop_cisco_prime" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" responseparserid="cisco_prime_hardware_prop_parser" timeout="120000"/>
						<Command commandstr="show inventory" messagesuffix="${LF}" parsercommandname="hardware_prop_cisco_prime" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" responseparserid="cisco_prime_hardware_prop_parser" timeout="120000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList>		
        <NCMDeviceSysOID model="PCM" ostype="[NA]" series="[NA]" sysoid=".1.3.6.1.4.1.9.1.1422"/>
        <NCMDeviceSysOID model="NAM-2320" ostype="[NA]" series="NAM 2300" sysoid=".1.3.6.1.4.1.9.1.1528"/>
        <NCMDeviceSysOID model="NAM-ESX" ostype="[NA]" series="[NA]" sysoid=".1.3.6.1.4.1.9.1.1876"/>
        <NCMDeviceSysOID model="NAM-KVM" ostype="[NA]" series="[NA]" sysoid=".1.3.6.1.4.1.9.1.1877"/>
        <NCMDeviceSysOID model="NAM-2420" ostype="[NA]" series="NAM 2400" sysoid=".1.3.6.1.4.1.9.1.2282"/>
        <NCMDeviceSysOID model="NAM-2440" ostype="[NA]" series="NAM 2400" sysoid=".1.3.6.1.4.1.9.1.2283"/>
        <NCMDeviceSysOID model="[NA]" ostype="[NA]" series="[NA]" sysoid=".1.3.6.1.4.1.9.1.2307"/>
	</NCMDeviceSysOIDList>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
