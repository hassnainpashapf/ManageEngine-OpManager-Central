<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="NEC PF5220F Switch" displayName="NEC PF5220F Switch" osType="NA" templateName="NEC_PF5220F_Switch">
	<RestTemplate name=""/>
	<Vendor displayName="NEC" vendorName="NEC">
		<Commands>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels>
			<Level name="info" number="4" sequenceid="0"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="startup">
                	<Command commandstr="screen length disable" messagesuffix="${CRLF}" prompt="${UserInput:Prompt}" sequenceid="20" timeout="90000" promptactionid="necActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="display saved-configuration" messagesuffix="${CRLF}" prompt="${UserInput:Prompt}" sequenceid="30" timeout="90000" promptactionid="necActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="running">
                	<Command commandstr="screen length disable" messagesuffix="${CRLF}" prompt="${UserInput:Prompt}" sequenceid="20" timeout="90000" promptactionid="necActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="display current-configuration" messagesuffix="${CRLF}" prompt="${UserInput:Prompt}" sequenceid="30" timeout="90000" promptactionid="necActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="others">
            	<Operation name="syncconfiguration">
                	<Command commandstr="save" messagesuffix="${CRLF}" prompt="${UserInput:Prompt}" sequenceid="20" timeout="90000" promptactionid="necActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="NEC PF5220F Switch" personalityName="NECPF5220FSwitch">	
		<Login enablecommand="enable" suffix="${CRLF}"/>
		<PersonalityTable>
			<Columns>
				<Column name="SOFTWARE" size="100" desc="Software" displayname="Software" defaultvalue="Not Available" sequenceid="10"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="NECPF5220FSwitchHardwarePropParser.xml"> 
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">

						<COMMAND NAME="hardware_prop_nec_pf5220f">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX EXPRESSION=".*Model:\s*(\S*)" NAME="MODEL">
											<PARAM NAME="MODEL" TOKENNO="1"/>   
										</REGEX> 
										<REGEX EXPRESSION=".*SOFTWARE:\s*(\S*) Ver.\s*(\S*)" NAME="SOFTWARE">
											<PARAM NAME="SOFTWARE" TOKENNO="1"/> 
											<PARAM NAME="OSVERSION" TOKENNO="2"/>
										</REGEX> 
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>

					</PARSER>

				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol>
					<Commands>
						<Command commandstr="show version" parsercommandname="hardware_prop_nec_pf5220f" responseparserid="nec_pf5220f_hardware_prop_parser" messagesuffix="${CRLF}" prompt="${UserInput:Prompt}" timeout="20000" promptactionid="necActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
    <NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
