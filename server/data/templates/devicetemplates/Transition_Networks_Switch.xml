<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="For Transition Network Switch devices" displayName="Transition Networks Switch" osType="[NA]" templateName="Transition_Networks_Switch">
	<RestTemplate name=""/>
	<Vendor displayName="TransitionNetworks" vendorName="TransitionNetworks">
		<Commands/>
		<LoggingLevels/>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="System Configuration all" delay="" messagesuffix="${CRLF}" prompt="${UserInput:EnablePrompt}" promptactionid="NA" promptecho="" readfromresponse="true" sequenceid="2" timeout="20000"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
		<Protocol name="SSH/TELNET - TFTP">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="Config Save ${UserInput:tftp_server_address} ${UserInput:file_name}" delay="" messagesuffix="${CRLF}" prompt="" promptactionid="NA" promptecho="" readfromresponse="" sequenceid="2" timeout=""/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="Upload">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="Config Load ${UserInput:tftp_server_address} ${UserInput:file_name}" delay="" messagesuffix="${CRLF}" prompt="" promptactionid="NA" promptecho="" readfromresponse="" sequenceid="2" timeout=""/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Transition Network Switch" personalityName="TransitionNetworkSwitch">	
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${CRLF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Kernel version of the switch" displayname="Kernel Version" name="KERNELVERSION" sequenceid="1" size="100"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines/>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="TransitionNetworkSwitchPropParser.xml">
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_transition_network_switch">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="OSVERSION" EXPRESSION=".*Version\s*:\s*Kernel\s*(\S*)\s*Software\s*(\S*).*">
											<PARAM NAME="KERNELVERSION" TOKENNO="1"/>
											<PARAM NAME="OSVERSION" TOKENNO="2"/>	  
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>			
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="System Version" messagesuffix="${CRLF}" parsercommandname="hardware_prop_transition_network_switch" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" timeout="20000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
