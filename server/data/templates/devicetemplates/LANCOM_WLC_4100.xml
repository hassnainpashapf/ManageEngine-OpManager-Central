<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="LANCOM WLC 4100" osType="LCOS" templateName="LANCOM_WLC_4100">
	<RestTemplate name=""/>
	<Vendor displayName="LANCOM" vendorName="LANCOM">
		<Commands>
			<Command commandstr="show version"/>
			<Command commandstr="show interfaces"/>
			<Command commandstr="show access-lists"/>
			<Command commandstr="show logging"/>
			<Command commandstr="show ip traffic"/>
			<Command commandstr="show buffers"/>
			<Command commandstr="show hardware"/>
		</Commands>
		<LoggingLevels>
			<Level name="notifications" number="5" sequenceid="1"/>
			<Level name="informational" number="6" sequenceid="2"/>
			<Level name="debugging" number="7" sequenceid="3"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="running">
                	<Command commandstr="readconfig" messagesuffix="${LF}" prompt="${UserInput:Prompt}" sequenceid="10" timeout="60000" promptactionid="yesActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="LANCOM WLC 4100" personalityName="LANCOMWLC4100">	
		<Login enablecommand="" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="VERSION_GIT" size="150" desc="Version-GIT" displayname="Version-GIT" defaultvalue="Not Available" sequenceid="1"/>
				<Column name="HARDWARE_RELEASE" size="150" desc="Hardware Release" displayname="Hardware Release" defaultvalue="Not Available" sequenceid="2"/>
				<Column name="HARDWARE_ID" size="150" desc="Hardware ID" displayname="Hardware ID" defaultvalue="Not Available" sequenceid="3"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Using.*out.*</Regex>
					<Regex>^Building.*\n\n^Current.*\n</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="LanComWLC4100PropParser.xml">
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="lancom_wlc_hardware_prop">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX EXPRESSION=".*VERSION\s*:\s*(\S*).*" NAME="OSVERSION">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*VERSION-GIT\s*:\s*(.*)" NAME="VERSION_GIT">
											<PARAM NAME="VERSION_GIT" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*HW-RELEASE\s*:\s*(.*)" NAME="HARDWARE_RELEASE">
											<PARAM NAME="HARDWARE_RELEASE" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*HW-ID\s*:\s*(.*)" NAME="HARDWARE_ID">
											<PARAM NAME="HARDWARE_ID" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*NAME\s*:\s*(.*)" NAME="MODEL">
											<PARAM NAME="MODEL" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*SERIAL-NUMBER\s*:\s*(.*)" NAME="SERIALNUMBER">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*MAC-ADDRESS\s*:\s*(.*)" NAME="MACADDRESS">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
										<!-- error message for command  -->
										<REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
											<PARAM NAME="ErrorMsg" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="sysinfo" parsercommandname="lancom_wlc_hardware_prop" responseparserid="LANCOMWLC4100_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:Prompt}" timeout="30000" promptactionid="yesActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
