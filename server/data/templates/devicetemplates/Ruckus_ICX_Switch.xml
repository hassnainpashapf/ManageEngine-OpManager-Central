<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="Ruckus ICX Switch" osType="FastIron" templateName="Ruckus_ICX_Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Ruckus" vendorName="Ruckus">
		<Commands>
			<Command commandstr="show version"/>
			<Command commandstr="show system"/>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels>
			<Level name="warning" number="5" sequenceid="1"/>
			<Level name="notification" number="6" sequenceid="2"/>
			<Level name="information" number="7" sequenceid="3"/>
			<Level name="debugging" number="8" sequenceid="4"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="running">
                	<Command commandstr="skip-page-display" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000" promptactionid="BrocadeActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr=" show running-config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="1200000" promptactionid="BrocadeActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="others">
            	<Operation name="syncconfiguration">
                	<Command commandstr="write memory" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="1" timeout="30000" promptactionid="BrocadeActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
		<Protocol name="SSH/TELNET - TFTP">
			<OperationGroup type="backup">
				<Operation name="Startup">
					<Command commandstr="copy startup-config tftp ${UserInput:tftp_server_address} ${UserInput:file_name}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="2" timeout="240000" promptactionid="BrocadeActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
				</Operation>
				<Operation name="Running">
					<Command commandstr="copy running-config tftp ${UserInput:tftp_server_address} ${UserInput:file_name}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="2" timeout="1200000" promptactionid="BrocadeActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
				</Operation>
			</OperationGroup>
			<OperationGroup type="upload">
				<Operation name="Startup">
					<Command commandstr="copy tftp startup-config ${UserInput:tftp_server_address} ${UserInput:file_name}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="2" timeout="240000" promptactionid="BrocadeActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
				</Operation>
				<Operation name="Running">
					<Command commandstr="copy tftp running-config ${UserInput:tftp_server_address} ${UserInput:file_name}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="2" timeout="240000" promptactionid="BrocadeActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
				</Operation>
			</OperationGroup>
			<OperationGroup type="others">
				<Operation name="Syncconfiguration">
					<Command commandstr="write memory" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="1" timeout="30000" promptactionid="BrocadeActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
				</Operation>
			</OperationGroup>
		</Protocol>
	</Protocols>
    <NCMPersonality displayName="Ruckus ICX Switch" personalityName="RuckusICXSwitch">	
		<Login enablecommand="enable" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="SOFTWARE_VERSION" size="150" desc="Software Version" displayname="Software Version" defaultvalue="Not Available" sequenceid="1"/>
				<Column name="PROCESSOR" size="150" desc="Processor" displayname="Processor" defaultvalue="Not Available" sequenceid="2"/>
				<Column name="CODE_FLASH" size="150" desc="Code Flash Memory" displayname="Code Flash Memory" defaultvalue="Not Available" sequenceid="3"/>
				<Column name="BOOT_FLASH" size="150" desc="Boot Flash Memory" displayname="Boot Flash Memory" defaultvalue="Not Available" sequenceid="4"/>
				<Column name="DRAM" size="150" desc="DRAM Size" displayname="DRAM Size" defaultvalue="Not Available" sequenceid="5"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="RuckusICXSwitchHwPropParser.xml">
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_rukus_icx">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="IMAGEFILENAME" EXPRESSION=".*Primary\s*(.*)">
										  <PARAM NAME="IMAGEFILENAME" TOKENNO="1"/>
									  </REGEX>
										<REGEX NAME="SERIALNUMBER" EXPRESSION="\s*Serial\s*#:\s*(.*)">
										  <PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
									  </REGEX>
										<REGEX EXPRESSION=".*SW:\s*Version\s*(.*)" NAME="SOFTWARE_VERSION">
											<PARAM NAME="SOFTWARE_VERSION" TOKENNO="1"/>
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*HW\s*:\s*Stackable\s*(([^-]*).*)" NAME="MODEL">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIES" TOKENNO="2"/>
										</REGEX>
										<REGEX EXPRESSION="\s*(.*)\s*code flash memory.*" NAME="CODE_FLASH">
											<PARAM NAME="CODE_FLASH" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION="(.*processor.*)" NAME="PROCESSOR">
											<PARAM NAME="PROCESSOR" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION="\s*(.*)\s*DRAM.*" NAME="DRAM">
											<PARAM NAME="DRAM" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION="\s*(.*)\s*boot flash memory.*" NAME="BOOT_FLASH">
											<PARAM NAME="BOOT_FLASH" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
										<!-- error message for command  -->
										<REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
											<PARAM NAME="ErrorMsg" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" parsercommandname="hardware_prop_rukus_icx" responseparserid="ruckus_icx_hw_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="30000" promptactionid=""/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
    <NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
