<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="Opengear IM Console Server" displayName="Opengear IM Console Server" osType="Opengear" templateName="Opengear IM Console Server">
	<RestTemplate name=""/>
	<Vendor displayName="Opengear" vendorName="Opengear">
		<Commands>
			<Command commandstr="showserial"/>
		</Commands>
		<LoggingLevels>
			<Level name="notifications" number="5" sequenceid="0"/>
			<Level name="informational" number="6" sequenceid="1"/>
			<Level name="debugging" number="7" sequenceid="2"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="config -e /tmp/config.opg" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" promptecho="" readfromresponse="false" sequenceid="2" timeout="120000"/>
                	<Command commandecho="" commandstr="cat /tmp/config.opg" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" promptecho="" readfromresponse="true" sequenceid="3" timeout="120000"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="Others">
            	<Operation name="Syncconfiguration">
                	<Command commandecho="" commandstr="config -a" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" promptecho="" readfromresponse="" sequenceid="2" timeout="120000"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
		<Protocol name="SSH - SCP">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="config -e /tmp/config.opg" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" promptecho="" readfromresponse="" sequenceid="2" timeout="120000"/>
                	<Command commandecho="" commandstr="scp /tmp/config.opg ${UserInput:scp_username}@${UserInput:scp_server_address}:/${UserInput:file_name}" delay="" messagesuffix="${LF}" prompt=":" promptactionid="yesActionId" promptecho="" readfromresponse="" sequenceid="3" timeout="30000"/>
                	<Command commandecho="" commandstr="${UserInput:scp_password}" delay="" messagesuffix="${LF}" prompt="" promptactionid="NA" promptecho="" readfromresponse="" sequenceid="4" timeout="120000"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="Others">
            	<Operation name="Syncconfiguration">
                	<Command commandecho="" commandstr="config -a" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" promptecho="" readfromresponse="" sequenceid="2" timeout="30000"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Opengear Console Server" personalityName="OpengearConsoleServer">	
		<Login suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column name="VERSION" size="150" desc="Version" displayname="Version" defaultvalue="Not Available" sequenceid="10"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^(\s*)Done</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="OpengearHardwareParser.xml">
				<MESSAGE-PARSER>
					<PARSER TYPE="rule1" CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser">
						<COMMAND NAME="hardware_prop_opengear_console_server">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">

										<REGEX EXPRESSION=".*(?i)model_name\s*=\s*\&quot;(\S+)\&quot;.*" NAME="MODEL1">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*(?i)system_versions\.firmware_version\s*=\s*\&quot;(\S+)\&quot;.*" NAME="OSVERSION1">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
											<PARAM NAME="VERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*(?i)serial_number\s*=\s*\&quot;(\S+)\&quot;.*" NAME="SERIALNUMBER1">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
										<!-- error message for command  -->
										<REGEX NAME="CmdError1" EXPRESSION=".*(Incomplete command).*">
											<PARAM NAME="ErrorMsg" TOKENNO="0" />
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
						<COMMAND NAME="hardware_prop_opengear_console_server_serialnumber">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX NAME="SERIALNUMBER" EXPRESSION="(\S*).*">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								<!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
										<!-- error message for command  -->
										<REGEX NAME="CmdError1" EXPRESSION=".*(Incomplete command).*">
											<PARAM NAME="ErrorMsg" TOKENNO="0" />
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>  
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="cat /etc/version" parsercommandname="hardware_prop_opengear_console_server" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
						<Command commandstr="showserial" parsercommandname="hardware_prop_opengear_console_server_serialnumber" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
						<Command commandstr="ogcli get system/info" parsercommandname="hardware_prop_opengear_console_server" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="20000" promptactionid="yesActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
    <NCMDeviceSysOIDList>
        <NCMDeviceSysOID model="" ostype="" series="IM42XX" sysoid=".1.3.6.1.4.1.25049.1.60"/>
        <NCMDeviceSysOID model="" ostype="" series="IM72XX" sysoid=".1.3.6.1.4.1.25049.1.61"/>
    </NCMDeviceSysOIDList>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
