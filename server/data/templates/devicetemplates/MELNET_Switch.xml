<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="" displayName="MELNET Switch" osType="NA" templateName="MELNET_Switch">
	<RestTemplate name=""/>
	<Vendor displayName="MELNET" vendorName="MELNET">
		<Commands>
			<Command commandstr="show system/information"/>
		</Commands>
		<LoggingLevels/>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="running">
                	<Command commandstr="dump" messagesuffix="${LF}" prompt="${UserInput:Prompt}" sequenceid="10" timeout="320000" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="MELNET Switch" personalityName="MELNETSwitch">	
		<Login suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column name="SOFTWAREPRODUCTREVISION" size="50" desc="SOFTWARE PRODUCT REVISION" displayname="Software Product Revision" defaultvalue="Not Available" sequenceid="10"/>
				<Column name="HARDWAREREVISION" size="50" desc="HARDWARE REVISION" displayname="Hardware Revision" defaultvalue="Not Available" sequenceid="20"/>
				<Column name="SYSTEMUPTIME" size="50" desc="SYSTEM UPTIME" displayname="System Uptime" defaultvalue="Not Available" sequenceid="30"/>
				<Column name="SYSTEMLOCATION" size="250" desc="SYSTEM LOCATION" displayname="System Location" defaultvalue="Not Available" sequenceid="40"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers/>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="MelnetHardwarePropParser.xml"> 
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_avocent_acs">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">
										<REGEX EXPRESSION="\s*S/W Product Revision\s*:\s*(.*)" NAME="SOFTWAREPRODUCTREVISION">
											<PARAM NAME="SOFTWAREPRODUCTREVISION" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION="\s*H/W Revision\s*:\s*(.*)" NAME="HARDWAREREVISION">
											<PARAM NAME="HARDWAREREVISION" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION="\s*Product S/N\s*:\s*(.*)" NAME="PRODUCTSERIALNUMBER">
											<PARAM NAME="PRODUCTSERIALNUMBER" TOKENNO="1"/>
										</REGEX> 
										<REGEX EXPRESSION="\s*MAC Address\s*:\s*(.*)" NAME="MACADDRESS">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>
										
										<REGEX EXPRESSION="\s*System Uptime\s*:\s*(.*)" NAME="SYSTEMUPTIME">
											<PARAM NAME="SYSTEMUPTIME" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION="\s*System Location\s*:\s*(.*)" NAME="SYSTEMLOCATION">
											<PARAM NAME="SYSTEMLOCATION" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
								 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
										 <!-- error message for command  -->
										<REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
											<PARAM NAME="ErrorMsg" TOKENNO="0"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser>
			<Protocols>
				<Protocol>
					<Commands>
						<Command commandstr="sgeneral show" parsercommandname="hardware_prop_avocent_acs" responseparserid="melnet_switch_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:Prompt}" timeout="30000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
