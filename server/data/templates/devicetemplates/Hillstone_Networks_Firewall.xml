<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="Hillstone Networks Firewall" displayName="Hillstone Networks Firewall" osType="Hillstone Networks StoneOS" templateName="Hillstone_Networks_Firewall">
	<RestTemplate name=""/>
	<Vendor displayName="Hillstone" vendorName="Hillstone">
		<Commands>
			<Command commandstr="show version"/>
		</Commands>
		<LoggingLevels/>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="backup">
            	<Operation name="startup">
                	<Command commandstr="terminal length 0" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000" promptactionid="HillstoneActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show configuration startup" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="30000" promptactionid="HillstoneActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="running">
                	<Command commandstr="terminal length 0" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000" promptactionid="HillstoneActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="show configuration running" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="30000" promptactionid="HillstoneActionId" readfromresponse="true" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="others">
            	<Operation name="syncconfiguration">
                	<Command commandstr="save" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000" promptactionid="HillstoneActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
        	<OperationGroup type="changedetection">
            	<Operation name="enable">
                	<Command commandstr="config" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="10" timeout="30000" promptactionid="HillstoneActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="logging syslog ${UserInput:HostIpAddress} udp 514 type event" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="20" timeout="30000" promptactionid="HillstoneActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="logging event on" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="30" timeout="30000" promptactionid="HillstoneActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="logging event to syslog" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="40" timeout="30000" promptactionid="HillstoneActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="end" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="50" timeout="30000" promptactionid="HillstoneActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Hillstone Networks Firewall" personalityName="HillstoneNetworksFirewall">	
		<Login enablecommand="enable" suffix="${LF}" postloginprompt="" postlogincommand="" preloginprompt="" prelogincommand=""/>
		<PersonalityTable>
			<Columns>
				<Column name="PRODUCT_NAME" size="150" desc="Product Name" displayname="Product Name" defaultvalue="Not Available" sequenceid="1"/>
				<Column name="ASSEMBLY_NUMBER" size="150" desc="Assembly Number" displayname="Assembly Number" defaultvalue="Not Available" sequenceid="2"/>
				<Column name="VROUTER_FEATURE" size="150" desc="vRouter Feature" displayname="vRouter Feature" defaultvalue="Not Available" sequenceid="3"/>
				<Column name="URLDB_FEATURE" size="150" desc="URLDB Feature" displayname="URLDB Feature" defaultvalue="Not Available" sequenceid="4"/>
				<Column name="URLDB_MAGIC" size="150" desc="URLDB magic" displayname="URLDB magic" defaultvalue="Not Available" sequenceid="5"/>
				<Column name="APP_FEATURE" size="150" desc="APP Feature" displayname="APP Feature" defaultvalue="Not Available" sequenceid="6"/>
				<Column name="APP_MAGIC" size="150" desc="APP magic" displayname="APP magic" defaultvalue="Not Available" sequenceid="7"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
			<ExcludeLines/>
			<SyslogStateCheckers>
				<SyslogState state="enable">
					<Regex>logging syslog\s*$SYSLOG_SERVER_IP.*</Regex>
				</SyslogState>
			</SyslogStateCheckers>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="HillstoneFwHardwarePropParser.xml"/>
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" parsercommandname="hardware_prop_Hillstone_Networks_Firewall" responseparserid="Hillstone_Networks_Firewall_hardware_prop_parser" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" timeout="30000" promptactionid="HillstoneActionId"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
    <NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
