<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<NCMDeviceTemplate description="For Panasonic GA Series" displayName="Panasonic GA Series" osType="Qos" templateName="Panasonic GA Series" category="Switch">
	<RestTemplate name=""/>
	<Vendor displayName="Panasonic" vendorName="Panasonic">
		<Commands>
			<Command commandstr="show version"/>
			<Command commandstr="show unit"/>
		</Commands>
		<LoggingLevels>
			<Level name="notifications" number="5" sequenceid="0"/>
			<Level name="informational" number="6" sequenceid="1"/>
			<Level name="debugging" number="7" sequenceid="2"/>
		</LoggingLevels>
	</Vendor>
	<Protocols>
		<Protocol name="SSH/TELNET">
        	<OperationGroup type="Backup">
            	<Operation name="Running">
                	<Command commandecho="" commandstr="terminal length 0" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="NA" promptecho="" readfromresponse="false" sequenceid="2" timeout="20000"/>
                	<Command commandecho="" commandstr="show running-config" delay="" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" promptactionid="NA" promptecho="" readfromresponse="true" sequenceid="3" timeout="20000"/>
            	</Operation>
            	<Operation name="Startup">
                	<Command commandecho="" commandstr="terminal length 0" delay="" messagesuffix="${LF}" prompt="" promptactionid="NA" promptecho="" readfromresponse="false" sequenceid="2" timeout=""/>
                	<Command commandecho="" commandstr="show startup-config" delay="" messagesuffix="${LF}" prompt="" promptactionid="NA" promptecho="" readfromresponse="true" sequenceid="3" timeout=""/>
            	</Operation>
        	</OperationGroup>
			<OperationGroup type="others">
            	<Operation name="syncconfiguration">
                	<Command commandstr="copy running-config startup-config" messagesuffix="${LF}" prompt="#" sequenceid="1" timeout="20000" promptactionid="yesActionId" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
			<OperationGroup type="changedetection">
            	<Operation name="enable">
                	<Command commandstr="configure terminal" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="3" timeout="20000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="logging server ${UserInput:HostIpAddress} severity ${UserInput:LoggingLevel}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="5" timeout="20000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="end" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="7" timeout="20000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
            	<Operation name="disable">
                	<Command commandstr="configure terminal" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="3" timeout="20000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="no logging server ${UserInput:HostIpAddress}" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="4" timeout="20000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
                	<Command commandstr="end" messagesuffix="${LF}" prompt="${UserInput:EnablePrompt}" sequenceid="5" timeout="20000" promptactionid="" readfromresponse="false" promptecho="true" commandecho="false" delay="0"/>
            	</Operation>
        	</OperationGroup>
    	</Protocol>
	</Protocols>
    <NCMPersonality displayName="Panasonic GA Series" personalityName="PanasonicGASeries">	
		<Login enablecommand="enable" postlogincommand="" postloginprompt="" prelogincommand="" preloginprompt="" suffix="${LF}"/>
		<PersonalityTable>
			<Columns>
				<Column defaultvalue="Not Available" desc="Hardware version" displayname="Hardware version" name="HWVERSION" sequenceid="10" size="100"/>
				<Column defaultvalue="Not Available" desc="Bootloader version" displayname="Bootloader version" name="BOOTLOADERVERSION" sequenceid="20" size="100"/>
				<Column defaultvalue="Not Available" desc="Total DRAM Size" displayname="Total DRAM Size" name="DRAM_Size" sequenceid="30" size="100"/>
				<Column defaultvalue="Not Available" desc="Total FLASH Size" displayname="Total FLASH Size" name="FLASH_Size" sequenceid="40" size="100"/>
			</Columns>
		</PersonalityTable>
		<ConfigurationFile format="Text">
 			<ExcludeLines>
				<Criteria type="deleteLine">
					<Regex>^Building.*\n\n^Current.*\n</Regex>
					<Regex>^Using.*out.*</Regex>
				</Criteria>
				<Criteria type="deletePrompt">
					<Regex>.*</Regex>
				</Criteria>
			</ExcludeLines>
			<SyslogStateCheckers>
				<SyslogState state="disable">
					<Regex>no logging on</Regex>
					<Regex>logging trap (emergencies|alerts|critical|errors|warnings)</Regex>
				</SyslogState>
				<SyslogState state="enable">
					<Regex>(logging $SYSLOG_SERVER_IP$)|(logging host $SYSLOG_SERVER_IP$)</Regex>
				</SyslogState>
			</SyslogStateCheckers>
		</ConfigurationFile>
		<HardwareDetails>
			<HardwareParser parserFileName="PanasonicGAHardwarePropParser.xml"> 
				<MESSAGE-PARSER>
					<PARSER CLASSNAME="com.adventnet.util.parser.regex.scalar.RegExScalarParser" TYPE="rule1">
						<COMMAND NAME="hardware_prop_panasonic_ga_version">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">									
										<REGEX EXPRESSION=".*H\/W:\s*s*(\S*).*" NAME="HWVERSION">
											<PARAM NAME="HWVERSION" TOKENNO="1"/>
										</REGEX>								
										<REGEX EXPRESSION=".*[Bb]oot\s*[Ll]oader:\s*(\S*).*" NAME="BOOTLOADERVERSION">
											<PARAM NAME="BOOTLOADERVERSION" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*System MAC Address:\s*(\S*).*" NAME="MACADDRESS">
											<PARAM NAME="MACADDRESS" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*[Rr]untime\s*:\s*(\S+)" NAME="OSVERSION">
											<PARAM NAME="OSVERSION" TOKENNO="1"/>
										</REGEX>
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							 </ERROR-RULE>
						</COMMAND>
						<COMMAND NAME="hardware_prop_panasonic_ga_show_unit">
							<VALID-RULE>
								<METADATA>
									<SCALAR REFERENCEREQ="false">									
										<REGEX EXPRESSION=".*[Pp]roduct\s*[Nn]ame\s*:\s*(\S+).*" NAME="MODEL">
											<PARAM NAME="MODEL" TOKENNO="1"/>
											<PARAM NAME="SERIES" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*[Ss]erial[\s*\-][Nn]umber\s*:\s*(\S+).*" NAME="SERIALNUMBER">
											<PARAM NAME="SERIALNUMBER" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*FLASH\s*(\S+\s*\S+).*" NAME="FLASH_Size">
											<PARAM NAME="FLASH_Size" TOKENNO="1"/>
										</REGEX>
										<REGEX EXPRESSION=".*DRAM\s*(\S+\s*\S+).*" NAME="DRAM_Size">
											<PARAM NAME="DRAM_Size" TOKENNO="1"/>
										</REGEX>		
									</SCALAR>
								</METADATA>
							</VALID-RULE>
							<ERROR-RULE>
							 <!-- Error rule specific to the command -->
								<METADATA>
									<SCALAR>
									  <!-- error message for command  -->
									  <REGEX EXPRESSION=".*(Incomplete command).*" NAME="CmdError1">
										 <PARAM NAME="ErrorMsg" TOKENNO="0"/>
									  </REGEX>
									</SCALAR>
								</METADATA>
							 </ERROR-RULE>
						</COMMAND>
					</PARSER>
				</MESSAGE-PARSER>
			</HardwareParser> 
			<Protocols>
				<Protocol name="">
					<Commands operation="">
						<Command commandstr="show version" messagesuffix="${LF}" parsercommandname="hardware_prop_panasonic_ga_version" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" timeout="20000"/>
						<Command commandstr="show unit" messagesuffix="${LF}" parsercommandname="hardware_prop_panasonic_ga_show_unit" prompt="${UserInput:EnablePrompt}" promptactionid="yesActionId" timeout="20000"/>
					</Commands>
				</Protocol>
			</Protocols>
		</HardwareDetails>
	</NCMPersonality>
	<NCMDeviceSysOIDList/>
	<CustDeviceSysOIDList/>
	<PromptActionIds/>
</NCMDeviceTemplate>
