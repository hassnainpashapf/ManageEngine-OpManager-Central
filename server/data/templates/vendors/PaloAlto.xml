		 </NCMDeviceCriteria>
        </NCMProtocolCombination -->

	<!-- TELNET -->
         <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:paloalto_panorama_firewall_telnet" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:paloalto_panorama_firewall"
            managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
