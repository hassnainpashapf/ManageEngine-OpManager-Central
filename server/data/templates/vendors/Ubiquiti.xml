<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<DeviceConfiguration>

    <!-- For Ubiquiti Air Os -->
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:ubiquiti_air_os" templatename="Ubiquiti_Air_Os" ostype="Air OS" displayname="Ubiquiti Air Os" description="For all Ubiquiti Air Os">
        <NCMVendorDevice vendorid="Ubiquiti" />
        <NCMDevicePersonality personalityid="UbiquitiAirOs" />

        <NCMSupportedProtocol protocolid="TELNET">
            <NCMDeviceCredential credentialgroupid="Telnet Credentials"/>
        </NCMSupportedProtocol>
        
        <NCMSupportedProtocol protocolid="SSH">
            <NCMDeviceCredential credentialgroupid="SSH Credentials"/>
        </NCMSupportedProtocol>
	
	<!-- SSH -->
	<NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:ubiquiti_air_os_ssh" devicetemplateid="NCMDeviceTemplate:devicetemplateid:ubiquiti_air_os"
	managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
        <NCMDeviceCriteria commandmapid="SSH_Command">
      <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="ubiquiti_air_os_running_config_backup" taskhandling="true"/>
	<NCMReadFromResponse operationid="BackupRunningConfig" recordid="ubiquiti_air_os_cli_fetch_running_rec"/>
        </NCMDeviceCriteria>
        </NCMProtocolCombination>
	
	<!-- telnet -->
	<NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:ubiquiti_air_os_telnet" devicetemplateid="NCMDeviceTemplate:devicetemplateid:ubiquiti_air_os"
	managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
        <NCMDeviceCriteria commandmapid="TELNET_Command">	
	<NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="ubiquiti_air_os_running_config_backup" taskhandling="true"/>
	<NCMReadFromResponse operationid="BackupStartupConfig" recordid="ubiquiti_air_os_cli_fetch_running_rec"/>	
            </NCMDeviceCriteria>
        </NCMProtocolCombination>
	
	
	
    </NCMDeviceTemplate>

</DeviceConfiguration>
