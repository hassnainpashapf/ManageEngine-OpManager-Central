<DeviceConfiguration>

    <!-- For Matrix N series - N7 -->
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:enterasys_switch_matrixN7" templatename="Enterasys_MatrixNSeries_Switch" displayname="Enterasys Matrix N Switch" ostype="EOS" description="For all Enterasys Matrix N Series Switches">
        <NCMVendorDevice vendorid="Enterasys"/>
        <NCMDevicePersonality personalityid="EnterasysSwitch"/>

        <NCMSupportedProtocol protocolid="TELNET">
            <NCMDeviceCredential credentialgroupid="Telnet Credentials"/>
        </NCMSupportedProtocol>

		<NCMSupportedProtocol protocolid="SSH">
			<NCMDeviceCredential credentialgroupid="SSH Credentials" />
		</NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TFTP"/>

		<!-- Telnet -->
        <NCMProtocolCombination
            deviceprotocolid="NCMProtocolCombination:deviceprotocolid:enterasys_switch_matrixN7_telnet"
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:enterasys_switch_matrixN7"
            managementprotocolid="TELNET" transferprotocolid="TFTP" displayname="TELNET - TFTP">
            <NCMDeviceCriteria commandmapid="TELNET_TFTP_Command">

                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="enterasysswitch_matrixn_cli_running_config_backup" />
                <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="enterasysswitch_matrixn_cli_running_config_upload" />

                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="enterasysswitch_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="enterasysswitch_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

		<!-- SSH -->
        <NCMProtocolCombination
            deviceprotocolid="NCMProtocolCombination:deviceprotocolid:enterasys_switch_matrixN7_ssh"
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:enterasys_switch_matrixN7"
            managementprotocolid="SSH" transferprotocolid="TFTP" displayname="SSH - TFTP">
            <NCMDeviceCriteria commandmapid="SSH_TFTP_Command">

                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="enterasysswitch_matrixn_cli_running_config_backup" />
                <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="enterasysswitch_matrixn_cli_running_config_upload" />

                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="enterasysswitch_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="enterasysswitch_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

    </NCMDeviceTemplate>


