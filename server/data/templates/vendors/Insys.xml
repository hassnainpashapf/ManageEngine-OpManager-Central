<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<DeviceConfiguration>

    <!-- For INSYS MoRoS Router -->
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:insys_moros" templatename="INSYS_MoRoS" ostype="NA" displayname="INSYS MoRoS" description="For all INSYS MoRoS">
        <NCMVendorDevice vendorid="INSYS" />
        <NCMDevicePersonality personalityid="INSYSMoRoS" />

        <NCMSupportedProtocol protocolid="TELNET">
            <NCMDeviceCredential credentialgroupid="Telnet Credentials"/>
        </NCMSupportedProtocol>
        
        <NCMSupportedProtocol protocolid="SSH">
            <NCMDeviceCredential credentialgroupid="SSH Credentials"/>
        </NCMSupportedProtocol>
	
	<!-- SSH -->
	<NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:insys_moros_ssh" devicetemplateid="NCMDeviceTemplate:devicetemplateid:insys_moros"
	managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
        <NCMDeviceCriteria commandmapid="SSH_Command">
      <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="insys_moros_running_config_backup" taskhandling="true"/>
	<NCMReadFromResponse operationid="BackupRunningConfig" recordid="insys_moros_cli_fetch_running_rec"/>
        </NCMDeviceCriteria>
        </NCMProtocolCombination>
	
	<!-- telnet -->
	<NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:insys_moros_telnet" devicetemplateid="NCMDeviceTemplate:devicetemplateid:insys_moros"
	managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
        <NCMDeviceCriteria commandmapid="TELNET_Command">	
	<NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="insys_moros_running_config_backup" taskhandling="true"/>
	<NCMReadFromResponse operationid="BackupRunningConfig" recordid="insys_moros_cli_fetch_running_rec"/>	
            </NCMDeviceCriteria>
        </NCMProtocolCombination>
	
	
	
    </NCMDeviceTemplate>

</DeviceConfiguration>
