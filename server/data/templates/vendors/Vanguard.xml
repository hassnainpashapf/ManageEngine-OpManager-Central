	<NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:vanguard_router_ssh" devicetemplateid="NCMDeviceTemplate:devicetemplateid:vanguard_router" managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
		<NCMDeviceCriteria commandmapid="SSH_Command">

			<NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="vanguard_router_cli_fetch_running_config" />
			<NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="vanguard_router_cli_push_running_config"/>

		</NCMDeviceCriteria>
	</NCMProtocolCombination>
	-->
</NCMDeviceTemplate>
</DeviceConfiguration>
