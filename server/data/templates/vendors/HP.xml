<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<DeviceConfiguration>

    <!-- For HP Procurve Switches -->

    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:hp_switch_procurve2524" templatename="HP_Procurve_Switch" displayname="HP Procurve Switch" description="For all HP Procurve Switches with cli command prompt interaction" IS_DEPRICATED="true">
        <NCMVendorDevice vendorid="HP" />
        <NCMDevicePersonality personalityid="HPSwitch"/>

        <NCMSupportedProtocol protocolid="TELNET">
            <NCMDeviceCredential credentialgroupid="Telnet Credentials"/>
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="SSH">
            <NCMDeviceCredential credentialgroupid="SSH Credentials"/>
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TFTP"/>

        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:hp_switch_procurve2524_telnet" devicetemplateid="NCMDeviceTemplate:devicetemplateid:hp_switch_procurve2524"
            managementprotocolid="TELNET" transferprotocolid="TFTP" displayname="TELNET - TFTP">
            <NCMDeviceCriteria commandmapid="TELNET_TFTP_Command">

                <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="hpswitch_procurve_cli_startup_config_backup" />
                <NCMDeviceOperation operationid="UploadStartupConfig" executiongroupid="hpswitch_procurve_cli_startup_config_upload" />
                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="hpswitch_procurve_cli_running_config_backup" />
                <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="hpswitch_procurve_cli_running_config_upload" taskhandling="true"/>

                <NCMUserInputKey operationid="UploadRunningConfig" userinputkey="FileContents"/>
 
                 <!-- Change Tracking thru Syslog -->
				 
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="hpswitch_procurve_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="hpswitch_procurve_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

        <!-- for SSH-TFTP-->
        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:hp_switch_procurve2524_ssh" devicetemplateid="NCMDeviceTemplate:devicetemplateid:hp_switch_procurve2524"
            managementprotocolid="SSH" transferprotocolid="TFTP" displayname="SSH - TFTP">
            <NCMDeviceCriteria commandmapid="SSH_TFTP_Command">

                <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="hpswitch_procurve_cli_startup_config_backup" />
                <NCMDeviceOperation operationid="UploadStartupConfig" executiongroupid="hpswitch_procurve_cli_startup_config_upload" />
                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="hpswitch_procurve_cli_running_config_backup" />
                <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="hpswitch_procurve_cli_running_config_upload" taskhandling="true"/>

                <NCMUserInputKey operationid="UploadRunningConfig" userinputkey="FileContents"/>

                 <!-- Change Tracking thru Syslog -->
				 
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="hpswitch_procurve_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="hpswitch_procurve_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>
		
		<!-- SSH -->
        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:hp_switch_ssh" devicetemplateid="NCMDeviceTemplate:devicetemplateid:hp_switch_procurve2524"
            managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
            <NCMDeviceCriteria commandmapid="SSH_Command">
		
                <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="hp_switch_cli_startup_config_backup" taskhandling="true"/>
                <NCMReadFromResponse operationid="BackupStartupConfig" recordid="show_hp_switch_startup"/>

        <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="hp_switch_cli_running_config_backup" taskhandling="true"/>
        <NCMReadFromResponse operationid="BackupRunningConfig" recordid="show_hp_switch_running"/>

                 <!-- Change Tracking thru Syslog -->
				 
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="hpswitch_procurve_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="hpswitch_procurve_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

        <!-- telnet -->
        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:hp_switch_telnet" devicetemplateid="NCMDeviceTemplate:devicetemplateid:hp_switch_procurve2524"
            managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
            <NCMDeviceCriteria commandmapid="TELNET_Command">


                <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="hp_switch_cli_startup_config_backup" taskhandling="true"/>
                <NCMReadFromResponse operationid="BackupStartupConfig" recordid="show_hp_switch_startup"/>

                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="hp_switch_cli_running_config_backup" taskhandling="true"/>
                <NCMReadFromResponse operationid="BackupRunningConfig" recordid="show_hp_switch_running"/>

                 <!-- Change Tracking thru Syslog -->
				 
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="hpswitch_procurve_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="hpswitch_procurve_disable_syslog_change_tracking" />


            </NCMDeviceCriteria>
        </NCMProtocolCombination>
		
    </NCMDeviceTemplate>


