<NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:hp_5500_switch" templatename="HP_5500_Switch" displayname="HP 5500 Series Switch" ostype="NA" description="For all HP 10400, 5900 and 5500 Series Switches">
