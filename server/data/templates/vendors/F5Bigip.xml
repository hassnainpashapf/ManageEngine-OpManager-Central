<DeviceConfiguration>

    <!-- For F5 Bigip -->

    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:F5_Bigip" templatename="F5_Big_IP"  displayname="F5 BIG-IP" ostype="BIG-IP"  description="For F5 Bigip">
        <NCMVendorDevice vendorid="F5"/>

        <NCMDevicePersonality personalityid="F5Bigip"/>

        <NCMSupportedProtocol protocolid="TELNET">
            <NCMDeviceCredential credentialgroupid="Telnet Credentials" />
        </NCMSupportedProtocol>

		<NCMSupportedProtocol protocolid="SSH">
			<NCMDeviceCredential credentialgroupid="SSH Credentials" />
		</NCMSupportedProtocol>

         <NCMSupportedProtocol protocolid="SCP"/>

<!-- For Telnet -->

	<NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:F5_Bigip_telnet_alone" devicetemplateid="NCMDeviceTemplate:devicetemplateid:F5_Bigip" managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
		
		<NCMDeviceCriteria commandmapid="TELNET_Command">
			
		<NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="F5Bigip_telnet_startup_config_fetch" taskhandling="true"/>
			<NCMReadFromResponse operationid="BackupStartupConfig" recordid="F5_bigip_show_startup_config_rec5"/>
			
		<!-- Change Tracking thru Syslog -->
		<NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="F5_Bigip_Enable_Change_Tracking_Syslog" />
		<NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="F5_Bigip_Disable_Change_Tracking_Syslog" />	
		</NCMDeviceCriteria>
	</NCMProtocolCombination>

<!-- For SSH -->
	
	<NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:F5_Bigip_ssh_alone" devicetemplateid="NCMDeviceTemplate:devicetemplateid:F5_Bigip" managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
		
		<NCMDeviceCriteria commandmapid="SSH_Command">
		<NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="F5Bigip_telnet_startup_config_fetch" taskhandling="true"/>
		<NCMReadFromResponse operationid="BackupStartupConfig" recordid="F5_bigip_show_startup_config_rec5"/>
		
		<!-- Change Tracking thru Syslog -->
		<NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="F5_Bigip_Enable_Change_Tracking_Syslog" />
		<NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="F5_Bigip_Disable_Change_Tracking_Syslog" />
        </NCMDeviceCriteria>
	</NCMProtocolCombination>

<!--SSH-SCP-->

<NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:F5_Bigip_ssh_scp"
devicetemplateid="NCMDeviceTemplate:devicetemplateid:F5_Bigip"
            managementprotocolid="SSH" transferprotocolid="SCP" displayname="SSH - SCP">
            <NCMDeviceCriteria commandmapid="SSH_SCP_Command">

              <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="F5Bigip_scp_startup_config_fetch"/>
	      
	      <!-- Change Tracking thru Syslog -->
	      <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="F5_Bigip_Enable_Change_Tracking_Syslog" />
	      <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="F5_Bigip_Disable_Change_Tracking_Syslog" />
            </NCMDeviceCriteria>
        </NCMProtocolCombination>

</NCMDeviceTemplate>


<!-- F5 ARX devices -->

    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:f5_arx" templatename="F5_ARX" displayname="F5 ARX" ostype="NA" description="For all F5 ARX devices">
        <NCMVendorDevice vendorid="F5"/>
        <NCMDevicePersonality personalityid="F5ARX"/>
		
        <NCMSupportedProtocol protocolid="TELNET">
			<NCMDeviceCredential credentialgroupid="Telnet Credentials" />
        </NCMSupportedProtocol>
       
		<NCMSupportedProtocol protocolid="SSH">
			<NCMDeviceCredential credentialgroupid="SSH Credentials" />
        </NCMSupportedProtocol>


		<!-- SSH -->
            <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:f5_arx_ssh" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:f5_arx"
            managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
            <NCMDeviceCriteria commandmapid="SSH_Command">

             <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="f5_arx_cli_startup_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupStartupConfig" recordid="F5_arx_show_startup_config_rec"/>
			 
             <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="f5_arx_cli_running_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupRunningConfig" recordid="F5_arx_show_running_config_rec"/>
			 
            </NCMDeviceCriteria>
        </NCMProtocolCombination>

	<!-- TELNET -->
         <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:f5_arx_telnet" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:f5_arx"
            managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
            <NCMDeviceCriteria commandmapid="TELNET_Command">

             <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="f5_arx_cli_startup_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupStartupConfig" recordid="F5_arx_show_startup_config_rec"/>			 
			 
             <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="f5_arx_cli_running_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupRunningConfig" recordid="F5_arx_show_running_config_rec"/>
			 
            </NCMDeviceCriteria>
        </NCMProtocolCombination>

    </NCMDeviceTemplate>
	
	
	
