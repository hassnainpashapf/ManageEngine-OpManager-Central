<DeviceConfiguration>

<!-- For Black Diamond Switch -->
<NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:extreme_bd_switch_6808" templatename="Extreme_BlackDiamond_Switch" displayname="Extreme Black Diamond Switch" ostype="ExtremeWare" description="For all Extreme Black Diamond Switches">

    <NCMVendorDevice vendorid="Extreme"/>
    <NCMDevicePersonality personalityid="ExtremeSwitch"/>

    <NCMSupportedProtocol protocolid="TELNET">
        <NCMDeviceCredential credentialgroupid="Telnet Credentials"/>
    </NCMSupportedProtocol>

    <NCMSupportedProtocol protocolid="SSH">
        <NCMDeviceCredential credentialgroupid="SSH Credentials"/>
    </NCMSupportedProtocol>

    <NCMSupportedProtocol protocolid="TFTP"/>

<!--Telnet-->
    <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:extreme_bd_switch_6808_telnet" devicetemplateid="NCMDeviceTemplate:devicetemplateid:extreme_bd_switch_6808"
        managementprotocolid="TELNET" transferprotocolid="TFTP" displayname="TELNET - TFTP">
        <NCMDeviceCriteria commandmapid="TELNET_TFTP_Command">

        <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="extremebdswitch_cli_running_config_backup"/>
        <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="extremebdswitch_cli_running_config_upload"/>

	<!-- Change Tracking thru Syslog -->
	<NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog"
			    executiongroupid="Extreme_Switch_Enable_Change_Tracking_Syslog" />
	<NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog"
			    executiongroupid="Extreme_Switch_Disable_Change_Tracking_Syslog" />

        </NCMDeviceCriteria>
    </NCMProtocolCombination>

    <!--SSH-->

    <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:extreme_bd_switch_6808_ssh" devicetemplateid="NCMDeviceTemplate:devicetemplateid:extreme_bd_switch_6808"
     managementprotocolid="SSH" transferprotocolid="TFTP" displayname="SSH - TFTP">
	    <NCMDeviceCriteria commandmapid="SSH_TFTP_Command">

		    <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="extremebdswitch_cli_running_config_backup"/>
		    <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="extremebdswitch_cli_running_config_upload"/>

		    <!-- Change Tracking thru Syslog -->
		    <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog"
					executiongroupid="Extreme_Switch_Enable_Change_Tracking_Syslog" />
		    <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog"
					executiongroupid="Extreme_Switch_Disable_Change_Tracking_Syslog" />

	    </NCMDeviceCriteria>
    </NCMProtocolCombination>
</NCMDeviceTemplate>

