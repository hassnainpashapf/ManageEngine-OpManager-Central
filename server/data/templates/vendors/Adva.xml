<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<DeviceConfiguration>

    <!-- For ADVA Optical Networking -->
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:adva_fsp150ccf" templatename="ADVA_FSP150CCF" displayname="ADVA FSP150CC-825" ostype="ADVA" description="For all ADVA Optical Networking CC-825 models">
        <NCMVendorDevice vendorid="ADVA"/>
        <NCMDevicePersonality personalityid="ADVAOPTICALNETWORKING"/>

		<NCMSupportedProtocol protocolid="SSH">
			<NCMDeviceCredential credentialgroupid="SSH Credentials" />
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TELNET">
			<NCMDeviceCredential credentialgroupid="Telnet Credentials" />
        </NCMSupportedProtocol>
       

		<!-- SSH -->
        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:adva_fsp150ccf_ssh" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:adva_fsp150ccf"
            managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
            <NCMDeviceCriteria commandmapid="SSH_Command">

             <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="adva_fsp150ccf_cli_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupRunningConfig" recordid="adva_fsp150ccf_cli_show_config_rec"/>
			 
            </NCMDeviceCriteria>
        </NCMProtocolCombination>

	<!-- TELNET -->
         <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:adva_fsp150ccf_telnet" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:adva_fsp150ccf"
            managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
            <NCMDeviceCriteria commandmapid="TELNET_Command">

             <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="adva_fsp150ccf_cli_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupRunningConfig" recordid="adva_fsp150ccf_cli_show_config_rec"/>

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

    </NCMDeviceTemplate>
	
	<!-- For ADVA FSP150CC-GE201 Optical Networking -->
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:adva_fsp150cc_ge201" templatename="ADVA_FSP150CC_GE201" displayname="ADVA FSP150CC-GE201" ostype="ADVA" description="For all ADVA Optical Networking GE201 models">
        <NCMVendorDevice vendorid="ADVA"/>
        <NCMDevicePersonality personalityid="ADVAFSP"/>

		<NCMSupportedProtocol protocolid="SSH">
			<NCMDeviceCredential credentialgroupid="SSH Credentials" />
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TELNET">
			<NCMDeviceCredential credentialgroupid="Telnet Credentials" />
        </NCMSupportedProtocol>
       

		<!-- SSH -->
        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:adva_fsp150cc_ge201_ssh" devicetemplateid="NCMDeviceTemplate:devicetemplateid:adva_fsp150cc_ge201" managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
            <NCMDeviceCriteria commandmapid="SSH_Command">

             <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="adva_fsp150cc_ge201_cli_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupRunningConfig" recordid="adva_fsp150cc_ge201_cli_show_config_rec"/>
			 
            </NCMDeviceCriteria>
        </NCMProtocolCombination>

	<!-- TELNET -->
         <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:adva_fsp150cc_ge201_telnet" devicetemplateid="NCMDeviceTemplate:devicetemplateid:adva_fsp150cc_ge201" managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
            <NCMDeviceCriteria commandmapid="TELNET_Command">

             <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="adva_fsp150cc_ge201_cli_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupRunningConfig" recordid="adva_fsp150cc_ge201_cli_show_config_rec"/>

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

    </NCMDeviceTemplate>

</DeviceConfiguration>

