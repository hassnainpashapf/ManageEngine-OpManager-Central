<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<DeviceConfiguration>

    <!-- For Digi TransPort wireless Router -->
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:digi_router" templatename="digi_router" displayname="TransPort Wireless Router" ostype="Digi" description="For all Digi TransPort WR44-U ">
        <NCMVendorDevice vendorid="Digi"/>
        <NCMDevicePersonality personalityid="TransPortWirelessRouter"/>

		<NCMSupportedProtocol protocolid="SSH">
			<NCMDeviceCredential credentialgroupid="SSH Credentials" />
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TELNET">
			<NCMDeviceCredential credentialgroupid="Telnet Credentials" />
        </NCMSupportedProtocol>
       

		<!-- SSH -->
        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:digi_router_ssh" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:digi_router"
            managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
            <NCMDeviceCriteria commandmapid="SSH_Command">

             <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="digi_router_cli_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupStartupConfig" recordid="digi_router_cli_show_config_rec"/>
			 
             <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="digi_router_cli_running_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupRunningConfig" recordid="digi_router_cli_running_show_config_rec"/>

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

	<!-- TELNET -->
         <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:digi_router_telnet" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:digi_router"
            managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
            <NCMDeviceCriteria commandmapid="TELNET_Command">

             <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="digi_router_cli_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupStartupConfig" recordid="digi_router_cli_show_config_rec"/>			 
			 
             <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="digi_router_cli_running_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupRunningConfig" recordid="digi_router_cli_running_show_config_rec"/>
			 
            </NCMDeviceCriteria>
        </NCMProtocolCombination>

    </NCMDeviceTemplate>

</DeviceConfiguration>

