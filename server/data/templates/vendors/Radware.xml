 <!-- For Radware Alteon Switches -->
 
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:radware_alteon_switch" templatename="Radware_Alteon_Switch" displayname="Radware Alteon Application Switch" description="For all Radware Alteon Application Switch">
        <NCMVendorDevice vendorid="Radware" />
        <NCMDevicePersonality personalityid="RadwareAlteonSwitch" />
        
        <NCMSupportedProtocol protocolid="TELNET">
            <NCMDeviceCredential credentialgroupid="Telnet Credentials" />
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="SSH">
            <NCMDeviceCredential credentialgroupid="SSH Credentials" />
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TFTP"/>		      

        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:radware_alteon_switch_telnet_alone" devicetemplateid="NCMDeviceTemplate:devicetemplateid:radware_alteon_switch" managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
            <NCMDeviceCriteria commandmapid="TELNET_Command">

		 <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="radware_alteon_switch_show_startup_config" taskhandling="true"/>
	     <NCMReadFromResponse operationid="BackupStartupConfig" recordid="radware_alteon_switch_show_startup_config_rec"/>
			
            </NCMDeviceCriteria>
        </NCMProtocolCombination>

               <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:radware_alteon_switch_ssh_alone" devicetemplateid="NCMDeviceTemplate:devicetemplateid:radware_alteon_switch" managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
            <NCMDeviceCriteria commandmapid="SSH_Command">

		 <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="radware_alteon_switch_show_startup_config" taskhandling="true"/>
	     <NCMReadFromResponse operationid="BackupStartupConfig" recordid="radware_alteon_switch_show_startup_config_rec"/>
		 
          </NCMDeviceCriteria>
		  
        </NCMProtocolCombination>

<!-- for TELNET-TFTP-->

		<NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:radware_alteon_switch_telnet_tftp" devicetemplateid="NCMDeviceTemplate:devicetemplateid:radware_alteon_switch" managementprotocolid="TELNET" transferprotocolid="TFTP" displayname="TELNET - TFTP">
