<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<DeviceConfiguration>

    <!-- For Radware Web Server Director Pro AS -->
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:radware_switch_wsd_pro_as" templatename="Radware_WSD_Pro_AS" displayname="Radware WSD Pro AS Switch" ostype="EOS" description="For all Radware Web Server Director Pro AS switches">
        <NCMVendorDevice vendorid="Radware"/>
        <NCMDevicePersonality personalityid="RadwareSwitch"/>

        <NCMSupportedProtocol protocolid="TELNET">
            <NCMDeviceCredential credentialgroupid="Telnet Credentials"/>
        </NCMSupportedProtocol>

		<NCMSupportedProtocol protocolid="SSH">
			<NCMDeviceCredential credentialgroupid="SSH Credentials" />
		</NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TFTP"/>

		<!-- Telnet -->
        <NCMProtocolCombination
            deviceprotocolid="NCMProtocolCombination:deviceprotocolid:radware_switch_wsd_pro_as_telnet"
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:radware_switch_wsd_pro_as"
            managementprotocolid="TELNET" transferprotocolid="TFTP" displayname="TELNET - TFTP">
            <NCMDeviceCriteria commandmapid="TELNET_TFTP_Command">

                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="radware_switch_cli_running_config_backup" />
                <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="radware_switch_cli_running_config_push" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

		<!-- SSH -->
        <NCMProtocolCombination
            deviceprotocolid="NCMProtocolCombination:deviceprotocolid:radware_switch_wsd_pro_as_ssh"
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:radware_switch_wsd_pro_as"
            managementprotocolid="SSH" transferprotocolid="TFTP" displayname="SSH - TFTP">
            <NCMDeviceCriteria commandmapid="SSH_TFTP_Command">

                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="radware_switch_cli_running_config_backup" />
                <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="radware_switch_cli_running_config_push" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

    </NCMDeviceTemplate>

