<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<DeviceConfiguration>

       <!-- For A10Networks Load Balancers -->
	   
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:a10_networks" templatename="A10_Networks" displayname="AX2500 LoadBalancers" ostype="ACOS" description="For all A10Networks AX2500 LoadBalancers">
        <NCMVendorDevice vendorid="A10Networks" />
        <NCMDevicePersonality personalityid="AX2500LoadBalancers"/>

        <NCMSupportedProtocol protocolid="TELNET">
            <NCMDeviceCredential credentialgroupid="Telnet Credentials"/>
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="SSH">
            <NCMDeviceCredential credentialgroupid="SSH Credentials"/>
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TFTP"/>

        

        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:a10_networks_telnet" devicetemplateid="NCMDeviceTemplate:devicetemplateid:a10_networks" managementprotocolid="TELNET" transferprotocolid="TFTP" displayname="TELNET - TFTP">
            <NCMDeviceCriteria commandmapid="TELNET_TFTP_Command">

                <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="a10_networks_cli_startup_config_backup" />
                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="a10_networks_cli_running_config_backup" />
                <NCMDeviceOperation operationid="CopyRunningToStartup" executiongroupid="a10_networks_cli_copy_running_to_startup" />
								
                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="a10_networks_cli_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="a10_networks_cli_disable_syslog_change_tracking" />
				
            </NCMDeviceCriteria>
        </NCMProtocolCombination>
		
		
        <!-- for SSH-TFTP-->
        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:a10_networks_ssh" devicetemplateid="NCMDeviceTemplate:devicetemplateid:a10_networks" managementprotocolid="SSH" transferprotocolid="TFTP" displayname="SSH - TFTP">
            <NCMDeviceCriteria commandmapid="SSH_TFTP_Command">

                <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="a10_networks_cli_startup_config_backup" />             
                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="a10_networks_cli_running_config_backup" />
                <NCMDeviceOperation operationid="CopyRunningToStartup" executiongroupid="a10_networks_cli_copy_running_to_startup" />
				
                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="a10_networks_cli_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="a10_networks_cli_disable_syslog_change_tracking" />
				
            </NCMDeviceCriteria>
        </NCMProtocolCombination>

        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:a10_networks_telnet_alone" devicetemplateid="NCMDeviceTemplate:devicetemplateid:a10_networks" managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
            <NCMDeviceCriteria commandmapid="TELNET_Command">

		<NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="a10_networks_telnet_startup_config_fetch" taskhandling="true"/>
		<NCMReadFromResponse operationid="BackupStartupConfig" recordid="a10_networks_cli_show_startup_config_rec"/>
		<NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="a10_networks_telnet_running_config_fetch" taskhandling="true"/>
		<NCMReadFromResponse operationid="BackupRunningConfig" recordid="a10_networks_cli_show_running_config_rec"/>
		<NCMDeviceOperation operationid="CopyRunningToStartup" executiongroupid="a10_networks_cli_copy_running_to_startup" />
				
                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="a10_networks_cli_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="a10_networks_cli_disable_syslog_change_tracking" />
                
            </NCMDeviceCriteria>
        </NCMProtocolCombination>

        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:a10_networks_ssh_alone" devicetemplateid="NCMDeviceTemplate:devicetemplateid:a10_networks" managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
            <NCMDeviceCriteria commandmapid="SSH_Command">

		<NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="a10_networks_telnet_startup_config_fetch" taskhandling="true"/>
		<NCMReadFromResponse operationid="BackupStartupConfig" recordid="a10_networks_cli_show_startup_config_rec"/>
		<NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="a10_networks_telnet_running_config_fetch" taskhandling="true"/>
		<NCMReadFromResponse operationid="BackupRunningConfig" recordid="a10_networks_cli_show_running_config_rec"/>
		<NCMDeviceOperation operationid="CopyRunningToStartup" executiongroupid="a10_networks_cli_copy_running_to_startup" />
		
                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="a10_networks_cli_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="a10_networks_cli_disable_syslog_change_tracking" />
				
            </NCMDeviceCriteria>
        </NCMProtocolCombination>
		
    </NCMDeviceTemplate>

</DeviceConfiguration>

