<NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:3com_5500_switch_switch" templatename="3com_5500_switch_switch" displayname="3Com 5500 Series Switch" ostype="NA" description="For all 3Com 5500 and 4400 Series Switches">
        <NCMVendorDevice vendorid="3Com"/>
        <NCMDevicePersonality personalityid="3Com5500Switch"/>

		<NCMSupportedProtocol protocolid="SSH">
			<NCMDeviceCredential credentialgroupid="SSH Credentials" />
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TELNET">
			<NCMDeviceCredential credentialgroupid="Telnet Credentials" />
        </NCMSupportedProtocol>       

		<!-- SSH -->
        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:3com_5500_switch_switch_ssh" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:3com_5500_switch_switch"
            managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
            <NCMDeviceCriteria commandmapid="SSH_Command">

             <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="3com_5500_switch_switch_cli_running_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupRunningConfig" recordid="3com_5500_switch_cli_current_config_rec"/>

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

	<!-- TELNET -->
         <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:3com_5500_switch_switch_telnet" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:3com_5500_switch_switch"
            managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
            <NCMDeviceCriteria commandmapid="TELNET_Command">

             <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="3com_5500_switch_switch_cli_running_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupRunningConfig" recordid="3com_5500_switch_cli_current_config_rec"/>
			 
            </NCMDeviceCriteria>
        </NCMProtocolCombination>

    </NCMDeviceTemplate>


</DeviceConfiguration>
