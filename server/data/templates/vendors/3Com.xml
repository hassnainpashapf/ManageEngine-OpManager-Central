<DeviceConfiguration>

<!-- For 3Com switches -->

<NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:3com_menu_switch" templatename="3Com_MenuBased_Switch" displayname="3Com Menu Based Switches" description="For all 3Com menu based switches">
    <NCMVendorDevice vendorid="3Com" />
    <NCMDevicePersonality personalityid="3ComSwitch" />

    <NCMSupportedProtocol protocolid="TELNET">
        <NCMDeviceCredential credentialgroupid="Telnet Credentials" />
    </NCMSupportedProtocol>

    <NCMSupportedProtocol protocolid="SSH">
	    <NCMDeviceCredential credentialgroupid="SSH Credentials" />
    </NCMSupportedProtocol>

    <NCMSupportedProtocol protocolid="TFTP"/>

    <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:3com_menu_switch_telnet" devicetemplateid="NCMDeviceTemplate:devicetemplateid:3com_menu_switch" managementprotocolid="TELNET" transferprotocolid="TFTP" displayname="TELNET - TFTP">
        <NCMDeviceCriteria commandmapid="TELNET_TFTP_Command">
			<NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="3comswitch_cli_running_config_backup" />
			<NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="3comswitch_cli_running_config_upload" />
        </NCMDeviceCriteria>
    </NCMProtocolCombination>

    <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:3com_menu_switch_ssh" devicetemplateid="NCMDeviceTemplate:devicetemplateid:3com_menu_switch" managementprotocolid="SSH" transferprotocolid="TFTP" displayname="SSH - TFTP">
        <NCMDeviceCriteria commandmapid="SSH_TFTP_Command">
			<NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="3comswitch_cli_running_config_backup" />
			<NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="3comswitch_cli_running_config_upload" />
        </NCMDeviceCriteria>
    </NCMProtocolCombination>

</NCMDeviceTemplate>


