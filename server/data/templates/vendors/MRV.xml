<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<DeviceConfiguration>

    <!-- Lamda Driver -->
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:mrvlambadriver" templatename="MRV_Lambda_Driver" displayname="Lambda Driver" ostype="LambdaDriver" description="For all lambda drivers">
        <NCMVendorDevice vendorid="MRV"/>
        
        <NCMDevicePersonality personalityid="LambdaDriver"/>

        <NCMSupportedProtocol protocolid="TELNET">
            <NCMDeviceCredential credentialgroupid="Telnet Credentials"/>
        </NCMSupportedProtocol>

		<NCMSupportedProtocol protocolid="SSH">
			<NCMDeviceCredential credentialgroupid="SSH Credentials" />
		</NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TFTP"/>


		<!-- Telnet -->
	    <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:mrvlambdadriver_telnet_tftp" devicetemplateid="NCMDeviceTemplate:devicetemplateid:mrvlambadriver"
        managementprotocolid="TELNET" transferprotocolid="TFTP" displayname="TELNET - TFTP">
        <NCMDeviceCriteria commandmapid="TELNET_TFTP_Command">

                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="lambdadriver_running_config_backup"/>
                <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="lambdadriver_startup_config_backup"/>
                <NCMDeviceOperation operationid="UploadStartupConfig" executiongroupid="lambdadriver_startup_config_upload"/>
                <NCMDeviceOperation operationid="CopyRunningToStartup" executiongroupid="lambdadriver_running_config_sync"/>

                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="Lambda_Driver_Enable_Change_Tracking_Syslog" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="Lambda_Driver_Disable_Change_Tracking_Syslog" />
	        </NCMDeviceCriteria>
        </NCMProtocolCombination>

        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:mrvlambdadriver_telnet" devicetemplateid="NCMDeviceTemplate:devicetemplateid:mrvlambadriver"
        managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
        <NCMDeviceCriteria commandmapid="TELNET_Command">

            <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="lambdadriver_write_terminal" taskhandling="true" />
            <NCMReadFromResponse operationid="BackupRunningConfig" recordid="lambda_driver_write_terminal_rec"/>

             <!-- Change Tracking thru Syslog -->
             <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="Lambda_Driver_Enable_Change_Tracking_Syslog" />
             <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="Lambda_Driver_Disable_Change_Tracking_Syslog" />

	        </NCMDeviceCriteria>
        </NCMProtocolCombination>


		<!-- SSH -->
	    <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:mrvlambdadriver_ssh_tftp" devicetemplateid="NCMDeviceTemplate:devicetemplateid:mrvlambadriver"
        managementprotocolid="SSH" transferprotocolid="TFTP" displayname="SSH - TFTP">
        <NCMDeviceCriteria commandmapid="SSH_TFTP_Command">

               <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="lambdadriver_running_config_backup"/>
               <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="lambdadriver_startup_config_backup"/>
               <NCMDeviceOperation operationid="UploadStartupConfig" executiongroupid="lambdadriver_startup_config_upload"/>
               <NCMDeviceOperation operationid="CopyRunningToStartup" executiongroupid="lambdadriver_running_config_sync"/>
           
           </NCMDeviceCriteria>
       </NCMProtocolCombination>

       <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:mrvlambdadriver_ssh" devicetemplateid="NCMDeviceTemplate:devicetemplateid:mrvlambadriver"
        managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
        <NCMDeviceCriteria commandmapid="SSH_Command">

            <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="lambdadriver_write_terminal" taskhandling="true" />
            <NCMReadFromResponse operationid="BackupRunningConfig" recordid="lambda_driver_write_terminal_rec"/>


             <!-- Change Tracking thru Syslog -->
             <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="Lambda_Driver_Enable_Change_Tracking_Syslog" />
             <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="Lambda_Driver_Disable_Change_Tracking_Syslog" />

	        </NCMDeviceCriteria>
        </NCMProtocolCombination>


	</NCMDeviceTemplate>

</DeviceConfiguration>

