<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<DeviceConfiguration>

    <!-- For Netscreen Firewall -->
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:netscreen_5GT" templatename="Netscreen_Firewall" displayname="Juniper Netscreen Firewall" ostype="ScreenOS" description="For all Juniper Netscreen Firewalls">
        <NCMVendorDevice vendorid="Netscreen"/>

        <NCMDevicePersonality personalityid="NetscreenFirewall"/>
        
        <NCMSupportedProtocol protocolid="TELNET">
            <NCMDeviceCredential credentialgroupid="Telnet Credentials"/>
        </NCMSupportedProtocol>
        
        <NCMSupportedProtocol protocolid="SSH">
            <NCMDeviceCredential credentialgroupid="SSH Credentials"/>
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TFTP"/>

        <NCMProtocolCombination 
            deviceprotocolid="NCMProtocolCombination:deviceprotocolid:netscreen_5GT_telnet" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:netscreen_5GT" 
            managementprotocolid="TELNET" transferprotocolid="TFTP" displayname="TELNET - TFTP">

            <NCMDeviceCriteria commandmapid="TELNET_TFTP_Command">
                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="netscreenfirewall_cli_running_config_backup" />
                <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="netscreenfirewall_cli_running_config_upload" />

                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="netscreenfirewall_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="netscreenfirewall_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

        <NCMProtocolCombination 
            deviceprotocolid="NCMProtocolCombination:deviceprotocolid:netscreen_5GT_SSH" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:netscreen_5GT" 
            managementprotocolid="SSH" transferprotocolid="TFTP" displayname="SSH - TFTP">

            <NCMDeviceCriteria commandmapid="SSH_TFTP_Command">
                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="netscreenfirewall_cli_running_config_backup" />
                <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="netscreenfirewall_cli_running_config_upload" />

                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="netscreenfirewall_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="netscreenfirewall_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>
	
	
        <NCMProtocolCombination 
            deviceprotocolid="NCMProtocolCombination:deviceprotocolid:netscreen_telnet_alone" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:netscreen_5GT" 
            managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">

            <NCMDeviceCriteria commandmapid="TELNET_Command">
		    
		<NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="netscreenfirewall_telnet_running_config_fetch" taskhandling="true"/>
		<NCMReadFromResponse operationid="BackupRunningConfig" recordid="netscreen_firewall_cli_get_config_rec"/>
		    
                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="netscreenfirewall_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="netscreenfirewall_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>
	
	
        <NCMProtocolCombination 
            deviceprotocolid="NCMProtocolCombination:deviceprotocolid:netscreen_5GT_ssh_alone" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:netscreen_5GT" 
            managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">

            <NCMDeviceCriteria commandmapid="SSH_Command">
		    
		<NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="netscreenfirewall_telnet_running_config_fetch" taskhandling="true"/>
		<NCMReadFromResponse operationid="BackupRunningConfig" recordid="netscreen_firewall_cli_get_config_rec"/>

                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="netscreenfirewall_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="netscreenfirewall_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>
    </NCMDeviceTemplate>

</DeviceConfiguration>
