<DeviceConfiguration>

    <!-- For FortiNet FortiGate Firewall Version 2.8 and less -->
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:fortigate_firewall_v2" templatename="FortiGate_Firewall_V2" displayname="FortiGate Firewall - version 2.8" ostype="FortiOS" description="For all FortiGate firewalls with os version  2.8" IS_DEPRICATED="true">
        <NCMVendorDevice vendorid="Fortinet"/>
        <NCMDevicePersonality personalityid="FortiGateFirewall"/>

        <NCMSupportedProtocol protocolid="TELNET">
            <NCMDeviceCredential credentialgroupid="Telnet Credentials"/>
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="SSH">
            <NCMDeviceCredential credentialgroupid="SSH Credentials"/>
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TFTP"/>

        <NCMProtocolCombination
            deviceprotocolid="NCMProtocolCombination:deviceprotocolid:fortigate_firewall_v2_telnet" devicetemplateid="NCMDeviceTemplate:devicetemplateid:fortigate_firewall_v2" managementprotocolid="TELNET" transferprotocolid="TFTP" displayname="TELNET - TFTP">
            <NCMDeviceCriteria commandmapid="TELNET_TFTP_Command">
                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="fortigatefirewall_cli_running_config_backup" />
                <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="fortigatefirewall_cli_running_config_upload" />

                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="fortigatefirewall_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="fortigatefirewall_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

        <NCMProtocolCombination
            deviceprotocolid="NCMProtocolCombination:deviceprotocolid:fortigate_firewall_v2_ssh"
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:fortigate_firewall_v2"
            managementprotocolid="SSH" transferprotocolid="TFTP" displayname="SSH - TFTP">
            <NCMDeviceCriteria commandmapid="SSH_TFTP_Command">
                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="fortigatefirewall_cli_running_config_backup" />
                <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="fortigatefirewall_cli_running_config_upload" />

                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="fortigatefirewall_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="fortigatefirewall_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>
    </NCMDeviceTemplate>
    
    <!-- For FortiNet FortiGate Firewall Version 3.0 and more -->
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:fortigate_firewall_v3" templatename="FortiGate_Firewall_V3" displayname="FortiGate Firewall - version 3.0" ostype="FortiOS" description="For all FortiGate firewalls and FortiMail with os version 3.0" IS_DEPRICATED="true">
	    <NCMVendorDevice vendorid="Fortinet"/>
	    <NCMDevicePersonality personalityid="FortiGateFirewall"/>
	    
	    <NCMSupportedProtocol protocolid="TELNET">
		    <NCMDeviceCredential credentialgroupid="Telnet Credentials"/>
	    </NCMSupportedProtocol>
	    
	    <NCMSupportedProtocol protocolid="SSH">
		    <NCMDeviceCredential credentialgroupid="SSH Credentials"/>
	    </NCMSupportedProtocol>
	    
	    <NCMSupportedProtocol protocolid="TFTP"/>
	    
	    <NCMProtocolCombination
				   deviceprotocolid="NCMProtocolCombination:deviceprotocolid:fortigate_firewall_v3_telnet"
				   devicetemplateid="NCMDeviceTemplate:devicetemplateid:fortigate_firewall_v3"
				   managementprotocolid="TELNET" transferprotocolid="TFTP" displayname="TELNET - TFTP">
		    
		    <NCMDeviceCriteria commandmapid="TELNET_TFTP_Command">
			    <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="fortigatefirewall_cli_running_config_backup_ver3" />
			    <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="fortigatefirewall_cli_running_config_upload_ver3" />
			    
			    <!-- Change Tracking thru Syslog -->
			    <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="fortigatefirewall_enable_syslog_change_tracking" />
			    <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="fortigatefirewall_disable_syslog_change_tracking" />
			    
		    </NCMDeviceCriteria>
	    </NCMProtocolCombination>
	    
	    <NCMProtocolCombination
				   deviceprotocolid="NCMProtocolCombination:deviceprotocolid:fortigate_firewall_v3_ssh"
				   devicetemplateid="NCMDeviceTemplate:devicetemplateid:fortigate_firewall_v3"
				   managementprotocolid="SSH" transferprotocolid="TFTP" displayname="SSH - TFTP">
		    
		    <NCMDeviceCriteria commandmapid="SSH_TFTP_Command">
			    <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="fortigatefirewall_cli_running_config_backup_ver3" />
			    <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="fortigatefirewall_cli_running_config_upload_ver3" />
			    
			    <!-- Change Tracking thru Syslog -->
			    <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="fortigatefirewall_enable_syslog_change_tracking" />
			    <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="fortigatefirewall_disable_syslog_change_tracking" />
			    
		    </NCMDeviceCriteria>
	    </NCMProtocolCombination>
		
		
        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:fortigatefirewall_telnet_alone" devicetemplateid="NCMDeviceTemplate:devicetemplateid:fortigate_firewall_v3" managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
            <NCMDeviceCriteria commandmapid="TELNET_Command">

		 <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="fortigatefirewall_ver3_show_running_config" taskhandling="true"/>
	     <NCMReadFromResponse operationid="BackupRunningConfig" recordid="fortigatefirewall_ver3_show_running_config_rec"/>
			
			<!-- Change Tracking thru Syslog -->
			<NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="fortigatefirewall_enable_syslog_change_tracking" />
			<NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="fortigatefirewall_disable_syslog_change_tracking" />
			
            </NCMDeviceCriteria>
        </NCMProtocolCombination>

               <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:fortigatefirewall_ssh_alone" devicetemplateid="NCMDeviceTemplate:devicetemplateid:fortigate_firewall_v3" managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
            <NCMDeviceCriteria commandmapid="SSH_Command">

		 <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="fortigatefirewall_ver3_show_running_config" taskhandling="true"/>
	     <NCMReadFromResponse operationid="BackupRunningConfig" recordid="fortigatefirewall_ver3_show_running_config_rec"/>
		 
			<!-- Change Tracking thru Syslog -->
			<NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="fortigatefirewall_enable_syslog_change_tracking" />
			<NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="fortigatefirewall_disable_syslog_change_tracking" />
			
          </NCMDeviceCriteria>		  
        </NCMProtocolCombination>
		
    </NCMDeviceTemplate>
    


