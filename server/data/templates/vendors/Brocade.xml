<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<DeviceConfiguration>

    <!-- For Brocade Web Server Director Pro AS -->
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:brocade_switch" templatename="Brocade_Switch" displayname="Brocade Switch" ostype="Fabric OS" description="For all Brocade switches">
        <NCMVendorDevice vendorid="Brocade"/>
        <NCMDevicePersonality personalityid="BrocadeSwitch"/>

		<NCMSupportedProtocol protocolid="SSH">
			<NCMDeviceCredential credentialgroupid="SSH Credentials" />
		</NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="SCP"/>

		<!-- SSH -->
        <NCMProtocolCombination
            deviceprotocolid="NCMProtocolCombination:deviceprotocolid:brocade_switch_ssh_scp"
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:brocade_switch"
            managementprotocolid="SSH" transferprotocolid="SCP" displayname="SSH - SCP">
            <NCMDeviceCriteria commandmapid="SSH_SCP_Command">

              <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="brocade_switch_scp_running_config_backup"/>
              <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="brocade_switch_scp_running_config_push" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

		
		<NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:brocade_switch_ssh" devicetemplateid="NCMDeviceTemplate:devicetemplateid:brocade_switch" managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
            <NCMDeviceCriteria commandmapid="SSH_Command">

		    <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="brocade_switch_ssh_running_config_fetch" taskhandling="true"/>
		    <NCMReadFromResponse operationid="BackupRunningConfig" recordid="brocade_switch_ssh_show_running_config_rec"/>
			</NCMDeviceCriteria>
        </NCMProtocolCombination>

    </NCMDeviceTemplate>
	

	
    <!-- For Brocade FCX624S & FCX648G switches -->

<NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:brocade_fastiron_switch" templatename="Brocade_FastIron_Switch" ostype="IronWare" displayname="Brocade FCX and FWS Switch" description="For all FCX624S and FCX648G Series Switches">

        <NCMVendorDevice vendorid="Brocade"/>
        <NCMDevicePersonality personalityid="BrocadeFastIronSwitch"/>
        <NCMSupportedProtocol protocolid="TELNET">
            <NCMDeviceCredential credentialgroupid="Telnet Credentials"/>
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="SSH">
            <NCMDeviceCredential credentialgroupid="SSH Credentials"/>
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TFTP"/>

        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:brocade_fastiron_switch_ssh" devicetemplateid="NCMDeviceTemplate:devicetemplateid:brocade_fastiron_switch" managementprotocolid="SSH" transferprotocolid="TFTP" displayname="SSH - TFTP">
            <NCMDeviceCriteria commandmapid="SSH_TFTP_Command">

                <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="brocade_fastiron_switch_cli_startup_config_backup" />
                <NCMDeviceOperation operationid="UploadStartupConfig" executiongroupid="brocade_fastiron_switch_cli_startup_config_upload" />
                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="brocade_fastiron_switch_cli_running_config_backup" />
                <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="brocade_fastiron_switch_cli_running_config_upload" />

                <NCMDeviceOperation operationid="CopyRunningToStartup" executiongroupid="brocade_fastiron_switch_cli_copy_running_to_startup" />

                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="brocade_fastiron_switch_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="brocade_fastiron_switch_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:brocade_fastiron_switch_telnet" devicetemplateid="NCMDeviceTemplate:devicetemplateid:brocade_fastiron_switch" managementprotocolid="TELNET" transferprotocolid="TFTP" displayname="TELNET - TFTP">
            <NCMDeviceCriteria commandmapid="TELNET_TFTP_Command">

                <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="brocade_fastiron_switch_cli_startup_config_backup" />
                <NCMDeviceOperation operationid="UploadStartupConfig" executiongroupid="brocade_fastiron_switch_cli_startup_config_upload" />
                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="brocade_fastiron_switch_cli_running_config_backup" />
                <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="brocade_fastiron_switch_cli_running_config_upload" />

                <NCMDeviceOperation operationid="CopyRunningToStartup" executiongroupid="brocade_fastiron_switch_cli_copy_running_to_startup" />

                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="brocade_fastiron_switch_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="brocade_fastiron_switch_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
    </NCMProtocolCombination>

    <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:brocade_fastiron_switch_ssh_alone" devicetemplateid="NCMDeviceTemplate:devicetemplateid:brocade_fastiron_switch" managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
	    <NCMDeviceCriteria commandmapid="SSH_Command">

	    <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="brocade_fastiron_switch_startup_config_fetch" taskhandling="true"/>
		    <NCMReadFromResponse operationid="BackupStartupConfig" recordid="brocade_fastiron_switch_show_startup_config_rec"/>

		    <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="brocade_fastiron_switch_running_config_fetch" taskhandling="true"/>
		    <NCMReadFromResponse operationid="BackupRunningConfig" recordid="brocade_fastiron_switch_show_running_config_rec"/>

                <NCMDeviceOperation operationid="CopyRunningToStartup" executiongroupid="brocade_fastiron_switch_cli_copy_running_to_startup" />	
		
			 <!-- Change Tracking thru Syslog -->
    <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="brocade_fastiron_switch_enable_syslog_change_tracking" />
    <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="brocade_fastiron_switch_disable_syslog_change_tracking" />

			
	    </NCMDeviceCriteria>
    </NCMProtocolCombination>    
	
	<NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:brocade_fastiron_switch_telnet_alone" devicetemplateid="NCMDeviceTemplate:devicetemplateid:brocade_fastiron_switch" managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
	    <NCMDeviceCriteria commandmapid="TELNET_Command">

	    <NCMDeviceOperation operationid="BackupStartupConfig" executiongroupid="brocade_fastiron_switch_startup_config_fetch" taskhandling="true"/>
		    <NCMReadFromResponse operationid="BackupStartupConfig" recordid="brocade_fastiron_switch_show_startup_config_rec"/>

		    <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="brocade_fastiron_switch_running_config_fetch" taskhandling="true"/>
		    <NCMReadFromResponse operationid="BackupRunningConfig" recordid="brocade_fastiron_switch_show_running_config_rec"/>
	

                <NCMDeviceOperation operationid="CopyRunningToStartup" executiongroupid="brocade_fastiron_switch_cli_copy_running_to_startup" />
			 <!-- Change Tracking thru Syslog -->
    <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="brocade_fastiron_switch_enable_syslog_change_tracking" />
    <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="brocade_fastiron_switch_disable_syslog_change_tracking" />
			
   </NCMDeviceCriteria>
    </NCMProtocolCombination>    
</NCMDeviceTemplate>


