<DeviceConfiguration>

    <!-- For Nortel BayStack Switches -->
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:nortel_baystack_switch_380_24T" templatename="Nortel_BayStack_Switch" displayname="Nortel BayStack Switch" description="For all Nortel BayStack Switches">
        <NCMVendorDevice vendorid="Nortel"/>
        <NCMDevicePersonality personalityid="NortelBayStackSwitch"/>

        <NCMSupportedProtocol protocolid="TELNET">
            <NCMDeviceCredential credentialgroupid="Telnet Credentials"/>
        </NCMSupportedProtocol>
	
	<NCMSupportedProtocol protocolid="SSH">
		<NCMDeviceCredential credentialgroupid="SSH Credentials" />
	</NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TFTP"/>

        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:nortel_baystack_switch_380_24T_telnet" devicetemplateid="NCMDeviceTemplate:devicetemplateid:nortel_baystack_switch_380_24T"
            managementprotocolid="TELNET" transferprotocolid="TFTP" displayname="TELNET - TFTP">
            <NCMDeviceCriteria commandmapid="TELNET_TFTP_Command">

                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="nortelbaystackswitch_cli_running_config_backup" />
                <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="nortelbaystackswitch_cli_running_config_upload" taskhandling="true"/>

                <NCMUserInputKey operationid="UploadRunningConfig" userinputkey="FileContents"/>

                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="nortelbaystackswitch_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="nortelbaystackswitch_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>
    
        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:nortel_baystack_switch_380_24T_ssh" devicetemplateid="NCMDeviceTemplate:devicetemplateid:nortel_baystack_switch_380_24T"
            managementprotocolid="SSH" transferprotocolid="TFTP" displayname="SSH - TFTP">
            <NCMDeviceCriteria commandmapid="SSH_TFTP_Command">

                <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="nortelbaystackswitch_cli_running_config_backup" />
                <NCMDeviceOperation operationid="UploadRunningConfig" executiongroupid="nortelbaystackswitch_cli_running_config_upload" taskhandling="true"/>

                <NCMUserInputKey operationid="UploadRunningConfig" userinputkey="FileContents"/>

                <!-- Change Tracking thru Syslog -->
                <NCMDeviceOperation operationid="EnableConfigChangeTrackingThruSyslog" executiongroupid="nortelbaystackswitch_enable_syslog_change_tracking" />
                <NCMDeviceOperation operationid="DisableConfigChangeTrackingThruSyslog" executiongroupid="nortelbaystackswitch_disable_syslog_change_tracking" />

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

</NCMDeviceTemplate>


