<DeviceConfiguration>

<NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:nec_ix2025" templatename="NEC_IX2025" ostype="NA" displayname="NEC IX2025" description="For all NEC IX2025Operating System Software">
   	<NCMVendorDevice vendorid="NEC" />
   	<NCMDevicePersonality personalityid="NECIX2025" />

   	<NCMSupportedProtocol protocolid="TELNET">
        <NCMDeviceCredential credentialgroupid="Telnet Credentials" />
