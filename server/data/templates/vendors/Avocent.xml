<?xml version="1.0" encoding="iso-8859-1"?>
<!-- $Id$ -->
<DeviceConfiguration>

    <!-- For Digi TransPort wireless Router -->
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:avocent_acs" templatename="Avocent_ACS" displayname="Avocent ACS" ostype="NA" description="For all Avocent ACS Advanced Console Server Models 6000">
        <NCMVendorDevice vendorid="Avocent"/>
        <NCMDevicePersonality personalityid="AvocentACS"/>

		<NCMSupportedProtocol protocolid="SSH">
			<NCMDeviceCredential credentialgroupid="SSH Credentials" />
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TELNET">
			<NCMDeviceCredential credentialgroupid="Telnet Credentials" />
        </NCMSupportedProtocol>
       

		<!-- SSH -->
        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:avocent_acs_ssh" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:avocent_acs"
            managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
            <NCMDeviceCriteria commandmapid="SSH_Command">

             <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="avocent_acs_cli_running_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupRunningConfig" recordid="avocent_acs_cli_show_running_config_rec"/>

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

	<!-- TELNET -->
         <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:avocent_acs_telnet" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:avocent_acs"
            managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
            <NCMDeviceCriteria commandmapid="TELNET_Command">

             <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="avocent_acs_cli_running_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupRunningConfig" recordid="avocent_acs_cli_show_running_config_rec"/>
			 
            </NCMDeviceCriteria>
        </NCMProtocolCombination>

    </NCMDeviceTemplate>

	
    <!-- For Avocent Terminal -->
	
    <NCMDeviceTemplate devicetemplateid="NCMDeviceTemplate:devicetemplateid:avocent_terminal" templatename="Avocent_Terminal" displayname="Avocent Terminal" ostype="NA" description="For all Avocent Terminal">
        <NCMVendorDevice vendorid="Avocent"/>
        <NCMDevicePersonality personalityid="AvocentTerminal"/>

		<NCMSupportedProtocol protocolid="SSH">
			<NCMDeviceCredential credentialgroupid="SSH Credentials" />
        </NCMSupportedProtocol>

        <NCMSupportedProtocol protocolid="TELNET">
			<NCMDeviceCredential credentialgroupid="Telnet Credentials" />
        </NCMSupportedProtocol>
       

		<!-- SSH -->
        <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:avocent_terminal_ssh" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:avocent_terminal"
            managementprotocolid="SSH" transferprotocolid="SSH" displayname="SSH">
            <NCMDeviceCriteria commandmapid="SSH_Command">

             <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="avocent_terminal_cli_running_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupRunningConfig" recordid="avocent_terminal_cli_show_running_config_rec"/>

            </NCMDeviceCriteria>
        </NCMProtocolCombination>

	<!-- TELNET -->
         <NCMProtocolCombination deviceprotocolid="NCMProtocolCombination:deviceprotocolid:avocent_terminal_telnet" 
            devicetemplateid="NCMDeviceTemplate:devicetemplateid:avocent_terminal"
            managementprotocolid="TELNET" transferprotocolid="TELNET" displayname="TELNET">
            <NCMDeviceCriteria commandmapid="TELNET_Command">

             <NCMDeviceOperation operationid="BackupRunningConfig" executiongroupid="avocent_terminal_cli_running_backup" taskhandling="true"/>
             <NCMReadFromResponse operationid="BackupRunningConfig" recordid="avocent_terminal_cli_show_running_config_rec"/>
			 
            </NCMDeviceCriteria>
        </NCMProtocolCombination>

    </NCMDeviceTemplate>
	
</DeviceConfiguration>

